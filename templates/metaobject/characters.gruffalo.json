          }
        },
        "cast_3": {
          "type": "item",
          "settings": {
            "title": "Owl",
            "description": "<p>A hunter who invites Mouse up for tea, and flies off at the mention of the Gruffalo.</p>",
            "link": "/pages/character/owl"
          }
        },
        "cast_4": {
          "type": "item",
          "settings": {
            "title": "Snake",
            "description": "<p>Patient, sly and persuasive, with a feast waiting in his log-pile house.</p>",
