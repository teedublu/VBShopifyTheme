        "item_2": {
          "type": "item",
          "settings": {
            "title": "How many animals are in The Gruffalo?",
            "content": "<p>There are five main animal or creature characters if you count Mouse, Fox, Owl, Snake and the Gruffalo. Mouse meets three animals before the Gruffalo appears: Fox, Owl and Snake.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "title": "Who is the cleverest character in The Gruffalo?",
            "content": "<p>Mouse is usually seen as the cleverest character because he survives by thinking quickly and using the other characters’ assumptions against them.</p>"
          }
        },
