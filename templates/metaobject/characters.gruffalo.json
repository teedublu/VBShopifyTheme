          "settings": {
            "title": "Mouse",
            "description": "<p>Quick-thinking and brave. Invents the Gruffalo to talk his way past three hungry animals.</p>",
            "link": "/pages/character/mouse"
          }
        },
        "cast_2": {
          "type": "item",
          "settings": {
            "title": "Fox",
            "description": "<p>Smooth-talking woodland predator, the first to invite Mouse home for lunch.</p>",
