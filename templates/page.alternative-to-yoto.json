    "faq": {
      "type": "faq",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "title": "Does Voxblock need wi-fi or an app?",
            "content": "<p>No. There is no wi-fi, no account and no downloads. Each story is stored inside its audiobook, so you put the book on the player and press play.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "title": "Can I add my own content?",
            "content": "<p>Not yet. Adding your own content launches in January 2027. Yoto already offers it.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "title": "Can my child use headphones?",
            "content": "<p>Yes, through the 3.5mm headphone jack. Yoto players also offer Bluetooth.</p>"
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "title": "How long does the battery last?",
            "content": "<p>Up to 16 hours, charged by USB-C.</p>"
          }
        },
        "item_5": {
          "type": "item",
          "settings": {
            "title": "Is Voxblock cheaper than Yoto?",
            "content": "<p>The player is £49.99 against £89.99 for the Yoto Mini and £119.99 for the Yoto Player. Extra stories cost £9.99 each, against £7.99 for a Yoto card.</p>"
          }
        }
      },
