    "media_with_text_cTgCfe": {
      "type": "media-with-text",
      "blocks": {
        "image_3KLyVP": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/press-pack-voxblock-founders-photo.jpg",
            "media_width": 50,
            "media_position": "end",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "Meet the people behind Voxblock",
            "title": "Tom and Rebecca",
            "content": "<p>We started Voxblock to create a simple, stripped back player that was completely screen and wifi free inspired by our daughters love of our old cassette tapes.</p><p>Read more about Tom and Rebecca’s story here:</p>",
            "link_text": "Our purpose",
            "link_url": "shopify://pages/our-purpose-why-support-voxblock",
