            "text_position": "place-self-center-start text-start",
            "icon": "none",
            "icon_width": 48,
            "subheading": "Screen-free audiobook player for kids",
            "title": "Stories they can play themselves",
            "content": "<p>Voxblock is a simple audiobook player for children. Each story is a small physical book that slots into the player. No screen, no downloads, no streaming, no subscription. Just press play.</p><p><em>“Best kids’ audio player for ease of use” – The Independent</em></p>",
            "link_text": "Start with a Starter Pack",
            "link_url": "/collections/voxblock-starter-pack-collection",
            "background": "#fff7f0",
            "background_gradient": "",
            "text_color": "#565656",
            "heading_text_color": "#197177",
            "text_gradient": "",
            "button_background": "#ff9e57",
            "button_text_color": "#ffffff"
          }
        }
      },
      "block_order": [
        "hero_image"
      ],
      "settings": {
        "full_width": true,
        "spacing": "small"
      }
    },
    "how_it_works": {
      "type": "multi-column",
      "blocks": {
        "step_1": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/how-it-works-image-a-v1.26.png",
            "column_size": "3",
            "title": "1. Pick a book from the shelf",
            "heading_tag": "h4",
            "content": "<p>Every audiobook is a small, sturdy book. Children choose by cover, just like a real bookcase.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "step_2": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/how-it-works-image-b-v1.26.png",
            "column_size": "3",
            "title": "2. Slot it into the player",
            "heading_tag": "h4",
            "content": "<p>The story is ready as soon as the book is in. Nothing to pair, download or set up.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "step_3": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/how-it-works-image-c-v1.26.png",
            "column_size": "3",
            "title": "3. Press play",
            "heading_tag": "h4",
            "content": "<p>Five big buttons: play, skip and volume. Nothing else to learn.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3"
