    "benefits": {
      "type": "benefit-cards",
      "blocks": {
        "card_setup": {
          "type": "card",
          "settings": {
            "icon": "no-wifi",
            "title": "Nothing to set up",
            "content": "<p>No wifi, no accounts, no app to download. Charge it, slot a book in, press play. It works in the car, on the plane, and at Grandma's.</p>"
          }
        },
        "card_books": {
          "type": "card",
          "settings": {
            "icon": "book",
            "title": "Stories you can hold",
            "content": "<p>Each audiobook is a small physical book that slots into the player. Children choose from the shelf, just like a real bookcase. 350+ titles and growing.</p>"
          }
        },
        "card_screen": {
          "type": "card",
          "settings": {
            "icon": "no-screen",
            "title": "Truly screen-free",
            "content": "<p>No display, no menus, no ads, no autoplay. Five big buttons and nothing else. Inspired by the cassette players we grew up with.</p>"
          }
        }
      },
