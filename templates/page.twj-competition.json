    "rich_text_GQVPxC": {
      "type": "rich-text",
      "blocks": {
        "heading_xeHTjG": {
          "type": "heading",
          "settings": {
            "text": "Our 2026 Winners",
            "heading_tag": "h1",
            "heading_tag_html": "p",
            "text_color": "",
            "gradient": ""
          }
        },
        "richtext_MGpGFL": {
          "type": "richtext",
          "settings": {
            "content": "<p>We had over 240 nominations and a shortlist of 31. Our judges had a very difficult decision, there was so many schools that provided brilliant examples of how Voxblock would benefit their school. While they also a lot of familiar issues currently facing schools. Five schools were chosen to win a mini school pack.</p>"
          }
        },
        "richtext_zcHxNX": {
          "type": "richtext",
          "settings": {
            "content": "<p>Congratulations to the following schools:</p><ul><li>Quarry Bank Primary School (Midlands)</li><li>Royal School of the Blind (North England)</li><li>Sanday (Scotland)</li><li>Spa Primary (Northern Ireland)</li><li>Stockbridge Primary School (Scotland)</li></ul>"
          }
        },
        "richtext_XQYefQ": {
          "type": "richtext",
          "settings": {
            "content": "<p>Thank you to everyone that nominated a school. </p>"
          }
        }
      },
      "block_order": [
