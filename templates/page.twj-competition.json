    "media_with_text_H6XCn6": {
      "type": "media-with-text",
      "blocks": {
        "image_3LYV4A": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/placing-the-wild-robot-on-audiobook-player.jpg",
            "media_width": 50,
            "stacked_media_max_width": 0,
            "media_position": "start",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "",
            "title": "What's the prize?",
            "content": "<p><strong>One lucky winner will receive:</strong></p><ul><li>A Voxblock player with a protective bumper</li><li>A charging cable</li><li>The Wild Robot audiobook by Peter Brown, the story of Roz, a robot who wakes up alone on a remote island</li><li>No apps, no screen and no setup. Ready to play straight out of the box</li></ul><p><strong>Plus 10 more winners</strong></p><ul><li>10 other randomly chosen winners will each receive a small surprise gift from us</li></ul><p>Good Luck!</p>",
            "link_text": "",
            "link_url": "",
            "title_tag": "p",
            "link2_text": "",
