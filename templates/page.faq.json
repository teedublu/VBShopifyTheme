      "blocks": {
        "item_01": {
          "type": "item",
          "settings": {
            "title": "Why is the play button pink?",
            "content": "<p>Pink means travel mode, which locks the buttons for packing. It glows pink for a few seconds and then looks switched off. Hold − and + together for a second until the light turns blue. <a href=\"/pages/quick-fixes#light-pink\">Travel mode</a></p>"
          }
        },
        "item_02": {
          "type": "item",
          "settings": {
            "title": "Why is the play button orange?",
            "content": "<p>Orange means bedtime mode: the story stops after 20 minutes. Press both arrow buttons together until you hear a tone and the light turns blue. <a href=\"/pages/quick-fixes#light-orange\">Bedtime mode</a></p>"
          }
        },
        "item_03": {
          "type": "item",
          "settings": {
            "title": "Nothing happens when I press the buttons",
            "content": "<p>If the play button glows pink for a few seconds, it’s travel mode: hold − and + together. Otherwise charge it overnight from a wall plug. <a href=\"/pages/quick-fixes\">More quick fixes</a></p>"
          }
        },
        "item_04": {
          "type": "item",
          "settings": {
            "title": "How do I switch the player off?",
            "content": "<p>Hold the play button for about 3 seconds. It also switches itself off a few minutes after a story stops.</p>"
          }
        }
      },
      "block_order": [
        "item_01",
