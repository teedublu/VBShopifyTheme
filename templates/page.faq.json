      "blocks": {
        "item_01": {
          "type": "item",
          "settings": {
            "title": "What stories are available?",
            "content": "<p>Stories for children aged 3 to teens, from picture books to novels. We have more than 350 titles and add new ones every month. <a href=\"/collections/all\">See them all</a></p>"
          }
        },
        "item_02": {
          "type": "item",
          "settings": {
            "title": "How do the audiobooks work?",
            "content": "<p>Each audiobook is a book-shaped block with the whole story stored on it. Place it on the player and press play. There’s nothing to download or stream, and no wifi or subscription.</p>"
          }
        },
        "item_03": {
          "type": "item",
          "settings": {
            "title": "Will I lose my place in the story if I remove a block?",
            "content": "<p>No. The player returns to the same point next time you listen to that story.</p>"
          }
        },
        "item_04": {
          "type": "item",
          "settings": {
            "title": "What are the blocks made of?",
            "content": "<p>Our audiobook blocks are made of recycled card.</p>"
          }
        }
      },
