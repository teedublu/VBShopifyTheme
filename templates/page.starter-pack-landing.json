          "settings": {
            "title": "Does it need wifi or a subscription?",
            "content": "<p>No. Each story is stored on its own audiobook block, so there is nothing to download, stream or set up, and no subscription. Slot in a book and press play.</p>"
          }
        },
        "item_whats_in": {
          "type": "item",
          "settings": {
            "title": "What's in a starter pack?",
            "content": "<p>The Voxblock player, a protective bumper in the colour you choose, a USB-C charging cable and audiobooks picked for one age group, for less than buying them separately.</p>"
          }
        },
        "item_which": {
          "type": "item",
          "settings": {
            "title": "Which pack should I choose?",
            "content": "<p>Start with your child's age. Every pack uses the same player, so you can add more audiobooks any time from our library of 350+.</p>"
          }
        },
        "item_returns": {
          "type": "item",
          "settings": {
