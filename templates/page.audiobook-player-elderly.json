    "faq": {
      "type": "faq",
      "blocks": {
        "faq_adult_titles": {
          "type": "item",
          "settings": {
            "title": "Are there audiobooks for adults?",
            "content": "<p>Yes. There is a separate collection of classics for adult listeners - Austen, Dickens, Tolstoy, Dostoevsky and others. It is a small collection and we are still adding to it.</p>"
          }
        },
        "faq_blocks": {
          "type": "item",
          "settings": {
            "title": "What are the audiobooks made of?",
            "content": "<p>Recycled card. Each story is a small, sturdy block that slots into the player.</p>"
          }
        },
        "faq_wifi": {
          "type": "item",
          "settings": {
            "title": "Does it need wifi or downloads?",
            "content": "<p>No. There is nothing to connect, download or log into. The audio is stored on each block, so the player works the moment it comes out of the box.</p>"
          }
        },
        "faq_headphones": {
          "type": "item",
          "settings": {
            "title": "Can they listen with headphones?",
            "content": "<p>Yes. The player has a built-in speaker and a headphone jack.</p>"
          }
        },
        "faq_battery": {
          "type": "item",
          "settings": {
            "title": "How long does the battery last?",
            "content": "<p>About 14 hours of playing time, and up to 25 days on standby. It charges over USB-C with the cable in the box.</p>"
          }
        },
        "faq_charging": {
          "type": "item",
          "settings": {
            "title": "How do I charge the player?",
            "content": "<p>Use the USB-C cable provided with a USB adapter in a wall socket, and let it charge fully. Avoid laptop chargers, car chargers and multi-USB ports - they do not charge it properly.</p>"
          }
        },
        "faq_repair": {
          "type": "item",
          "settings": {
            "title": "What if it breaks?",
            "content": "<p>Send it back and we will repair it free of charge, including return postage. Within two years of purchase we will repair or replace it.</p>"
          }
        },
        "faq_guarantee": {
          "type": "item",
          "settings": {
            "title": "What if it isn't right?",
            "content": "<p>You have 100 days to try it. If it is not right, get in touch and we will send a pre-paid shipping label and refund you in full, no questions asked. The 100-day guarantee is not available in Australia.</p>"
          }
        },
        "faq_shipping": {
          "type": "item",
          "settings": {
            "title": "Where do you deliver?",
            "content": "<p>The UK and Australia. For Ireland and Europe, email hello@voxblock.co.uk.</p>"
          }
        }
