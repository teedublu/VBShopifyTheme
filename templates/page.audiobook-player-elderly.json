        "item_2": {
          "type": "item",
          "settings": {
            "title": "Is there a device that just plays audiobooks?",
            "content": "<p>Yes. The Voxblock player only plays audiobooks. There are no notifications, adverts or menus to get in the way.</p>",
            "teaser_only": false
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "title": "Does it need wi-fi or a smartphone?",
            "content": "<p>No. The stories are on the blocks, so there's nothing to download or stream and no phone to pair.</p>",
            "teaser_only": false
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "title": "Is it suitable for someone with poor eyesight?",
