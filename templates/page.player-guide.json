    "charging": {
      "type": "help-topic",
      "settings": {
        "anchor": "charging",
        "heading": "Charging",
        "image": "shopify://shop_images/charging_graphic-do-n-dont-01.png",
        "tinted": true,
        "content": "<p>A full charge gives up to 16 hours of listening.</p>",
        "steps_heading": "How to charge",
        "steps": "Plug the USB-C cable that came with your player into the socket on the player.\nPlug the other end into a USB wall plug, like a phone charger.\nThe battery light flashes green while it charges and stays green when it’s full. Leave it to charge fully, for example overnight.",
        "note": "<p><strong>Avoid laptop USB ports, car chargers and USB hubs.</strong> They often don’t give enough power to charge the player properly.</p>",
        "link_text": "It still won’t charge",
        "link_url": "/pages/quick-fixes#light-charging"
      }
    },
    "care": {
      "type": "help-topic",
      "settings": {
        "anchor": "care",
        "heading": "Looking after your player and books",
        "content": "<ul><li>If a book won’t play, wipe the connector on the book and the player with a dry cloth.</li><li>Keep the player and books dry. The books are made of card.</li><li>Switch the player off when you’re not using it, or let it switch itself off.</li></ul><p>Something broken? Your player has a 2-year guarantee, and we repair players for life after that.</p>",
        "link_text": "Guarantee and repairs",
        "link_url": "/pages/delivery-and-returns#repairs"
      }
    },
