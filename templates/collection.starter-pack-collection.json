    "faq_t9iAtE": {
      "type": "faq",
      "blocks": {
        "item_whats_in": {
          "type": "item",
          "settings": {
            "title": "What's in a starter pack?",
            "content": "<p>The Voxblock player, a protective bumper in the colour you choose, a USB-C charging cable and three audiobooks picked for one age group, for less than buying them separately. Intro packs are the player plus one audiobook.</p>"
          }
        },
        "item_which": {
          "type": "item",
          "settings": {
            "title": "Which pack should I choose?",
            "content": "<p>Start with your child's age: use the age buttons above the packs. Every pack uses the same player, so you can add more audiobooks any time from our library of 350+.</p>"
          }
        },
        "item_wifi": {
          "type": "item",
          "settings": {
            "title": "Does it need wifi or a subscription?",
            "content": "<p>No. Each story is stored on its own audiobook block, so there is nothing to download, stream or set up, and no subscription. Slot in a book and press play.</p>"
          }
        },
        "item_age": {
          "type": "item",
          "settings": {
            "title": "What age is Voxblock for?",
            "content": "<p>Toddlers to teens. The player is made for children aged 3 and over, and most 3-year-olds can choose and play a story on their own.</p>"
          }
        },
        "item_battery": {
          "type": "item",
          "settings": {
            "title": "How long does the battery last?",
            "content": "<p>Up to 16 hours of listening on a full charge. It charges with the USB-C cable in the box.</p>"
          }
        },
        "item_returns": {
          "type": "item",
          "settings": {
            "title": "What if it isn't right for us?",
            "content": "<p>Every player comes with a 100-day money-back guarantee, and UK delivery is free on orders over £25.</p>"
          }
        }
      },
