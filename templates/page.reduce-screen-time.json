      "blocks": {
        "way_1": {
          "type": "card",
          "settings": {
            "icon": "moon",
            "title": "Make bedtime screen-free",
            "content": "<p>Keep screens out of the hour before bed. A bedtime story, read aloud or on an audiobook, gives the same wind-down without the glow.</p>"
          }
        },
        "way_2": {
          "type": "card",
          "settings": {
            "icon": "no-screen",
            "title": "Keep screens out of bedrooms",
            "content": "<p>Charge phones and tablets downstairs overnight, so the bedroom stays for sleep and stories.</p>"
          }
        },
        "way_3": {
          "type": "card",
          "settings": {
            "icon": "hands",
            "title": "Make mealtimes device-free",
            "content": "<p>A chat or a simple game at the table, instead of a tablet propped against the fruit bowl.</p>"
          }
        },
        "way_4": {
          "type": "card",
          "settings": {
            "icon": "battery",
            "title": "Plan the car journey",
            "content": "<p>Long drives are where screens take over. Pack an audiobook player and headphones, and let them choose the stories before you set off.</p>"
          }
        },
        "way_5": {
          "type": "card",
          "settings": {
            "icon": "play",
            "title": "Give them something they control",
            "content": "<p>Children reach for screens because they can work them alone. Offer things they can start themselves: books, building toys, an audiobook player.</p>"
          }
        },
        "way_6": {
          "type": "card",
          "settings": {
            "icon": "check",
            "title": "Agree a few clear rules",
            "content": "<p>Decide when screens are allowed, not only for how long. A few simple rules, made together, mean fewer arguments.</p>"
          }
        },
        "way_7": {
          "type": "card",
          "settings": {
            "icon": "ear",
            "title": "Put your own phone away too",
            "content": "<p>Children copy what they see. Screen-free time works best when it is family time.</p>"
          }
        }
      },
