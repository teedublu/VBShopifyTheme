    "guarantee": {
      "type": "help-topic",
      "settings": {
        "anchor": "happiness-guarantee",
        "heading": "100-day Happiness Guarantee",
        "tinted": true,
        "content": "<p>Buy a Voxblock player or starter pack from our website and you have 100 days to listen, play and explore. If it’s not for you, for any reason, send it back in its original packaging and we’ll give you a full refund. Get in touch and we’ll email you a prepaid label.</p>",
        "note": "<p>The Happiness Guarantee is for UK orders from our website. Bought somewhere else? See <a href=\"#register\">players bought elsewhere</a>.</p>"
      }
    },
    "repairs": {
      "type": "help-topic",
      "settings": {
        "anchor": "repairs",
        "heading": "Repairs: 2-year guarantee and repairs for life",
        "content": "<p><strong>In the first 2 years:</strong> if your player stops working, we repair or replace it, and we pay the postage both ways.</p><p><strong>After 2 years, or after an accident:</strong> post it to us, and we repair it and post it back free.</p><p>Before you send it, try the <a href=\"/pages/quick-fixes\">quick fixes</a>: most problems are a button press, like travel mode.</p>"
      }
    },
    "reuse": {
      "type": "help-topic",
      "settings": {
        "anchor": "reuse",
        "heading": "Finished with your player?",
        "tinted": true,
        "content": "<p>Please don’t throw it away. Send it back to us free: we check it, repair it if it needs it, and pass it on to another child. Parts we can’t reuse are recycled properly. We take players back from the UK and Australia.</p>"
      }
    },
    "send_back": {
      "type": "help-topic",
      "settings": {
        "anchor": "send-back",
        "heading": "How to send a player back",
        "steps": "Tell us what’s happening, with your order number or the email you ordered with.\nIf we’re paying the postage, we email you a prepaid label to print and stick on.\nPack the player in a padded envelope or small box. A4, C5, 180 × 265 mm and 160 × 230 mm envelopes all fit.\nDrop it at a Post Office or Royal Mail drop-off point.",
        "note": "<p>We pay the postage for returns within 100 days, repairs within 2 years and players sent back for reuse. For repairs after 2 years, you post it to us and we post it back free.</p>",
        "link_text": "Start a return or repair",
        "link_url": "/pages/contact-us"
      }
    },
