    {%- comment -%} <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>{%- endcomment -%}

    {%- comment -%} DONT THINK WE NEED THIS <link rel="dns-prefetch" href="https://productreviews.shopifycdn.com">{%- endcomment -%}

    {%- unless settings.heading_font.system? -%}
      <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- unless settings.text_font.system? -%}
      <link rel="preload" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}
    
    {%- render 'social-meta-tags', resolved_page_title: resolved_page_title, resolved_page_description: resolved_page_description, resolved_canonical_url: resolved_canonical_url -%}
    {%- render 'microdata-schema' -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>
    <script type="module" src="{{ 'sections.js' | asset_url }}"></script>
    <script type="module" src="{{ 'voxblock.js' | asset_url }}"></script>
    {%- render 'saved-books-head' -%}
    {%- render 'first-touch' -%}
    {%- render 'klaviyo-popup-guard' -%}

