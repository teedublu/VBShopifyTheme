        posthog.init('phc_qdTMDgYcwGoMMmehmBZ2eQVqUYPl2ZGJSJSuAAtKHJf', {
            api_host: 'https://eu.i.posthog.com',
            person_profiles: 'always',
            custom_campaign_params: ['gad_campaignid', 'gbraid', 'wbraid','utm_id'],
            session_idle_timeout_seconds: 5400, // 90 min: keep "left the tab, came back" as one session
            loaded: function (ph) {
              window.Zigpoll = window.Zigpoll || {};
              window.Zigpoll.metadata = Object.assign({}, window.Zigpoll.metadata, {
                posthog_distinct_id: ph.get_distinct_id(),
                posthog_session_id: ph.get_session_id(),
              });
              window.Zigpoll.user = Object.assign({}, window.Zigpoll.user, { id: ph.get_distinct_id() });
            },
        })
        const p = new URLSearchParams(location.search);
        if (p.get('utm_medium') === 'email' && p.get('utm_id')) {
          posthog.setPersonProperties({ klaviyo_profile_id: p.get('utm_id') });
        }

        // Klaviyo sign-ups only reach Klaviyo, so identify the visitor here by the email they entered; otherwise
        // this session can't be joined to a later purchase from the welcome email in another browser.
        // Multi-step forms send the email with 'stepSubmit' (and on every later step), so act once per form.
        const klaviyoFormsIdentified = new Set();
        window.addEventListener('klaviyoForms', (event) => {
          const { type, formId, metaData } = event.detail || {};
          const email = metaData?.$email?.trim().toLowerCase();
          if ((type !== 'submit' && type !== 'stepSubmit') || !email || klaviyoFormsIdentified.has(formId)) return;
          klaviyoFormsIdentified.add(formId);

          // Where this browser first/last came from (snippets/first-touch.liquid). Only tagged landings are
          // stored, so a plain sign-up sends no source properties and can't blank values already on the profile.
          const touch = (window.vbTouch && window.vbTouch.props()) || {};

          posthog.capture('klaviyo_form_submitted', { form_id: formId, step: type, ...touch });
          // Already identified (e.g. a signed-in customer): don't switch this browser to someone else's person
          if (posthog.get_property('$user_state') !== 'identified') posthog.identify(email, { email });

          // Put the source on the Klaviyo profile too (HANDOFF 13a), so a welcome-email buyer shows which ad brought them
          if (Object.keys(touch).length) {
            const profile = { ...touch, signup_form_id: formId };
            if (window.klaviyo && typeof window.klaviyo.identify === 'function') {
              window.klaviyo.identify({ email, ...profile });
            } else {
              (window._learnq = window._learnq || []).push(['identify', { $email: email, ...profile }]);
            }
          }
        });
