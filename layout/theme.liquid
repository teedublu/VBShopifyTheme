<!doctype html>

<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
	<script src="{{ 'pandectes-rules.js' | file_url }}"></script>
	
	

  	

    {%- liquid
      assign resolved_page_title = page_title
      assign resolved_page_description = page_description
      assign resolved_canonical_url = canonical_url

      if request.page_type == 'metaobject' and metaobject != blank
        capture audiogramme_route_mode
          render 'audiogramme-route-mode', metaobject: metaobject
        endcapture

        assign source_metaobject = metaobject
        if metaobject.system.type == 'read_along' and metaobject.audiogramme != blank and metaobject.audiogramme.value != blank
          assign source_metaobject = metaobject.audiogramme.value
        endif

        if metaobject.system.type == 'audiogramme' or metaobject.system.type == 'read_along'
          assign handle = source_metaobject.system.handle | default: metaobject.system.handle
          assign audiobook = shop.metaobjects.audiobook[handle]
          assign product = blank

          if source_metaobject.product != blank and source_metaobject.product.value != blank
            assign product = source_metaobject.product.value
          endif

          if product == blank and audiobook != blank and audiobook.product != blank and audiobook.product.value != blank
            assign product = audiobook.product.value
          endif

          if product == blank
            assign product = all_products[handle]
          endif

          assign book_title = audiobook.title.value | default: product.title | default: source_metaobject.name | default: metaobject.name
          assign author = product.metafields.book.authors.value | first
          assign narrator = product.metafields.book.narrators.value | first
          assign author_name = author.name
          assign narrator_name = narrator.name

          if audiogramme_route_mode == 'read_along'
            assign resolved_page_title = book_title | append: ' Read-Along Transcript | Voxblock'
            assign resolved_page_description = 'Listen to an excerpt from ' | append: book_title | append: ' and follow along with the read-along transcript. A screen-free audiobook sample from Voxblock.'
            capture resolved_canonical_url
              echo shop.url
              render 'audiogramme-url', handle: handle, kind: 'read_along'
            endcapture
            assign resolved_canonical_url = resolved_canonical_url | strip
          else
            assign resolved_page_title = book_title | append: ' Audiobook Sample | Voxblock'
            assign resolved_page_description = 'Listen to a sample of ' | append: book_title
            if author_name != blank
              assign resolved_page_description = resolved_page_description | append: ' by ' | append: author_name
            endif
            if narrator_name != blank
              assign resolved_page_description = resolved_page_description | append: ', read by ' | append: narrator_name
            endif
            assign resolved_page_description = resolved_page_description | append: '. Discover the screen-free audiobook block for children from Voxblock.'
            capture resolved_canonical_url
              echo shop.url
              render 'audiogramme-url', handle: handle, kind: 'sample'
            endcapture
            assign resolved_canonical_url = resolved_canonical_url | strip
          endif
        elsif metaobject.system.type == 'overview' and metaobject.system.handle == 'the-gruffalo'
          assign resolved_page_title = 'The Gruffalo Summary: Plot, Characters & Age Guide | Voxblock'
          assign resolved_page_description = 'A parent-friendly guide to The Gruffalo: what the book is about, main characters, message, age range, how many animals are in the story and where to listen.'
        elsif metaobject.system.type == 'characters' and metaobject.system.handle == 'the-gruffalo'
          assign resolved_page_title = 'The Gruffalo Characters: Full Cast Guide | Voxblock'
          assign resolved_page_description = 'Meet the main characters in The Gruffalo, including Mouse, Fox, Owl, Snake and the Gruffalo, with a simple guide to how each character fits into the story.'
        elsif metaobject.system.type == 'character' and template contains 'gruffalo'
          assign character_name = metaobject.name.value | default: metaobject.name
          if metaobject.system.handle == 'the-gruffalo'
            assign resolved_page_title = 'What Is a Gruffalo? Character Description & Meaning | Voxblock'
            assign resolved_page_description = 'A clear guide to the Gruffalo character: what he looks like, what the name means in the story, and the role he plays in Julia Donaldson and Axel Scheffler’s book.'
          else
            assign resolved_page_title = character_name | append: ' in The Gruffalo: Character Guide | Voxblock'
            assign resolved_page_description = 'Learn about ' | append: character_name | append: ' in The Gruffalo, including the character’s role in the story and how children can listen to the audiobook on Voxblock.'
          endif
        elsif metaobject.system.type == 'audiobook' and metaobject.system.handle == 'the-gruffalo'
          assign resolved_page_title = 'The Gruffalo Audiobook: Voxblock Listening Guide | Voxblock'
          assign resolved_page_description = 'Listening details for The Gruffalo audiobook on Voxblock, including how it works, who it suits, screen-free listening benefits, and where to buy the physical audiobook block.'
        endif
      elsif request.page_type == 'product' and product.handle == 'the-gruffalo'
        assign resolved_page_title = 'The Gruffalo Voxblock Audiobook | Buy Screen-Free Story'
        assign resolved_page_description = 'Buy The Gruffalo as a physical Voxblock audiobook block for screen-free listening. Check compatibility, setup, age suitability and practical purchase details.'
      elsif request.page_type == 'index'
        # Homepage targets the "kids audiobook player" search group (see briefs/homepage-kids-player.md)
        assign resolved_page_title = 'Kids Audiobook Player | Screen-Free Audio Player | Voxblock'
        assign resolved_page_description = 'The screen-free audiobook player for kids, toddlers to teens. No wifi, downloads or subscriptions: pop in a story, press play. Free UK delivery over £25.'
      elsif request.page_type == 'page' and page.handle == 'kids-audiobook-player-starter-pack'
        # Google Ads landing page: targets starter-pack searches so it doesn't compete with the homepage for "kids audiobook player"
        assign resolved_page_title = 'Audiobook Starter Packs: Player + First Stories | Voxblock'
        assign resolved_page_description = 'Start with a Voxblock starter pack: the screen-free audiobook player plus your first audiobooks, for toddlers to teens. Free UK delivery over £25.'
      elsif request.page_type == 'page' and page.handle == 'reasons-to-buy-voxblock'
        # Brand reviews / consideration page: targets "voxblock reviews" so it supports the homepage rather than competing for player searches
        assign resolved_page_title = 'Voxblock Reviews: Why Parents Choose Voxblock'
        assign resolved_page_description = 'Read Voxblock reviews from UK parents and the seven reasons families choose our screen-free audiobook player, for toddlers to teens. 100-day guarantee.'
      elsif request.page_type == 'page' and page.handle == 'childrens-cd-player-alternative'
        # Children's CD player alternative page (briefs/childrens-cd-player-page.md): "kids" allowed in the meta description only
        assign resolved_page_title = "Children's CD Player Alternative: Audiobooks | Voxblock"
        assign resolved_page_description = 'Looking for a kids CD player? Voxblock is the screen-free audiobook player children work themselves. No discs to scratch, no wifi, 16-hour battery.'
      elsif request.page_type == 'page' and template.suffix == 'childrens-cassette-player-alternative'
        # Children's cassette player alternative (briefs/childrens-cassette-player-page.md). Keyed on the template, not the
        # handle, so the existing /pages/modern-cassette-player keeps its title until its template is switched in admin.
        assign resolved_page_title = "Children's Cassette Player Alternative | Voxblock"
        assign resolved_page_description = 'Looking for a kids cassette player? Voxblock is the screen-free audiobook player children work themselves. No tapes to tangle, no wifi, 16-hour battery.'
      elsif request.page_type == 'page' and template.suffix == 'reduce-screen-time'
        # Parent's guide: targets "how to reduce screen time (for kids)"; "how much screen time" stays with the blog post.
        # Keyed on the template, not the handle, so the live /pages/reduce-screen-time keeps its title and meta until its
        # template is switched in admin (it is on landing-page-problem today).
        assign resolved_page_title = 'How to Reduce Screen Time for Kids: 7 Ways | Voxblock'
        assign resolved_page_description = "Seven practical ways to reduce your child's screen time, based on UK guidance, with screen-free swaps for bedtime, car journeys and quiet time."
      elsif request.page_type == 'page' and template.suffix == 'help'
        # Help pages (briefs/help-pages.md): brand searchers see these titles, so they lead with the task or the good
        # news, never the failure ("not working", "returns"). Keyed on the template so admin titles can't drift.
        assign resolved_page_title = 'Voxblock Help Centre: Guides, Delivery and Contact'
        assign resolved_page_description = 'Setting up, using and charging your Voxblock, delivery, our 100-day guarantee, and how to reach us. Most answers take under a minute.'
      elsif request.page_type == 'page' and template.suffix == 'player-guide'
        assign resolved_page_title = 'Voxblock Player Guide: Buttons, Lights and Charging'
        assign resolved_page_description = 'Everything the buttons and lights do, bedtime and travel mode, headphones and charging, with the printable quick start guide.'
      elsif request.page_type == 'page' and template.suffix == 'quick-fixes'
        assign resolved_page_title = 'Voxblock Quick Fixes: Lights, Charging and Sound'
        assign resolved_page_description = "Light stuck on a colour, not charging or a book that won't play? Most things are fixed in a minute. Here's how, step by step."
      elsif request.page_type == 'page' and template.suffix == 'delivery-and-returns'
        assign resolved_page_title = 'Delivery, 100-Day Guarantee and Free Repairs | Voxblock'
        assign resolved_page_description = 'Free UK delivery over £25. Try a player or starter pack for 100 days, with a 2-year guarantee and repairs for life after that.'
      elsif request.page_type == 'page' and template.suffix == 'faq'
        assign resolved_page_title = 'Voxblock FAQs: Ages, Audiobooks, Delivery and More'
        assign resolved_page_description = 'Common questions about Voxblock: ages, how the audiobook blocks work, no wifi or downloads, the lights, safety and delivery.'
      elsif request.page_type == 'page' and template.suffix == 'contact'
        assign resolved_page_title = 'Contact Voxblock: Email and Help Form'
        assign resolved_page_description = 'Get in touch with the Voxblock team. Monday to Friday, 9am to 5pm, we usually reply within the hour. Many answers are in our help centre.'
      endif

      # Collections: use the admin SEO title explicitly. On 15 Oct the dinosaurs collection kept rendering its plain title
      # through page_title although its SEO title was set (mystery, set the same way, worked).
      if request.page_type == 'collection' and collection.metafields.global.title_tag != blank
        assign resolved_page_title = collection.metafields.global.title_tag
      endif

      # Series pages: "<Series> Audiobooks in Order | Voxblock" when the series has a reading order, else "for Kids"
      if request.page_type == 'metaobject' and metaobject.system.type == 'series'
        assign series_title_suffix = ' Audiobooks for Kids | Voxblock'
        if metaobject.reading_order.value == true and metaobject.books.value != blank
          assign series_title_suffix = ' Audiobooks in Order | Voxblock'
        endif
        assign resolved_page_title = metaobject.name.value | append: series_title_suffix
      endif
    -%}

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=5.0">
    <meta name="theme-color" content="{{ settings.header_background }}">

    <title>{% if resolved_page_title == blank %}{{ shop.name }}{% else %}{{ resolved_page_title }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% endif %}</title>

    {%- if resolved_page_description -%}
      <meta name="description" content="{{ resolved_page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ resolved_canonical_url }}">

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
    {{- 'voxblock.css' | asset_url | stylesheet_tag: preload: true -}}

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}Few prefetch to increase performance on commonly used third-parties{%- endcomment -%}

    {%- comment -%}Removing these below as using webfonts{%- endcomment -%}
