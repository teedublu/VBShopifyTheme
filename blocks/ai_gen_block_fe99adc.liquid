{% doc %}
  @prompt
    Need an image block with clicable link
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-linked-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
  }

  .ai-linked-image-{{ ai_gen_id }}__link {
    display: block;
    width: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: {{ block.settings.corner_radius }}px;
    overflow: hidden;
  }

  .ai-linked-image-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid #197177;
    outline-offset: 4px;
  }

  .ai-linked-image-{{ ai_gen_id }}__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #F2F7F7;
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-linked-image-{{ ai_gen_id }}__media img,
  .ai-linked-image-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-linked-image-{{ ai_gen_id }}__media img {
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-linked-image-{{ ai_gen_id }}__placeholder {
    position: relative;
    background: #F2F7F7;
  }

  .ai-linked-image-{{ ai_gen_id }}__placeholder svg {
    min-height: 180px;
    color: #197177;
  }

  .ai-linked-image-{{ ai_gen_id }}__empty-state {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    margin: 0;
    padding: 8px 12px;
    border-radius: 8px;
    background: #ffffff;
    color: #2a555a;
    font-size: 14px;
    text-align: center;
  }
{% endstyle %}

<div class="ai-linked-image-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% if block.settings.link_url != blank %}
    <a class="ai-linked-image-{{ ai_gen_id }}__link" href="{{ block.settings.link_url }}" {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %} aria-label="{{ block.settings.accessible_label | default: 'Open linked content' | escape }}">
  {% else %}
    <div class="ai-linked-image-{{ ai_gen_id }}__link">
  {% endif %}
      <div class="ai-linked-image-{{ ai_gen_id }}__media">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 2400 }}" alt="{{ block.settings.image.alt | default: block.settings.accessible_label | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
        {% else %}
          <div class="ai-linked-image-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <p class="ai-linked-image-{{ ai_gen_id }}__empty-state">Add an image to show here</p>
          </div>
        {% endif %}
      </div>
  {% if block.settings.link_url != blank %}
    </a>
  {% else %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Clickable image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "accessible_label",
      "label": "Link description",
      "default": "View more"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open link in a new tab",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fitting",
      "options": [
        { "value": "cover", "label": "Fill" },
        { "value": "contain", "label": "Fit" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Clickable image"
    }
  ],
  "tag": null,
  "class": "clickable-image-block"
}
{% endschema %}