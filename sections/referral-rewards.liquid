{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
REFERRAL REWARDS (templates/page.refer-a-friend.json)
----------------------------------------------------------------------------------------------------------------------
The rewards a customer can choose after 3 Golden Tokens. Block "product": a product picker (image, title and price
read live, so nothing is hard-coded) plus a short note. Block "card": a value tile for rewards that aren't a product
page (the £30 e-gift card). Rows on phones, three columns from 750px.
{%- endcomment -%}

<section class="referral-rewards" {{ section.shopify_attributes }}>
  <div class="container referral-rewards__inner">
    <div class="referral-rewards__head">
      <h2 class="series-heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<p class="referral-rewards__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </div>
    <ul class="referral-rewards__list" role="list">
      {%- for block in section.blocks -%}
        <li class="referral-rewards__item" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'product' -%}
              {%- assign reward = block.settings.product -%}
              <div class="referral-rewards__media">
                {%- if reward.featured_image != blank -%}
                  {{- reward.featured_image | image_url: width: 480 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 30vw, 96px', widths: '160,240,480', alt: reward.title -}}
                {%- endif -%}
              </div>
              <div class="referral-rewards__body">
                <span class="referral-rewards__title">{{ reward.title | default: block.settings.title | escape }}</span>
                <span class="referral-rewards__text">
                  {{- block.settings.note | escape -}}
                  {%- if reward.price %} Worth {{ reward.price | money }}.{%- endif -%}
                </span>
              </div>
            {%- when 'card' -%}
              <div class="referral-rewards__media referral-rewards__media--value"><span>{{ block.settings.value | escape }}</span></div>
              <div class="referral-rewards__body">
                <span class="referral-rewards__title">{{ block.settings.title | escape }}</span>
                {%- if block.settings.note != blank -%}<span class="referral-rewards__text">{{ block.settings.note | escape }}</span>{%- endif -%}
              </div>
          {%- endcase -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Referral rewards",
  "tag": "div",
  "class": "shopify-section--referral-rewards",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (H2)", "default": "Choose your reward" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Collect 3 Golden Tokens to receive your reward. Choose from:" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product reward",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title if no product" },
        { "type": "text", "id": "note", "label": "Note" }
      ]
    },
    {
      "type": "card",
      "name": "Value reward",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "£30" },
        { "type": "text", "id": "title", "label": "Title", "default": "£30 e-gift card" },
        { "type": "text", "id": "note", "label": "Note" }
      ]
    }
  ],
  "presets": [{ "name": "Referral rewards" }]
}
{% endschema %}
