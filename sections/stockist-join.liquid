{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
STOCKIST JOIN (templates/page.stockists.json, /pages/find-a-bookshop)
----------------------------------------------------------------------------------------------------------------------
"Stock Voxblock in your bookshop": dark band with benefit cards (blocks), shopfront photos (blocks), how joining works
(step blocks) and a stockist enquiry form. The form is a Shopify contact form, so enquiries arrive at the store's
contact email with the hidden field "Form: Stockist enquiry" and every field labelled.
Thank-you handling as in stockist-suggest (snippet stockist-form-thanks-script).
Clicks send vs_yoto_click { target }: fab_enquiry_submit, fab_enquiry_email.
{%- endcomment -%}

{%- liquid
  capture form_id
    echo 'stockist-enquiry-' | append: section.id
  endcapture
  assign benefits = section.blocks | where: 'type', 'benefit'
  assign photos = section.blocks | where: 'type', 'photo'
  assign steps = section.blocks | where: 'type', 'step'
  assign shop_types = section.settings.shop_types | split: ','
-%}

<section id="{{ section.settings.anchor | default: 'join' | escape }}" class="stockist-join" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="stockist-join__head">
      {%- if section.settings.eyebrow != blank -%}<p class="subheading">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<p class="stockist-join__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </div>

    {%- if benefits.size > 0 -%}
      <ul class="stockist-join__benefits" role="list">
        {%- for block in benefits -%}
          <li class="stockist-join__benefit" {{ block.shopify_attributes }}>
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'pin' -%}<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
                {%- when 'books' -%}<rect x="4" y="4" width="7" height="16" rx="1.5"/><rect x="13" y="4" width="7" height="16" rx="1.5"/>
                {%- when 'display' -%}<rect x="3" y="8" width="18" height="12" rx="2"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/>
                {%- else -%}<path d="M4 7h16M4 12h10M4 17h7"/>
              {%- endcase -%}
            </svg>
            <h3 class="stockist-join__benefit-title">{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if photos.size > 0 -%}
      <ul class="stockist-join__photos" role="list">
        {%- for block in photos -%}
          <li class="stockist-join__photo" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{- block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 1000px) 25vw, 50vw', alt: block.settings.caption -}}
            {%- endif -%}
            {%- if block.settings.caption != blank -%}<span class="stockist-join__caption">{{ block.settings.caption | escape }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="stockist-join__bottom">
      <div class="stockist-join__steps">
        {%- if section.settings.steps_heading != blank -%}<h3 class="h4">{{ section.settings.steps_heading | escape }}</h3>{%- endif -%}
        <ol class="stockist-join__step-list">
          {%- for block in steps -%}
            <li {{ block.shopify_attributes }}>
              <span class="stockist-join__step-num" aria-hidden="true">{{ forloop.index }}</span>
              <span><strong>{{ block.settings.title | escape }}</strong>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ol>
        {%- if section.settings.email != blank -%}
          <p class="stockist-join__email">{{ section.settings.email_text | escape }} <a href="mailto:{{ section.settings.email | escape }}" data-vs-track="fab_enquiry_email">{{ section.settings.email | escape }}</a></p>
        {%- endif -%}
      </div>

      <div class="stockist-join__form-card">
        {%- form 'contact', id: form_id, class: 'stockist-join__form' -%}
          <input type="hidden" name="contact[Form]" value="Stockist enquiry">
          {%- if form.posted_successfully? -%}
            <div class="stockist-form-thanks stockist-form-thanks--large" data-form-thanks="{{ form_id }}" hidden>
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              <p class="h5">{{ section.settings.thanks_title | escape }}</p>
              <p>{{ section.settings.thanks_text | escape }}</p>
            </div>
          {%- endif -%}
          <div class="stockist-join__form-fields">
            <h3 class="h5">{{ section.settings.form_heading | escape }}</h3>
            <p class="stockist-join__required">{{ section.settings.required_note | escape }}</p>
            {%- if form.errors -%}
              <p class="stockist-form-error" role="alert">{{ form.errors.translated_fields[form.errors.first] | capitalize }} {{ form.errors.messages[form.errors.first] }}</p>
            {%- endif -%}
            <div class="stockist-join__grid">
              {%- render 'input', type: 'text', name: 'contact[Bookshop name]', label: section.settings.label_shop, required: true, autocomplete: 'organization' -%}
              {%- render 'input', type: 'text', name: 'contact[Town and postcode]', label: section.settings.label_town, required: true -%}
              {%- render 'input', type: 'text', name: 'contact[name]', label: section.settings.label_name, value: customer.name, required: true, autocomplete: 'name' -%}
              {%- render 'input', type: 'email', name: 'contact[email]', label: section.settings.label_email, value: customer.email, required: true, autocomplete: 'email' -%}
              {%- render 'input', type: 'text', name: 'contact[Website or Instagram]', label: section.settings.label_web, autocomplete: 'url' -%}
              {%- capture options -%}
                {%- for t in shop_types -%}<option value="{{ t | strip | escape }}"{% if forloop.first %} selected{% endif %}>{{ t | strip | escape }}</option>{%- endfor -%}
              {%- endcapture -%}
              {%- render 'select', name: 'contact[Kind of shop]', label: section.settings.label_type, options: options -%}
            </div>
            {%- render 'input', name: 'contact[body]', label: section.settings.label_message, multiline: 3 -%}
            <div class="stockist-join__submit">
              <button type="submit" class="button button--lg" data-vs-track="fab_enquiry_submit">{{ section.settings.submit_text | escape }}</button>
              {%- if section.settings.privacy_note != blank -%}<span>{{ section.settings.privacy_note | escape }}</span>{%- endif -%}
            </div>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{%- render 'stockist-form-thanks-script' -%}

{% schema %}
{
  "name": "Stockist join",
  "tag": "div",
  "class": "shopify-section--stockist-join",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor (no #)", "default": "join" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For bookshops" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stock Voxblock in your bookshop" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Audiobooks children can hold, choose and play by themselves. We work with independent bookshops that love children's books as much as we do, and we send families your way." },
    { "type": "text", "id": "steps_heading", "label": "Steps heading", "default": "How joining works" },
    { "type": "text", "id": "email_text", "label": "Email line", "default": "Prefer email?" },
    { "type": "text", "id": "email", "label": "Email address", "default": "retail@voxblock.co.uk" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Heading", "default": "Stockist enquiry" },
    { "type": "text", "id": "required_note", "label": "Required note", "default": "Fields marked * are required." },
    { "type": "text", "id": "label_shop", "label": "Bookshop name", "default": "Bookshop name *" },
    { "type": "text", "id": "label_town", "label": "Town", "default": "Town and postcode *" },
    { "type": "text", "id": "label_name", "label": "Name", "default": "Your name *" },
    { "type": "text", "id": "label_email", "label": "Email", "default": "Email *" },
    { "type": "text", "id": "label_web", "label": "Website", "default": "Website or Instagram" },
    { "type": "text", "id": "label_type", "label": "Kind of shop", "default": "What kind of shop?" },
    { "type": "text", "id": "shop_types", "label": "Kinds of shop", "info": "Comma separated", "default": "Independent bookshop, Children's bookshop, Toy or gift shop, Library or museum shop, Other" },
    { "type": "text", "id": "label_message", "label": "Message", "default": "Anything else? (optional)" },
    { "type": "text", "id": "submit_text", "label": "Submit button", "default": "Send enquiry" },
    { "type": "text", "id": "privacy_note", "label": "Note by button", "default": "We use your details only to reply about stocking Voxblock." },
    { "type": "text", "id": "thanks_title", "label": "Thank-you heading", "default": "Thank you, we have your details" },
    { "type": "text", "id": "thanks_text", "label": "Thank-you text", "default": "We'll reply with trade prices and samples." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "pin", "options": [
          { "value": "pin", "label": "Map pin" },
          { "value": "books", "label": "Books" },
          { "value": "display", "label": "Display" },
          { "value": "terms", "label": "List" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Families find you here" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "photo",
      "name": "Shopfront photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    },
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Tell us about your shop" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Stockist join" }]
}
{% endschema %}
