{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
PACK CONTENTS ("What's in the box", starter-pack bundle pages)
----------------------------------------------------------------------------------------------------------------------
A full-width band below the main product area: the player kit as pictures, then each book in the pack with cover,
narrator, length and a sample button. Kept out of the buy column on purpose so it adds content without pushing
Add to basket down. Markup: snippets/pack-contents.liquid. Styles: assets/voxblock.css.liquid (PACK CONTENTS).
Shows nothing on a product without a `bundles.products` list.
{%- endcomment -%}

{%- if product != blank and product.metafields.bundles.products.value.size > 0 -%}
  <section class="pack-contents-band" {{ section.shopify_attributes }}>
    <div class="container">
      {%- render 'pack-contents', product: product, opts: section.settings -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Pack contents",
  "class": "shopify-section--pack-contents",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Starter packs: player kit as picture tiles, then each book in the bundles.products metafield with cover, narrator, length and a sample button." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's in the box" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything to start listening, the day it arrives" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "No downloads, no wi-fi, no app. Charge it, slot in a book and press play." },
    { "type": "header", "content": "Player kit" },
    { "type": "text", "id": "kit_heading", "label": "Kit heading", "default": "The player kit" },
    { "type": "product", "id": "item_1", "label": "Item 1", "info": "Picture follows the colour picked, when this product has a variant of that colour" },
    { "type": "text", "id": "item_1_label", "label": "Item 1 name", "default": "Voxblock player" },
    { "type": "text", "id": "item_1_caption", "label": "Item 1 caption", "default": "Up to 16 hours per charge" },
    { "type": "product", "id": "item_2", "label": "Item 2" },
    { "type": "text", "id": "item_2_label", "label": "Item 2 name", "default": "Protective bumper" },
    { "type": "text", "id": "item_2_caption", "label": "Item 2 caption", "default": "Takes the knocks from little hands" },
    { "type": "product", "id": "item_3", "label": "Item 3" },
    { "type": "text", "id": "item_3_label", "label": "Item 3 name", "default": "USB charging cable" },
    { "type": "text", "id": "item_3_caption", "label": "Item 3 caption", "default": "Charges from any USB plug" },
    { "type": "header", "content": "Audiobooks" },
    { "type": "text", "id": "books_heading", "label": "Books heading", "info": "[count] = number of books", "default": "[count] audiobooks" },
    { "type": "header", "content": "Value line" },
    { "type": "checkbox", "id": "show_value", "label": "Show price against bought separately", "info": "Only when the variant has a compare-at price", "default": true },
    { "type": "text", "id": "value_note", "label": "Value note", "default": "Add more audiobooks any time from 350+." }
  ],
  "presets": [{ "name": "Pack contents" }]
}
{% endschema %}
