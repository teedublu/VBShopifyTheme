{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
AGE PICKS
----------------------------------------------------------------------------------------------------------------------
Age-led block for the visitor profile (assets/vb-profile.js):
  - player prospect: starter packs for their child's age band, with tabs for the other bands
  - player owner: top-selling books for that band
  - unknown: the age tabs and a "Have a Voxblock player yet? Yes / Not yet" row

Every panel is rendered here; the script after the section shows the right one before the page paints, using the
profile the <head> script read (window.vbBoot), and follows later changes through the "vb:profile" event.

Products come from the collection set for each band. Without one, products are taken from the "all" collection and
matched on the book.age_groups metafield (for packs without it, every book in the pack must be in the band). In each
row, products whose oldest age is that band come first, so neighbouring ages don't show the same packs.
{%- endcomment -%}

{%- render 'section-spacing-collapsing' -%}

{%- liquid
  assign vb_bands = 'u5,5-8,8-10,10+' | split: ','
  assign vb_keys = 'u5,58,810,10' | split: ','
  assign vb_codes = '35,58,810,12' | split: ','
  assign vb_filters = "Under 5's|5 to 8 years|8 to 10 years|10 to teens" | split: '|'
  assign vb_kinds = 'packs,books' | split: ','
  assign vb_books_link = section.settings.books_link | default: '/collections/audiobooks'

  assign vb_default_band = section.settings.default_band
  assign vb_default_kind = section.settings.unknown_content
  assign vb_default_index = 1
  for vb_band in vb_bands
    if vb_band == vb_default_band
      assign vb_default_index = forloop.index0
    endif
  endfor
  assign vb_default_name_id = 'band_' | append: vb_keys[vb_default_index] | append: '_name'
  assign vb_default_name = section.settings[vb_default_name_id]
-%}

<vb-age-picks
  id="vb-age-{{ section.id }}"
  class="vb-age"
  data-default-band="{{ vb_default_band }}"
  data-unknown="{{ vb_default_kind }}"
  data-kind="{{ vb_default_kind }}"
  data-band="{{ vb_default_band }}"
  {% if section.settings.experiment_only %}data-vb-experiment{% endif %}
>
  <div {% render 'section-properties' %}>
    <div class="vb-age__inner">
      <div class="vb-age__header">
        <h2
          class="h2 vb-age__heading"
          data-heading-packs="{{ section.settings.heading_packs | escape }}"
          data-heading-books="{{ section.settings.heading_books | escape }}"
          data-heading-unknown="{{ section.settings.heading_unknown | escape }}"
          {% if section.settings.heading_color != blank and section.settings.heading_color != 'rgba(0,0,0,0)' %}style="color: {{ section.settings.heading_color }}"{% endif %}
        >
          {{- section.settings.heading_unknown | replace: '[band]', vb_default_name -}}
        </h2>

        <div class="vb-age__tabs" role="tablist" aria-label="{{ section.settings.tabs_label | escape }}">
          {%- for vb_band in vb_bands -%}
            {%- assign vb_key = vb_keys[forloop.index0] -%}
            {%- capture vb_tab_id -%}band_{{ vb_key }}_tab{%- endcapture -%}
            {%- capture vb_name_id -%}band_{{ vb_key }}_name{%- endcapture -%}
            <button
              type="button"
              class="vb-age__tab"
              role="tab"
              id="vb-age-tab-{{ section.id }}-{{ vb_key }}"
              aria-controls="vb-age-{{ section.id }}-{{ vb_default_kind }}-{{ vb_key }}"
              aria-selected="{% if vb_band == vb_default_band %}true{% else %}false{% endif %}"
              tabindex="{% if vb_band == vb_default_band %}0{% else %}-1{% endif %}"
              data-band="{{ vb_band }}"
              data-key="{{ vb_key }}"
              data-name="{{ section.settings[vb_name_id] | escape }}"
            >
              {{- section.settings[vb_tab_id] -}}
            </button>
          {%- endfor -%}
        </div>

        {%- if section.settings.question != blank -%}
          <div class="vb-age__question" data-age-question>
            <p>{{ section.settings.question }}</p>
            <button type="button" class="vb-pill vb-pill--outline" data-answer="yes">{{ section.settings.answer_yes }}</button>
            <button type="button" class="vb-pill" data-answer="no">{{ section.settings.answer_no }}</button>
          </div>
        {%- endif -%}
      </div>

      {%- for vb_kind in vb_kinds -%}
        {%- capture vb_all_id -%}{{ vb_kind }}_all{%- endcapture -%}
        {%- assign vb_all = section.settings[vb_all_id] -%}

        {%- for vb_band in vb_bands -%}
          {%- liquid
            assign vb_index = forloop.index0
            assign vb_key = vb_keys[vb_index]
            assign vb_code = vb_codes[vb_index]
            assign vb_setting = vb_kind | append: '_' | append: vb_key
            assign vb_collection = section.settings[vb_setting]
            assign vb_name_id = 'band_' | append: vb_key | append: '_name'
            assign vb_name = section.settings[vb_name_id]
            assign vb_count = 0

            if vb_kind == 'packs'
              assign vb_track = 'age_picks_pack'
              assign vb_link = vb_collection.url | default: vb_all.url
              assign vb_link_text = section.settings.packs_link_text
            else
              assign vb_track = 'age_picks_book'
              assign vb_filter = vb_filters[vb_index] | url_encode
              assign vb_link = vb_collection.url | default: vb_books_link
              if vb_collection == blank
                assign vb_link = vb_link | append: '?filter.p.m.book.age_groups=' | append: vb_filter
              endif
              assign vb_link_text = section.settings.books_link_text
            endif
          -%}

          {%- comment -%}
            Products that fit this age, in two passes: first those whose oldest age is this one, then the rest.
            Packs made for 5 to 8 lead the 5 to 8 row, and packs that also suit 8 to 10 lead that row instead.
            A collection chosen for the age decides which products fit; otherwise the "all" collection is filtered.
          {%- endcomment -%}
          {%- capture vb_items -%}
            {%- assign vb_source = vb_collection | default: vb_all -%}

            {%- if vb_source != blank -%}
              {%- for vb_pass in (1..2) -%}
                {%- for vb_product in vb_source.products -%}
                  {%- if vb_count >= section.settings.products_count -%}{%- break -%}{%- endif -%}
                  {%- unless vb_product.available -%}{%- continue -%}{%- endunless -%}

                  {%- liquid
                    capture vb_product_codes
                      render 'vb-age-codes', product: vb_product
                    endcapture
                    assign vb_product_codes = vb_product_codes | strip | split: ','

                    if vb_collection == blank
                      unless vb_product_codes contains vb_code
                        continue
                      endunless
                    endif

                    assign vb_oldest = -1
                    for vb_product_code in vb_product_codes
                      for vb_known_code in vb_codes
                        if vb_known_code == vb_product_code and forloop.index0 > vb_oldest
                          assign vb_oldest = forloop.index0
                        endif
                      endfor
                    endfor

                    assign vb_leads = false
                    if vb_oldest == vb_index or vb_product_codes.size == 0
                      assign vb_leads = true
                    endif

                    if vb_pass == 1 and vb_leads == false
                      continue
                    endif
                    if vb_pass == 2 and vb_leads
                      continue
                    endif
                  -%}

                  {%- render 'vb-mini-card', product: vb_product, track: vb_track -%}
                  {%- assign vb_count = vb_count | plus: 1 -%}
                {%- endfor -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endcapture -%}

          <div
            class="vb-age__panel"
            id="vb-age-{{ section.id }}-{{ vb_kind }}-{{ vb_key }}"
            role="tabpanel"
            aria-labelledby="vb-age-tab-{{ section.id }}-{{ vb_key }}"
            data-panel="{{ vb_kind }}:{{ vb_band }}"
            {% unless vb_kind == vb_default_kind and vb_band == vb_default_band %}hidden{% endunless %}
          >
            {%- if vb_count > 0 -%}
              <div class="vb-age__products">{{ vb_items }}</div>
            {%- endif -%}

            {%- if vb_link != blank and vb_link_text != blank -%}
              <p class="vb-age__footer">
                <a class="vb-link" href="{{ vb_link }}" data-vb-track="age_picks_view_all" data-vb-track-label="{{ vb_kind }}:{{ vb_band }}">
                  {{- vb_link_text | replace: '[band]', vb_name -}}
                </a>
              </p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</vb-age-picks>

<script>
  (function () {
    if (window.customElements.get('vb-age-picks')) return;

    class AgePicks extends HTMLElement {
      connectedCallback() {
        if (this._ready) return;
        this._ready = true;
        this.chosenBand = null;

        this.render(window.vbBoot || {});
        document.addEventListener('vb:profile', (event) => this.render(event.detail));
        this.addEventListener('click', (event) => this.onClick(event));
        this.addEventListener('keydown', (event) => this.onKeydown(event));
      }

      get tabs() {
        return Array.from(this.querySelectorAll('[role="tab"]'));
      }

      render(state) {
        this.state = state || {};

        var mode = this.state.mode || 'unknown';
        var kind = mode === 'owner' ? 'books' : (mode === 'prospect' ? 'packs' : (this.dataset.unknown || 'packs'));
        var band = this.chosenBand || (this.state.bands || [])[0] || this.dataset.defaultBand;
        var tab = this.tabs.filter(function (item) { return item.dataset.band === band; })[0] || this.tabs[0];
        if (!tab) return;
        band = tab.dataset.band;

        this.dataset.kind = kind;
        this.dataset.band = band;

        this.querySelectorAll('[data-panel]').forEach(function (panel) {
          panel.hidden = panel.getAttribute('data-panel') !== kind + ':' + band;
        });

        var id = this.id;
        this.tabs.forEach(function (item) {
          var selected = item === tab;
          item.setAttribute('aria-selected', selected ? 'true' : 'false');
          item.setAttribute('tabindex', selected ? '0' : '-1');
          item.setAttribute('aria-controls', id + '-' + kind + '-' + item.dataset.key);
        });

        var heading = this.querySelector('.vb-age__heading');
        var template = heading.getAttribute('data-heading-' + (mode === 'unknown' ? 'unknown' : kind)) || '';
        heading.textContent = template.replace('[band]', tab.dataset.name);

        var question = this.querySelector('[data-age-question]');
        if (question) question.hidden = mode !== 'unknown';
      }

      select(tab, focus) {
        this.chosenBand = tab.dataset.band;
        this.render(this.state);
        if (focus) tab.focus();

        if (window.VBProfile) {
          window.VBProfile.ageInterest(this.chosenBand, 3, 'age_tab');
          window.VBProfile.capture('age_picks_tab', { band: this.chosenBand, content: this.dataset.kind });
        }
      }

      onClick(event) {
        var tab = event.target.closest('[role="tab"]');
        if (tab) {
          this.select(tab, false);
          return;
        }

        var answer = event.target.closest('[data-answer]');
        if (!answer) return;

        if (window.VBProfile) {
          window.VBProfile.declarePlayer(answer.dataset.answer, 'age_picks');
        } else {
          this.render(Object.assign({}, this.state, { mode: answer.dataset.answer === 'yes' ? 'owner' : 'prospect' }));
        }
      }

      onKeydown(event) {
        var tab = event.target.closest('[role="tab"]');
        if (!tab || ['ArrowLeft', 'ArrowRight', 'Home', 'End'].indexOf(event.key) === -1) return;

        var tabs = this.tabs;
        var index = tabs.indexOf(tab);
        if (event.key === 'ArrowLeft') index = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'ArrowRight') index = (index + 1) % tabs.length;
        if (event.key === 'Home') index = 0;
        if (event.key === 'End') index = tabs.length - 1;

        event.preventDefault();
        this.select(tabs[index], true);
      }
    }

    window.customElements.define('vb-age-picks', AgePicks);
  })();
</script>

{% schema %}
{
  "name": "Age picks",
  "class": "shopify-section--vb-age-picks",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Starter packs for player prospects, top-selling books for owners, and an age picker with \"Have a Voxblock player yet?\" for everyone else. Uses Theme settings > Visitor targeting."
    },
    {
      "type": "checkbox",
      "id": "experiment_only",
      "label": "Hide for the experiment control group",
      "default": true
    },
    {
      "type": "select",
      "id": "unknown_content",
      "label": "Show unknown visitors",
      "options": [
        { "value": "packs", "label": "Starter packs" },
        { "value": "books", "label": "Books" }
      ],
      "default": "packs"
    },
    {
      "type": "select",
      "id": "default_band",
      "label": "Age shown until we know",
      "options": [
        { "value": "u5", "label": "Under 5" },
        { "value": "5-8", "label": "5 to 8" },
        { "value": "8-10", "label": "8 to 10" },
        { "value": "10+", "label": "10 and over" }
      ],
      "default": "5-8"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products per age",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading_packs",
      "label": "Heading for prospects",
      "info": "[band] is replaced by the age band's name.",
      "default": "Starter packs for [band]"
    },
    {
      "type": "text",
      "id": "heading_books",
      "label": "Heading for owners",
      "default": "Top-selling books for [band]"
    },
    {
      "type": "text",
      "id": "heading_unknown",
      "label": "Heading for everyone else",
      "default": "Find the right stories for their age"
    },
    {
      "type": "text",
      "id": "tabs_label",
      "label": "Tabs label (screen readers)",
      "default": "Child's age"
    },
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "info": "Only shown while we don't know if they own a player.",
      "default": "Have a Voxblock player yet?"
    },
    {
      "type": "text",
      "id": "answer_yes",
      "label": "Yes answer",
      "default": "Yes"
    },
    {
