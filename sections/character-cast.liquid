{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
CHARACTER CAST ("Meet the others", templates/metaobject/character.json, audiobook.json)
----------------------------------------------------------------------------------------------------------------------

The other characters from this character's main book (character field `main_book`, an audiobook entry), as the same
cards the series page uses (snippets/character-card.liquid). The character whose page this is is left out. Hidden
when the character has no main book or the book has no other characters. On an audiobook page
(templates/metaobject/audiobook.json) it lists that book's characters instead.
{%- endcomment -%}

{%- liquid
  assign current_handle = metaobject.system.handle
  # On a character page: the main book's cast, without this character. On an audiobook page: the book's own cast.
  assign main_book = blank
  capture work_handle
    render 'story-work-handle', entry: metaobject
  endcapture
  assign work_handle = work_handle | strip
  if work_handle != blank
    assign main_book = shop.metaobjects.audiobook[work_handle]
  endif
  assign cast = main_book.characters.value
  assign others = 0
  for character in cast
    if character.system.handle != current_handle
      assign others = others | plus: 1
    endif
  endfor
  assign book_title = main_book.title.value | default: main_book.product.value.title
  assign book_short = book_title | split: ':' | first | strip
  assign intro = section.settings.intro | replace: '[book_short]', book_short | replace: '[book]', book_title | replace: '[name]', metaobject.name.value
-%}

{%- if others > 0 -%}
  <section class="character-cast" {{ section.shopify_attributes }}>
    <div class="container">
      <h2 class="series-heading">{{ section.settings.heading | escape }}</h2>
      {%- if intro != blank -%}<p class="character-cast__intro">{{ intro | escape }}</p>{%- endif -%}
      {%- if section.settings.link_url != blank and section.settings.link_label != blank -%}
        <p class="character-cast__link"><a href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a></p>
      {%- endif -%}
      <ul class="character-cards" role="list">
        {%- assign shown = 0 -%}
        {%- for character in cast -%}
          {%- if character.system.handle == current_handle -%}{%- continue -%}{%- endif -%}
          {%- render 'character-card', character: character -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Character cast",
  "tag": "div",
  "class": "shopify-section--character-cast",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the others" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "The other characters in [book].", "info": "[book] is the character's main book (or this audiobook), [name] the character." },
    { "type": "text", "id": "link_label", "label": "Link text", "info": "Optional, e.g. a link to the full cast page." },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "range", "id": "limit", "label": "Most characters to show", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Character cast" }]
}
{% endschema %}
