<div class="not-found">
  <div class="prose text-center">
    <h2 class="h4">{{ '404.general.title' | t }}</h2>
    {%- capture button_content -%}{{ '404.general.continue_shopping' | t }}{%- endcapture -%}
    {%- render 'button', content: button_content, href: routes.all_products_collection_url, size: 'xl' -%}
  </div>
</div>

<script>
  (function () {
    if (!window.posthog || typeof window.posthog.capture !== 'function') return;
    window.posthog.capture('page_not_found', {
      path: location.pathname,
      full_url: location.href,
      referrer: document.referrer,
      referrer_internal: document.referrer.indexOf(location.hostname) > -1
    });
  })();
</script>

{% schema %}
{
  "name": "404",
  "class": "shopify-section--404",
  "tag": "section"
}
{% endschema %}