{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
CLASSROOM BAND ("Audiobooks work in the classroom", Gruffalo character + cast pages)
----------------------------------------------------------------------------------------------------------------------
Gruffalo pages get far more weekday-daytime and desktop visits than the rest of the site (teachers), so they get a
band that sells the idea of audiobooks in class: short intro, points (block "point"), an email sign-up for classroom
ideas (snippets/school-signup.liquid, Klaviyo list), the school packages button and a teaching resources link.
Tracking: PostHog `story_hero_click` { target: schools | resources } and `school_signup` { form: band }.
{%- endcomment -%}

<section class="classroom-band" data-story-page="{{ request.path | escape }}" {{ section.shopify_attributes }}>
  <div class="container classroom-band__inner">
    {%- if section.settings.image != blank -%}
      <div class="classroom-band__media">
        {{- section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(max-width: 999px) 92vw, 440px', widths: '400,600,900', alt: section.settings.image.alt -}}
      </div>
    {%- endif -%}

    <div class="classroom-band__text">
      {%- if section.settings.eyebrow != blank -%}<p class="classroom-band__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="classroom-band__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<div class="classroom-band__intro">{{ section.settings.intro }}</div>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="classroom-band__points" role="list">
          {%- for block in section.blocks -%}
            <li class="classroom-band__point" {{ block.shopify_attributes }}>
              <svg class="classroom-band__tick" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12l5 5 9-10"/></svg>
              <div class="classroom-band__point-text">{{ block.settings.text }}</div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_signup -%}
        <div class="classroom-band__signup">
          <p class="classroom-band__signup-title">{{ section.settings.signup_title | escape }}</p>
          {%- render 'school-signup', form_id: 'band', list_id: section.settings.signup_list_id, source: section.settings.signup_source -%}
          {%- if section.settings.signup_note != blank -%}<p class="classroom-band__signup-note">{{ section.settings.signup_note | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="classroom-band__actions">
        {%- if section.settings.button_url != blank -%}
          <a href="{{ section.settings.button_url }}" class="series-button series-button--secondary" data-story-track="schools">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.link_url != blank -%}
          <a href="{{ section.settings.link_url }}" class="classroom-band__link" data-story-track="resources">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Classroom band",
  "tag": "div",
  "class": "shopify-section--classroom-band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For teachers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Audiobooks work in the classroom" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "See school packages" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Free teaching resources for our audiobooks" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Email sign-up" },
    { "type": "checkbox", "id": "show_signup", "label": "Show the sign-up", "default": true },
    { "type": "text", "id": "signup_title", "label": "Sign-up heading", "default": "Ideas for using audiobooks in class" },
    { "type": "text", "id": "signup_note", "label": "Line under the sign-up", "default": "Classroom ideas and occasional school offers. Unsubscribe any time." },
    { "type": "text", "id": "signup_list_id", "label": "Klaviyo list ID", "default": "XRcgpd", "info": "Schools Monthly Email Newsletter." },
    { "type": "text", "id": "signup_source", "label": "Sign-up source (shown in Klaviyo)", "default": "Story page: classroom band" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Classroom band" }]
}
{% endschema %}
