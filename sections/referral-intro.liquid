{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
REFERRAL INTRO (templates/page.refer-a-friend.json)
----------------------------------------------------------------------------------------------------------------------
Top of the refer a friend page. Uses the shared .age-intro band styles.
- Signed out: offer, the 3 Golden Tokens line and one button to the account (codes live in the account, Extras).
- Signed in with a code (customer metafield referrals.code): the code with Copy, a share link that applies the
  code (/discount/<code>) and WhatsApp / email links.
- Signed in without a usable code (blank or "#N/A", seen on old imported customers): a line pointing to contact us.
- Token count: off by default. referrals.hasreferred (list of friends' emails) is not kept up to date yet; turn
  "Show token count" on once it is.
Clicks send vs_yoto_click { target } through data-vs-track (voxblock.js): raf_account, raf_copy_code, raf_copy_link,
raf_whatsapp, raf_email, raf_contact.
{%- endcomment -%}

{%- liquid
  assign code = ''
  if customer
    assign code = customer.metafields.referrals.code.value | default: customer.metafields.referrals.code | strip
    if code contains 'N/A'
      assign code = ''
    endif
  endif

  if code != blank
    assign redirect_path = section.settings.share_redirect | default: '/collections/voxblock-starter-pack-collection'
    assign share_url = shop.url | append: '/discount/' | append: code | append: '?redirect=' | append: redirect_path
    assign share_message = section.settings.share_message | replace: '[code]', code | append: ' ' | append: share_url
    assign email_subject = section.settings.email_subject
  endif

  assign token_count = 0
  if customer and section.settings.show_token_count
    assign referred = customer.metafields.referrals.hasreferred.value
    if referred != blank
      assign token_count = referred.size | modulo: 3
    endif
  endif
-%}

<section class="age-intro referral-intro" style="--age-intro-bg: {{ section.settings.background }};" {{ section.shopify_attributes }}>
  <div class="age-intro__band">
    <div class="container age-intro__band-inner">
      <div class="age-intro__text">
        {%- if section.settings.eyebrow != blank -%}<p class="age-intro__eyebrow subheading">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="age-intro__title">{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.lede != blank -%}<p class="age-intro__lede">{{ section.settings.lede | escape }}</p>{%- endif -%}

        {%- if code != blank -%}
          <div class="referral-intro__card">
            <p class="referral-intro__label">{{ section.settings.code_label | escape }}</p>
            <div class="referral-intro__code-row">
              <span class="referral-intro__code">{{ code | escape }}</span>
              <button type="button" class="series-button" data-referral-copy="{{ code | escape }}" data-copied="{{ section.settings.copied_text | escape }}" data-vs-track="raf_copy_code">{{ section.settings.copy_text | escape }}</button>
            </div>
            <div class="referral-intro__share">
              <button type="button" class="series-button series-button--secondary" data-referral-copy="{{ share_url | escape }}" data-copied="{{ section.settings.copied_text | escape }}" data-vs-track="raf_copy_link">{{ section.settings.copy_link_text | escape }}</button>
              <a class="series-button series-button--secondary" href="https://wa.me/?text={{ share_message | url_encode }}" target="_blank" rel="noopener" data-vs-track="raf_whatsapp">WhatsApp</a>
              <a class="series-button series-button--secondary" href="mailto:?subject={{ email_subject | url_encode }}&amp;body={{ share_message | url_encode }}" data-vs-track="raf_email">{{ section.settings.email_text | escape }}</a>
            </div>
            {%- if section.settings.show_token_count -%}
              <div class="referral-intro__progress">
                <span class="referral-intro__tokens" aria-hidden="true">
                  {%- for i in (1..3) -%}{%- if i <= token_count -%}{%- render 'referral-token' -%}{%- else -%}{%- render 'referral-token', empty: true -%}{%- endif -%}{%- endfor -%}
                </span>
                <span>{{ section.settings.progress_text | replace: '[count]', token_count | escape }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="referral-intro__offer">
            <span class="referral-intro__tokens" aria-hidden="true">{%- render 'referral-token' -%}{%- render 'referral-token' -%}{%- render 'referral-token' -%}</span>
            <span>{{ section.settings.token_line | escape }}</span>
          </div>
          {%- if customer -%}
            <p class="referral-intro__note">{{ section.settings.no_code_text | escape }} <a href="{{ section.settings.contact_url }}" data-vs-track="raf_contact">{{ section.settings.contact_text | escape }}</a></p>
          {%- else -%}
            <div class="referral-intro__actions">
              <a class="series-button" href="{{ section.settings.account_url }}" data-vs-track="raf_account">{{ section.settings.button_text | escape }}</a>
            </div>
            {%- if section.settings.signed_out_note != blank -%}
              <p class="referral-intro__note">{{ section.settings.signed_out_note | escape }} {% if section.settings.how_anchor != blank %}<a href="#{{ section.settings.how_anchor | escape }}">{{ section.settings.how_text | escape }}</a>{% endif %}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="age-intro__media">
          {{- section.settings.image | image_url: width: 920 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1000px) 460px, 100vw', widths: '460,690,920', alt: section.settings.image.alt -}}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if code != blank -%}
<script>
  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-referral-copy]');
    if (!button || !navigator.clipboard) return;
    navigator.clipboard.writeText(button.getAttribute('data-referral-copy')).then(function () {
      var label = button.textContent;
      button.textContent = button.getAttribute('data-copied');
      setTimeout(function () { button.textContent = label; }, 2000);
    });
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Referral intro",
  "tag": "div",
  "class": "shopify-section--referral-intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Refer a friend" },
    { "type": "text", "id": "heading", "label": "Heading (H1)", "default": "Give £10. Collect 3 Golden Tokens. Choose a reward." },
    { "type": "textarea", "id": "lede", "label": "Intro" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop only)" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fff7f0" },
    { "type": "header", "content": "Signed out" },
    { "type": "text", "id": "token_line", "label": "Tokens line", "default": "3 Golden Tokens = a travel case, headphones or a £30 e-gift card" },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Get my referral code" },
    { "type": "url", "id": "account_url", "label": "Button link", "default": "/account" },
    { "type": "text", "id": "signed_out_note", "label": "Note under button", "default": "Your code and share link are in your account, under Extras." },
    { "type": "text", "id": "how_text", "label": "How it works link", "default": "How it works" },
    { "type": "text", "id": "how_anchor", "label": "How it works anchor", "default": "how-it-works" },
    { "type": "header", "content": "Signed in" },
    { "type": "text", "id": "code_label", "label": "Code label", "default": "Your referral code" },
    { "type": "text", "id": "copy_text", "label": "Copy button", "default": "Copy" },
    { "type": "text", "id": "copied_text", "label": "Copied text", "default": "Copied" },
    { "type": "text", "id": "copy_link_text", "label": "Copy link button", "default": "Copy link" },
    { "type": "text", "id": "email_text", "label": "Email button", "default": "Email" },
    { "type": "text", "id": "email_subject", "label": "Email subject", "default": "£10 off a Voxblock starter pack" },
    { "type": "textarea", "id": "share_message", "label": "Share message", "info": "[code] is replaced by the customer's code. The share link is added at the end.", "default": "Here's £10 off a Voxblock starter pack, the screen-free audiobook player. Use my code [code] or this link:" },
    { "type": "text", "id": "share_redirect", "label": "Share link opens", "default": "/collections/voxblock-starter-pack-collection" },
    { "type": "text", "id": "no_code_text", "label": "No code found", "default": "We can't find a referral code on your account." },
    { "type": "text", "id": "contact_text", "label": "Contact link", "default": "Contact us and we'll set one up." },
    { "type": "url", "id": "contact_url", "label": "Contact link URL", "default": "/pages/contact-us" },
    { "type": "checkbox", "id": "show_token_count", "label": "Show token count", "info": "Counts referrals.hasreferred. Leave off until that list is kept up to date.", "default": false },
    { "type": "text", "id": "progress_text", "label": "Token count text", "default": "[count] of 3 Golden Tokens" }
  ],
  "presets": [{ "name": "Referral intro" }]
}
{% endschema %}
