{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
REFERRAL INTRO (templates/page.refer-a-friend.json)
----------------------------------------------------------------------------------------------------------------------
Top of the refer a friend page: offer on the left, three Golden Tokens (photographed, assets/golden-token.webp) on the
right; on phones the tokens sit above the heading.
- Signed out: the "3 tokens = reward" line and one button to the account.
- Signed in with a code: snippet referral-share (code from customer metafield referrals.code, the value the account's
  Extras card shows; Copy, Copy link to /discount/<code>, WhatsApp, Email).
- Signed in without a usable code (blank or "#N/A"): a line pointing to contact us.
- Token count: off by default ("Show token count"). referrals.hasreferred is not kept up to date yet.
Also holds the copy-to-clipboard script for every [data-referral-copy] button on the page.
Clicks send vs_yoto_click { target } through data-vs-track: raf_account, raf_copy_code, raf_copy_link, raf_whatsapp,
raf_email, raf_contact.
{%- endcomment -%}

{%- liquid
  assign code = ''
  if customer
    assign code = customer.metafields.referrals.code.value | default: customer.metafields.referrals.code | strip
    if code contains 'N/A'
      assign code = ''
    endif
  endif

  assign token_count = 0
  if customer and section.settings.show_token_count
    assign referred = customer.metafields.referrals.hasreferred.value
    if referred != blank
      assign token_count = referred.size | modulo: 3
    endif
  endif
-%}

<section class="referral-hero" {{ section.shopify_attributes }}>
  <div class="container referral-hero__inner">
    <div class="referral-hero__visual" aria-hidden="true">
      <span class="referral-hero__glow"></span>
      <span class="referral-hero__coin referral-hero__coin--1">{%- render 'referral-token', large: true, size: 220, eager: true -%}</span>
      <span class="referral-hero__coin referral-hero__coin--2">{%- render 'referral-token', large: true, size: 220, eager: true -%}</span>
      <span class="referral-hero__coin referral-hero__coin--3">{%- render 'referral-token', large: true, size: 220, eager: true -%}</span>
    </div>

    <div class="referral-hero__text">
      {%- if section.settings.eyebrow != blank -%}<p class="subheading referral-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="referral-hero__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.lede != blank -%}<p class="referral-hero__lede">{{ section.settings.lede | escape }}</p>{%- endif -%}

      {%- if code != blank -%}
        {%- render 'referral-share', label: section.settings.code_label -%}
        {%- if section.settings.show_token_count -%}
          <div class="referral-hero__progress">
            <span class="referral-hero__mini-tokens">
              {%- for i in (1..3) -%}{%- if i <= token_count -%}{%- render 'referral-token', size: 34 -%}{%- else -%}{%- render 'referral-token', outline: true, size: 34 -%}{%- endif -%}{%- endfor -%}
            </span>
            <span>{{ section.settings.progress_text | replace: '[count]', token_count | escape }}</span>
          </div>
        {%- endif -%}
      {%- else -%}
        <p class="referral-hero__offer">
          <span class="referral-hero__mini-tokens">{%- render 'referral-token', size: 30 -%}{%- render 'referral-token', size: 30 -%}{%- render 'referral-token', size: 30 -%}</span>
          <span>{{ section.settings.token_line | escape }}</span>
        </p>
        {%- if customer -%}
          <p class="referral-hero__note">{{ section.settings.no_code_text | escape }} <a href="{{ section.settings.contact_url }}" data-vs-track="raf_contact">{{ section.settings.contact_text | escape }}</a></p>
        {%- else -%}
          <div class="referral-hero__actions">
            <a class="series-button" href="{{ section.settings.account_url | default: routes.storefront_login_url }}" data-vs-track="raf_account">{{ section.settings.button_text | escape }}</a>
          </div>
          {%- if section.settings.signed_out_note != blank -%}
            <p class="referral-hero__note">{{ section.settings.signed_out_note | escape }} {% if section.settings.how_anchor != blank %}<a href="#{{ section.settings.how_anchor | escape }}">{{ section.settings.how_text | escape }}</a>{% endif %}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-referral-copy]');
    if (!button || !navigator.clipboard) return;
    navigator.clipboard.writeText(button.getAttribute('data-referral-copy')).then(function () {
      var label = button.textContent;
      button.textContent = button.getAttribute('data-copied');
      setTimeout(function () { button.textContent = label; }, 2000);
    });
  });
</script>

{% schema %}
{
  "name": "Referral intro",
  "tag": "div",
  "class": "shopify-section--referral-intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Refer a friend" },
    { "type": "text", "id": "heading", "label": "Heading (H1)", "default": "Give £10. Collect 3 Golden Tokens. Choose a reward." },
    { "type": "textarea", "id": "lede", "label": "Intro" },
    { "type": "header", "content": "Signed out" },
    { "type": "text", "id": "token_line", "label": "Tokens line", "default": "3 Golden Tokens = a travel case, headphones or a £30 e-gift card" },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Get my referral code" },
    { "type": "text", "id": "account_url", "label": "Button link", "info": "Leave empty: sign in, then come back to this page with the code showing." },
    { "type": "text", "id": "signed_out_note", "label": "Note under button", "default": "Sign in and your code appears here, ready to copy and share." },
    { "type": "text", "id": "how_text", "label": "How it works link", "default": "How it works" },
    { "type": "text", "id": "how_anchor", "label": "How it works anchor", "default": "how-it-works" },
    { "type": "header", "content": "Signed in" },
    { "type": "text", "id": "code_label", "label": "Code label", "default": "Your referral code" },
    { "type": "text", "id": "no_code_text", "label": "No code found", "default": "We can't find a referral code on your account." },
    { "type": "text", "id": "contact_text", "label": "Contact link", "default": "Contact us and we'll set one up." },
    { "type": "text", "id": "contact_url", "label": "Contact link URL", "default": "/pages/contact-us" },
    { "type": "checkbox", "id": "show_token_count", "label": "Show token count", "info": "Counts referrals.hasreferred. Leave off until that list is kept up to date.", "default": false },
    { "type": "text", "id": "progress_text", "label": "Token count text", "default": "[count] of 3 Golden Tokens" }
  ],
  "presets": [{ "name": "Referral intro" }]
}
{% endschema %}
