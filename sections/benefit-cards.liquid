{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
BENEFIT CARDS (Voxblock)
----------------------------------------------------------------------------------------------------------------------
Up to four cards with a hand-drawn stroke icon, heading and short copy. Built for landing pages.
Icons are inline SVG so they take the section's icon colours and need no uploaded files.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  {%- render 'section-spacing-collapsing' -%}

  {%- assign card_background = section.settings.card_background | default: '#ffffff' -%}
  {%- assign card_text = section.settings.card_text_color | default: settings.text_color -%}
  {%- assign card_heading = section.settings.card_heading_color | default: '#197177' -%}
  {%- assign icon_background = section.settings.icon_background | default: '#e9f6f4' -%}
  {%- assign icon_color = section.settings.icon_color | default: '#197177' -%}
  {%- assign icon_accent = section.settings.icon_accent | default: '#ff9e57' -%}

  <style>
    #shopify-section-{{ section.id }} .benefit-cards {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-5);
    }
    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .benefit-cards {
        grid-template-columns: repeat({{ section.blocks.size | at_most: 2 }}, minmax(0, 1fr));
        gap: var(--spacing-6);
      }
    }
    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} .benefit-cards {
        grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, minmax(0, 1fr));
        gap: var(--spacing-8);
      }
    }
    #shopify-section-{{ section.id }} .benefit-card {
      background: {{ card_background }};
      color: {{ card_text }};
      border-radius: var(--rounded-lg);
      box-shadow: 0 18px 40px rgb(0 0 0 / 0.10);
      padding: var(--spacing-8);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-4);
      align-items: {% if section.settings.text_alignment == 'center' %}center{% else %}flex-start{% endif %};
      text-align: {{ section.settings.text_alignment }};
    }
    #shopify-section-{{ section.id }} .benefit-card__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3.25rem;
      height: 3.25rem;
      border-radius: var(--rounded-full);
      background: {{ icon_background }};
      color: {{ icon_color }};
    }
    #shopify-section-{{ section.id }} .benefit-card__icon svg { width: 1.625rem; height: 1.625rem; }
    #shopify-section-{{ section.id }} .benefit-card__icon .accent { stroke: {{ icon_accent }}; }
    #shopify-section-{{ section.id }} .benefit-card__icon .accent-fill { fill: {{ icon_accent }}; stroke: none; }
    #shopify-section-{{ section.id }} .benefit-card__title {
      color: {{ card_heading }};
      margin: 0;
    }
  </style>

  <div {% render 'section-properties' %}>
    <div class="section-stack">
      {%- render 'section-header', subheading: section.settings.subheading, heading: section.settings.title, heading_color: section.settings.heading_color, content: section.settings.content, text_alignment: 'center' -%}

      <div class="benefit-cards">
        {%- for block in section.blocks -%}
          <div class="benefit-card" {{ block.shopify_attributes }}>
            <span class="benefit-card__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'no-wifi' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8.5a15 15 0 0 1 20 0"/><path d="M5.5 12a10 10 0 0 1 13 0"/><path d="M9 15.5a5 5 0 0 1 6 0"/><circle cx="12" cy="19" r="1" fill="currentColor"/><path class="accent" d="M3 3l18 18" stroke-width="2.4"/></svg>
                {%- when 'no-app' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10 18.5h4"/><path class="accent" d="M3 3l18 18" stroke-width="2.4"/></svg>
                {%- when 'book' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4.5h6.5a2 2 0 0 1 2 2V20a1.5 1.5 0 0 0-1.5-1.5H4z"/><path d="M20 4.5h-6.5a2 2 0 0 0-2 2V20a1.5 1.5 0 0 1 1.5-1.5H20z"/><path class="accent" d="M6.5 8.5h3M6.5 11.5h3"/></svg>
                {%- when 'no-screen' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path class="accent" d="M3 3l18 18" stroke-width="2.4"/></svg>
                {%- when 'box' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l9-4.5L21 8v9l-9 4.5L3 17z"/><path d="M3 8l9 4.5L21 8M12 12.5V21.5"/><path class="accent" d="M7.5 5.75l9 4.5"/></svg>
                {%- when 'play' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path class="accent-fill" d="M10 8.5v7l5.5-3.5z"/></svg>
                {%- when 'battery' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="7" width="17" height="10" rx="2"/><path d="M22 10.5v3"/><path class="accent" d="M6 10.5v3M9.5 10.5v3M13 10.5v3"/></svg>
                {%- when 'hands' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/><path class="accent" d="M9.5 11h5"/></svg>
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path class="accent" d="M7.5 12.5l3 3 6-6" stroke-width="2.4"/></svg>
                {%- when 'ear' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 10a6 6 0 0 1 12 0c0 3-2 4-2.5 6a3 3 0 0 1-5.5 1"/><path class="accent" d="M10 10a2 2 0 0 1 4 0c0 1.5-1.5 2-1.5 3.5"/></svg>
              {%- endcase -%}
            </span>

            {%- if block.settings.title != blank -%}
              <p class="h4 benefit-card__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}

            {%- if block.settings.content != blank -%}
              <div class="prose">{{ block.settings.content }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Benefit cards",
  "class": "shopify-section--benefit-cards",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Why parents switch"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Simple enough for a two-year-old to work"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Card text alignment",
      "options": [
        {"value": "start", "label": "Left"},
        {"value": "center", "label": "Center"}
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card heading",
      "default": "#197177"
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#e9f6f4"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#197177"
    },
    {
      "type": "color",
      "id": "icon_accent",
      "label": "Icon accent",
      "default": "#ff9e57"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {"value": "no-wifi", "label": "No wifi"},
            {"value": "no-app", "label": "No app"},
            {"value": "no-screen", "label": "No screen"},
            {"value": "book", "label": "Book"},
            {"value": "box", "label": "Box"},
            {"value": "play", "label": "Play"},
            {"value": "battery", "label": "Battery"},
            {"value": "hands", "label": "Heart"},
            {"value": "check", "label": "Tick"},
            {"value": "ear", "label": "Listening"}
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Nothing to set up"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>No wifi, no accounts, no app to download.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefit cards",
      "blocks": [
        {"type": "card", "settings": {"icon": "no-wifi", "title": "Nothing to set up", "content": "<p>No wifi, no accounts, no app to download. Charge it, slot a book in, press play.</p>"}},
        {"type": "card", "settings": {"icon": "book", "title": "Stories you can hold", "content": "<p>Each audiobook is a small physical book that slots into the player.</p>"}},
        {"type": "card", "settings": {"icon": "no-screen", "title": "Truly screen-free", "content": "<p>No display, no menus, no ads, no autoplay.</p>"}}
      ]
    }
  ]
}
{% endschema %}
