{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
HELP TOPIC (help pages: player guide, delivery and returns)
----------------------------------------------------------------------------------------------------------------------
One topic of a help page, reachable by its anchor (e.g. /pages/player-guide#charging): heading, text, optional
picture beside it, optional numbered steps, an optional note box and up to two links.
Blocks: "Table row" (two cells; for rates and the like) and "File" (a download link with a picture, for the printed
quick start guides). Headings say the task, not the problem (help-pages-review.md, section 5).
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign steps = st.steps | newline_to_br | split: '<br />'
  assign rows = section.blocks | where: 'type', 'row'
  assign files = section.blocks | where: 'type', 'file'
-%}

<section class="help-topic{% if st.tinted %} help-band--tinted{% endif %}{% if st.image != blank %} help-topic--media help-topic--media-{{ st.image_position }}{% endif %}" id="{{ st.anchor | escape }}" {{ section.shopify_attributes }}>
  <div class="container help-topic__inner">
    <div class="help-topic__text">
      {%- if st.eyebrow != blank -%}<p class="help-topic__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h3">{{ st.heading | escape }}</h2>
      {%- if st.content != blank -%}<div class="help-topic__content prose">{{ st.content }}</div>{%- endif -%}

      {%- if st.steps != blank -%}
        {%- if st.steps_heading != blank -%}<h3 class="h5">{{ st.steps_heading | escape }}</h3>{%- endif -%}
        <ol class="help-steps">
          {%- for step in steps -%}
            {%- assign step_text = step | strip -%}
            {%- if step_text != blank -%}<li>{{ step_text | escape }}</li>{%- endif -%}
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if rows.size > 0 -%}
        <table class="help-topic__table">
          {%- if st.table_head_1 != blank -%}
            <thead><tr><th scope="col">{{ st.table_head_1 | escape }}</th><th scope="col">{{ st.table_head_2 | escape }}</th></tr></thead>
          {%- endif -%}
          <tbody>
            {%- for block in rows -%}
              <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.label | escape }}</th><td>{{ block.settings.value | escape }}</td></tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- endif -%}

      {%- if st.note != blank -%}<div class="help-topic__note">{{ st.note }}</div>{%- endif -%}

      {%- if files.size > 0 -%}
        <div class="help-topic__files">
          {%- for block in files -%}
            <a class="help-topic__file" href="{{ block.settings.url }}" data-help-track="download_{{ block.settings.title | handleize }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{- block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', sizes: '120px', widths: '120,240', alt: '' -}}
              {%- endif -%}
              <span class="help-topic__file-text">
                <span class="help-topic__file-title">{{ block.settings.title | escape }}</span>
                {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
                <span class="help-topic__file-link">{{ block.settings.link_text | escape }}</span>
              </span>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- liquid
        assign has_link = false
        if st.link_text != blank and st.link_url != blank
          assign has_link = true
        endif
        if st.link2_text != blank and st.link2_url != blank
          assign has_link = true
        endif
      -%}
      {%- if has_link -%}
        <p class="help-topic__links">
          {%- if st.link_text != blank and st.link_url != blank -%}<a href="{{ st.link_url }}" data-help-track="{{ st.anchor | append: '_link' }}">{{ st.link_text | escape }} <span aria-hidden="true">→</span></a>{%- endif -%}
          {%- if st.link2_text != blank and st.link2_url != blank -%}<a href="{{ st.link2_url }}" data-help-track="{{ st.anchor | append: '_link2' }}">{{ st.link2_text | escape }} <span aria-hidden="true">→</span></a>{%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- if st.image != blank -%}
      <div class="help-topic__media">
        {{- st.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 460px, 100vw', widths: '400,600,800,1000', alt: st.image.alt -}}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Help topic",
  "tag": "div",
  "class": "shopify-section--help-topic",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor (no #)", "info": "e.g. charging: links to /pages/player-guide#charging" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Charging" },
    { "type": "richtext", "id": "content", "label": "Text" },
    { "type": "text", "id": "steps_heading", "label": "Steps heading" },
    { "type": "textarea", "id": "steps", "label": "Steps", "info": "One step per line, shown numbered." },
    { "type": "text", "id": "table_head_1", "label": "Table heading 1" },
    { "type": "text", "id": "table_head_2", "label": "Table heading 2" },
    { "type": "richtext", "id": "note", "label": "Note box" },
    { "type": "text", "id": "link_text", "label": "Link text" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "text", "id": "link2_text", "label": "Second link text" },
    { "type": "url", "id": "link2_url", "label": "Second link" },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "select", "id": "image_position", "label": "Picture position", "default": "end", "options": [
      { "value": "start", "label": "Left" },
      { "value": "end", "label": "Right" }
    ] },
    { "type": "checkbox", "id": "tinted", "label": "Tinted background", "default": false }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Table row",
      "settings": [
        { "type": "text", "id": "label", "label": "First cell", "default": "Standard delivery" },
        { "type": "text", "id": "value", "label": "Second cell", "default": "£3.50, 2 to 3 working days" }
      ]
    },
    {
      "type": "file",
      "name": "File",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Quick start guide" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "Download (PDF)" },
        { "type": "url", "id": "url", "label": "File link" },
        { "type": "image_picker", "id": "image", "label": "Picture" }
      ]
    }
  ],
  "presets": [{ "name": "Help topic" }]
}
{% endschema %}
