{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
STORY STEPS ("In what order do the characters appear?", templates/metaobject/characters.gruffalo.json)
----------------------------------------------------------------------------------------------------------------------
A heading, an intro and a numbered list (block "step": title + short text). Replaces the "How the cast works"
rich text on the cast page and keeps its paragraph as the intro, so the page's text is kept.
{%- endcomment -%}

<section class="story-steps" {{ section.shopify_attributes }}>
  <div class="container story-steps__inner">
    <div class="story-steps__head">
      {%- if section.settings.eyebrow != blank -%}<p class="story-steps__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="series-heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<div class="story-steps__intro">{{ section.settings.intro }}</div>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="story-steps__list">
        {%- for block in section.blocks -%}
          <li class="story-steps__step" {{ block.shopify_attributes }}>
            <span class="story-steps__num" aria-hidden="true">{{ forloop.index }}</span>
            <span class="story-steps__body">
              <span class="story-steps__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="story-steps__text">{{ block.settings.text | escape }}</span>{%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Story steps",
  "tag": "div",
  "class": "shopify-section--story-steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (H2)", "default": "In what order do the characters appear?" },
    { "type": "richtext", "id": "intro", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Story steps" }]
}
{% endschema %}
