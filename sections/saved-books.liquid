{%- render 'section-spacing-collapsing' -%}

{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
CSS
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .product-list {
    --product-list-gap: {% if section.settings.products_per_row_mobile == '1' %}var(--grid-gutter){% else %}var(--product-list-row-gap){% endif %} var(--spacing-2);
    --product-list-items-per-row: {{ section.settings.products_per_row_mobile | times: 1 }};
    --product-list-grid: auto / repeat(var(--product-list-items-per-row), minmax(0, 1fr));
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .product-list {
      --product-list-gap: var(--product-list-row-gap) var(--product-list-column-gap);
      --product-list-items-per-row: 2;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .product-list {
      --product-list-items-per-row: {{ section.settings.products_per_row_desktop }};
    }
  }
</style>

{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
LIQUID
------------------------------------------------------------------------------------------------------------------------

The saved list lives in the visitor's browser, so the page is filled in by assets/saved-books.js. It asks for this
section through the search page (?q=id:1 OR id:2&section_id=...), which renders the "search.performed" branch below:
one product card per saved ID, in saved order.

Opened from a shared link (?shared=...&from=...), the script hides the visitor's own heading and list bar, shows
the "shared" heading instead and renders the shared books.
{%- endcomment -%}

{%- if search.performed -%}
  <div data-saved-books-results>
    {%- assign parsed_terms = search.terms | split: ' OR ' -%}

    {%- for parsed_term in parsed_terms -%}
      {%- assign id = parsed_term | split: 'id:' | last | times: 1 -%}
      {%- assign product_to_render = search.results | where: 'id', id | first -%}

      {%- if product_to_render != blank -%}
        {%- render 'product-card', product: product_to_render, stacked: true, background: section.settings.product_card_background, text_color: section.settings.product_card_text_color, show_badges: true -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- else -%}
  <saved-books-list section-id="{{ section.id }}" {% render 'section-properties' %}>
    <div class="section-stack">
      <div class="section-stack" data-saved-books-own>
        {%- render 'section-header', subheading: section.settings.subheading, heading: section.settings.title, heading_color: section.settings.heading_color, heading_gradient: section.settings.heading_gradient, content: section.settings.content, tag: 'h1' -%}

        {%- comment -%}
          Two rows: where the list is kept (with the Save with my email button when signed out) and the wish list prompt.
          Signed out, the account row comes first; signed in, it is just a quiet line under the wish list prompt.
        {%- endcomment -%}
        {%- capture account_row -%}
          <div class="saved-books__row saved-books__row--account{% if customer %} saved-books__row--quiet{% endif %}">
            {%- if customer -%}
              {%- assign customer_email = customer.email | escape -%}
              <p class="saved-books__row-text">{{ section.settings.account_signed_in_text | escape | replace: '[email]', customer_email }}</p>
            {%- else -%}
              <p class="saved-books__row-text">{{ section.settings.account_text | escape }}</p>

              {%- if section.settings.account_button_label != blank -%}
                {%- capture sign_in_url -%}/customer_authentication/login?return_to={{ request.path | url_encode }}{%- endcapture -%}
                {%- render 'button', href: sign_in_url, content: section.settings.account_button_label -%}
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endcapture -%}

        {%- capture wish_list_row -%}
          {%- if section.settings.share_button_label != blank -%}
            {%- assign share_menu_id = 'saved-books-share-menu-' | append: section.id -%}
            <div class="saved-books__row saved-books__row--wish-list" data-saved-books-share data-share-text="{{ section.settings.share_text | escape }}" data-share-subject="{{ section.settings.share_email_subject | escape }}" hidden>
              <div class="saved-books__row-text">
                {%- if section.settings.share_title != blank -%}
                  <strong class="block">{{ section.settings.share_title | escape }}</strong>
                {%- endif -%}

                {%- if section.settings.share_description != blank -%}
                  <span class="text-subdued">{{ section.settings.share_description | escape }}</span>
                {%- endif -%}
              </div>

              <div class="saved-books__send">
                <div data-saved-books-share-trigger>
                  {%- render 'button', content: section.settings.share_button_label, icon: 'picto-gift', aria_controls: share_menu_id -%}
                </div>

                {%- comment -%}Desktop browsers without a share sheet: a short list of ways to send the link (filled in by saved-books.js){%- endcomment -%}
                <div class="saved-books__menu" id="{{ share_menu_id }}" data-saved-books-share-menu hidden>
                  <a href="#" target="_blank" rel="noopener" data-share-channel="whatsapp">
                    {%- render 'icon' with 'whatsapp', width: 18, height: 18 -%}
                    <span>WhatsApp</span>
                  </a>
                  <a href="#" data-share-channel="email">
                    {%- render 'icon' with 'email', width: 18, height: 14 -%}
                    <span>Email</span>
                  </a>
                  <button type="button" data-share-channel="copy_link">
                    <svg role="presentation" fill="none" focusable="false" stroke-width="1.5" width="18" height="18" viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>Copy link</span>
                  </button>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endcapture -%}

        <div class="saved-books__bar">
          {%- if customer -%}
            {{- wish_list_row -}}
            {{- account_row -}}
          {%- else -%}
            {{- account_row -}}
            {{- wish_list_row -}}
          {%- endif -%}
        </div>
      </div>

      <div class="v-stack gap-6 justify-items-start" data-saved-books-shared hidden>
        <div class="prose">
          <h1 class="h2" data-saved-books-shared-heading data-heading-named="{{ section.settings.shared_heading | escape }}" data-heading-anonymous="{{ section.settings.shared_heading_anonymous | escape }}"></h1>

          {%- if section.settings.shared_text != blank -%}
            <p>{{ section.settings.shared_text | escape }}</p>
          {%- endif -%}
        </div>

        <div class="saved-books__shared-actions">
          <div data-saved-books-save-all data-label="{{ section.settings.save_all_button_label | escape }}" data-label-done="{{ section.settings.save_all_done_label | escape }}">
            {%- render 'button', content: section.settings.save_all_button_label -%}
          </div>

          <a href="{{ request.path }}" class="link">{{ section.settings.own_list_link_label | escape }}</a>
        </div>
      </div>

      <p class="text-subdued" data-saved-books-loading>Loading books…</p>

      <div class="v-stack gap-6 justify-items-start" data-saved-books-empty hidden>
        {%- if section.settings.empty_text != blank -%}
          <div class="prose">{{ section.settings.empty_text }}</div>
        {%- endif -%}

        {%- if section.settings.empty_button_label != blank -%}
          {%- render 'button', href: section.settings.empty_button_link, content: section.settings.empty_button_label -%}
        {%- endif -%}
      </div>

      <p data-saved-books-shared-empty hidden>Sorry, the books in this list aren't available any more.</p>

      <p data-saved-books-error hidden>Sorry, we couldn't load these books. Please refresh the page to try again.</p>

      <product-list class="product-list" data-saved-books-grid hidden></product-list>

      {%- if section.settings.continue_button_label != blank -%}
        <div class="text-center" data-saved-books-actions hidden>
          {%- render 'button', href: section.settings.continue_button_link, content: section.settings.continue_button_label -%}
        </div>
      {%- endif -%}

      <noscript>
        <p>Please turn on JavaScript to see your saved books.</p>
      </noscript>
    </div>
  </saved-books-list>
{%- endif -%}

{% schema %}
{
  "name": "Saved books",
  "class": "shopify-section--saved-books",
  "tag": "section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the audiobooks a visitor has saved with the heart button. The list is kept in their browser."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "Products per row (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "min": 2,
      "max": 5,
      "label": "Products per row (desktop)",
      "default": 4
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Saved books"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "info": "Optional text under the heading. Left empty on the live page."
    },
    {
      "type": "header",
      "content": "Account",
      "info": "A line above the list. Signed-out visitors get a button that signs them in to keep the list; signed-in customers see where their list is kept."
    },
    {
      "type": "text",
      "id": "account_text",
      "label": "Text (signed out)",
      "default": "Keep your list on any device"
    },
    {
      "type": "text",
      "id": "account_button_label",
      "label": "Button label (signed out)",
      "default": "Save with my email"
    },
    {
      "type": "text",
      "id": "account_signed_in_text",
      "label": "Text (signed in)",
      "info": "[email] is replaced with the customer's email address.",
      "default": "Saved to [email]"
    },
    {
      "type": "header",
      "content": "Wish list",
      "info": "Lets someone send their list to family or friends as a link. Leave the button label empty to hide it."
    },
    {
      "type": "text",
      "id": "share_title",
      "label": "Heading",
      "default": "Birthday or Christmas coming up?"
    },
    {
      "type": "text",
      "id": "share_description",
      "label": "Text",
      "default": "Send this list to family so they know what to get."
    },
    {
      "type": "text",
      "id": "share_button_label",
      "label": "Button label",
      "default": "Send my wish list"
    },
    {
      "type": "text",
      "id": "share_text",
      "label": "Message sent with the link",
      "default": "Here's my Voxblock wish list, in case you're stuck for ideas:"
    },
    {
      "type": "text",
      "id": "share_email_subject",
      "label": "Email subject",
      "default": "My Voxblock wish list"
    },
    {
      "type": "header",
      "content": "When someone opens the link"
    },
    {
      "type": "text",
      "id": "shared_heading",
      "label": "Heading",
      "info": "[name] is the sender's first name (when they're signed in); [books] is the number of books, e.g. \"6 books\".",
      "default": "[name]'s wish list: [books]"
    },
    {
      "type": "text",
      "id": "shared_heading_anonymous",
      "label": "Heading when the sender isn't signed in",
      "default": "A Voxblock wish list: [books]"
    },
    {
      "type": "text",
      "id": "shared_text",
      "label": "Text under the heading",
      "default": "Looking for a gift idea? Tap the heart on the ones you like, or save them all to your own list."
    },
    {
      "type": "text",
      "id": "save_all_button_label",
      "label": "Save all button label",
      "default": "Save all to my list"
    },
    {
      "type": "text",
      "id": "save_all_done_label",
      "label": "Save all button label once saved",
      "default": "All saved to your list"
    },
    {
      "type": "text",
      "id": "own_list_link_label",
      "label": "Link to the visitor's own list",
      "default": "See my saved books"
    },
    {
      "type": "header",
      "content": "Under the list"
    },
    {
      "type": "text",
      "id": "continue_button_label",
      "label": "Button under the list",
      "default": "Continue browsing"
    },
    {
      "type": "url",
      "id": "continue_button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "When nothing is saved"
    },
    {
      "type": "richtext",
      "id": "empty_text",
      "label": "Text",
      "default": "<p>You haven't saved any books yet. Tap the heart on any audiobook to keep it here.</p>"
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Button label",
      "default": "Browse audiobooks"
    },
    {
      "type": "url",
      "id": "empty_button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Colors",
      "info": "Gradient replaces solid colors when set."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "Heading gradient"
    },
    {
      "type": "color",
      "id": "product_card_background",
      "label": "Product card background"
    },
    {
      "type": "color",
      "id": "product_card_text_color",
      "label": "Product card text"
    }
  ],
  "presets": [
    {
      "name": "Saved books"
    }
  ]
}
{% endschema %}
