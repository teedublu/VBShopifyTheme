{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
HELP HERO (help pages: page.help, page.quick-fixes, page.player-guide, page.delivery-and-returns, page.faq,
page.contact)
----------------------------------------------------------------------------------------------------------------------
Tinted band with a "Help centre" trail, the page's H1 and a short intro. Optional "Ask Saga" button (opens the help
assistant, data-saga-open) and a second link button. Blocks: "Jump link" (on-this-page links, e.g. #charging).
The trail and its BreadcrumbList JSON-LD (Home › Help centre › this page) are left out on the hub itself
(set "Parent page" to blank). Plans: briefs/help-pages.md.
Clicks send help_click { target, page } (voxblock.js).
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign parent_url = section.settings.parent_url
  assign parent_title = section.settings.parent_title | default: 'Help centre'
-%}

<section class="help-hero{% if section.settings.joined %} help-hero--joined{% endif %}" {{ section.shopify_attributes }}>
  <div class="container help-hero__inner">
    {%- if parent_url != blank -%}
      <nav class="help-hero__trail" aria-label="Breadcrumb">
        <a href="{{ parent_url }}">{{ parent_title | escape }}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{{ section.settings.trail_label | default: heading | escape }}</span>
      </nav>
    {%- endif -%}

    <h1 class="h1 help-hero__title">{{ heading | escape }}</h1>

    {%- if section.settings.intro != blank -%}
      <div class="help-hero__intro">{{ section.settings.intro }}</div>
    {%- endif -%}

    {%- if section.settings.show_saga or section.settings.button_text != blank -%}
      <div class="help-hero__actions">
        {%- if section.settings.show_saga -%}
          <button type="button" class="button help-hero__saga" data-saga-open="help_hero" data-help-track="ask_saga">
            {%- render 'saga-avatar', id: section.id, class: 'help-hero__saga-avatar', size: 28 -%}
            <span>{{ section.settings.saga_text | escape }}</span>
          </button>
        {%- endif -%}
        {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
          <a class="button button--outline" href="{{ section.settings.button_url }}" data-help-track="{{ section.settings.button_text | handleize }}">{{ section.settings.button_text | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <nav class="help-hero__jump" aria-label="{{ section.settings.jump_label | escape }}">
        <span class="help-hero__jump-label">{{ section.settings.jump_label | escape }}</span>
        <ul>
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.url }}">{{ block.settings.label | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</section>

{%- if parent_url != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ parent_title | json }}, "item": {{ shop.url | append: parent_url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ section.settings.trail_label | default: heading | json }}, "item": {{ shop.url | append: request.path | json }} }
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Help hero",
  "tag": "div",
  "class": "shopify-section--help-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (H1)", "info": "Blank uses the page title. Lead with the task, never the problem." },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "header", "content": "Help centre trail" },
    { "type": "url", "id": "parent_url", "label": "Parent page", "info": "Blank on the help centre itself." },
    { "type": "text", "id": "parent_title", "label": "Parent name", "default": "Help centre" },
    { "type": "text", "id": "trail_label", "label": "This page in the trail", "info": "Blank uses the heading." },
    { "type": "checkbox", "id": "joined", "label": "Join to the section below", "info": "No bottom padding, for the quick fixes player.", "default": false },
    { "type": "header", "content": "Buttons" },
    { "type": "checkbox", "id": "show_saga", "label": "Show 'Ask Saga' button", "default": false },
    { "type": "text", "id": "saga_text", "label": "Saga button text", "default": "Ask Saga for an instant answer" },
    { "type": "text", "id": "button_text", "label": "Second button text" },
    { "type": "url", "id": "button_url", "label": "Second button link" },
    { "type": "text", "id": "jump_label", "label": "Jump links label", "default": "On this page" }
  ],
  "blocks": [
    {
      "type": "jump",
      "name": "Jump link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Charging" },
        { "type": "text", "id": "url", "label": "Link", "default": "#charging", "info": "An anchor on this page, e.g. #charging" }
      ]
    }
  ],
  "presets": [{ "name": "Help hero" }]
}
{% endschema %}
