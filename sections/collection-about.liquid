{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
COLLECTION ABOUT (age collection template)
----------------------------------------------------------------------------------------------------------------------

The collection description, moved out of the banner and shown under the grid in a closed <details> so it stays in the
page (and for search engines) without pushing the products down. Nothing is shown if the description is empty.

Above it, "More story themes": links to the collections in the collection's landing.related metafield (a list of
collections, set in Shopify admin on each collection). Nothing is shown if it is empty.
{%- endcomment -%}

{%- assign related = collection.metafields.landing.related.value -%}
{%- if related != blank and related.size > 0 -%}
  <nav class="container collection-related" aria-labelledby="collection-related-{{ section.id }}" {{ section.shopify_attributes }}>
    <h2 id="collection-related-{{ section.id }}" class="collection-related__title">{{ 'collection.age_intro.related_heading' | t }}</h2>
    <div class="age-intro__tabs">
      {%- for related_collection in related -%}
        {%- if related_collection.id == collection.id -%}{%- continue -%}{%- endif -%}
        {%- assign related_label = related_collection.metafields.landing.short_name.value | default: related_collection.title -%}
        <a href="{{ related_collection.url }}" class="age-intro__tab" data-age-track="related:{{ related_collection.handle | escape }}">{{ related_label | escape }}</a>
      {%- endfor -%}
    </div>
  </nav>
{%- endif -%}

{%- comment -%}
Collection FAQ: questions from the collection's landing.faq metafield (JSON list of {"q": "...", "a": "..."}), shown as
an accordion with FAQPage JSON-LD. Nothing is shown if it is empty.
{%- endcomment -%}
{%- assign faq_items = collection.metafields.landing.faq.value -%}
{%- if faq_items != blank and faq_items.size > 0 -%}
  <div class="container collection-faq" {{ section.shopify_attributes }}>
    <h2 class="collection-related__title">{{ 'collection.age_intro.faq_heading' | t }}</h2>
    <div {% render 'surface', class: 'accordion-box rounded', background_fallback: 'bg-secondary' %}>
      {%- for item in faq_items -%}
        {%- if item.q != blank and item.a != blank -%}
          {%- capture faq_answer -%}<div class="prose"><p>{{ item.a | escape }}</p></div>{%- endcapture -%}
          {%- render 'accordion', title: item.q, content: faq_answer -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": {{ canonical_url | append: '#faq' | json }},
      "mainEntity": [
        {%- for item in faq_items -%}
          {
            "@type": "Question",
            "name": {{ item.q | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- if collection.description != blank -%}
  <div class="container collection-about" {{ section.shopify_attributes }}>
    <details class="collection-about__details" {% if section.settings.open %}open{% endif %}>
      <summary class="collection-about__summary">
        <span>{{ section.settings.title | default: collection.title | escape }}</span>
        {%- render 'icon' with 'chevron-bottom-small' -%}
      </summary>
      <div class="prose collection-about__body">{{ collection.description }}</div>
    </details>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection about",
  "tag": "section",
  "class": "shopify-section--collection-about",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "About these audiobooks", "info": "Leave empty to use the collection title." },
    { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
  ],
  "presets": [{ "name": "Collection about" }]
}
{% endschema %}
