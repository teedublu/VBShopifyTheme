{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
REFERRAL STEPS (templates/page.refer-a-friend.json)
----------------------------------------------------------------------------------------------------------------------
"How it works" for the refer a friend page: numbered steps on gold markers, four across from 1000px.
A step with "Show the customer's code" on swaps, for a signed-in customer with a code, to its signed-in title and
text plus the code with copy and share buttons (snippet referral-share). Signed out, or with no code, it shows the
normal title and text.
{%- endcomment -%}

{%- liquid
  assign has_code = false
  if customer
    assign code = customer.metafields.referrals.code.value | default: customer.metafields.referrals.code | strip
    if code != blank
      unless code contains 'N/A'
        assign has_code = true
      endunless
    endif
  endif
-%}

<section class="referral-steps" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | escape }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="container referral-steps__inner">
    <div class="referral-steps__head">
      <h2 class="series-heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<p class="referral-steps__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </div>
    <ol class="referral-steps__list">
      {%- for block in section.blocks -%}
        {%- assign show_share = false -%}
        {%- if block.settings.show_code and has_code -%}{%- assign show_share = true -%}{%- endif -%}
        <li class="referral-steps__step{% if show_share %} referral-steps__step--code{% endif %}" {{ block.shopify_attributes }}>
          <span class="referral-steps__num" aria-hidden="true">{{ forloop.index }}</span>
          <div class="referral-steps__body">
            {%- if show_share -%}
              <h3 class="referral-steps__title">{{ block.settings.title_signed_in | default: block.settings.title | escape }}</h3>
              {%- if block.settings.text_signed_in != blank -%}<p class="referral-steps__text">{{ block.settings.text_signed_in | escape }}</p>{%- endif -%}
              {%- render 'referral-share', compact: true, track_prefix: 'raf_step_' -%}
            {%- else -%}
              <h3 class="referral-steps__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}<p class="referral-steps__text">{{ block.settings.text | escape }}</p>{%- endif -%}
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Referral steps",
  "tag": "div",
  "class": "shopify-section--referral-steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (H2)", "default": "How it works" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "how-it-works" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "checkbox", "id": "show_code", "label": "Show the customer's code", "info": "Signed-in customers with a code see the titles below and their code with share buttons.", "default": false },
        { "type": "text", "id": "title_signed_in", "label": "Title when signed in" },
        { "type": "textarea", "id": "text_signed_in", "label": "Text when signed in" }
      ]
    }
  ],
  "presets": [{ "name": "Referral steps" }]
}
{% endschema %}
