{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
VS BUY (Voxblock vs Yoto page)
----------------------------------------------------------------------------------------------------------------------
Add-to-basket button for one product, used by the VS hero, the comparison table (and its compact sticky header) and
the price breakdown cards. Adds through the theme's product-form, so the cart drawer opens as it does everywhere else.

Variables:
* product: the product [REQUIRED]
* variant: the variant to add. Defaults to the cheapest available variant (for the player that is "No bumper", which
  matches the price the page shows).
* button_text: button label. Defaults to "Add to basket".
* swatches: true to show the bumper colour swatches (same markup and JS as the pack cards: voxblock.js swaps the
  variant id when a swatch is picked).
* compact: true for the small button used in the sticky header.
* track: PostHog target name, sent as vs_yoto_click { target, page } (voxblock.js).
* id_suffix: makes swatch input names unique when the same product appears twice in one section.
{%- endcomment -%}

{%- liquid
  assign buy_variant = variant
  if buy_variant == blank
    for v in product.variants
      if v.available
        if buy_variant == blank or v.price < buy_variant.price
          assign buy_variant = v
        endif
      endif
    endfor
  endif
  if buy_variant == blank
    assign buy_variant = product.selected_or_first_available_variant
  endif
  assign label = button_text | default: 'Add to basket'
-%}

<div class="vs-buy{% if compact %} vs-buy--compact{% endif %}" data-variant-card>
  {%- if swatches and compact != true and settings.product_color_display == 'swatch' -%}
    {%- assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ',' -%}
    {%- for color_label in color_label_list -%}
      {%- if product.options_by_name[color_label] != blank -%}
        {%- assign product_option = product.options_by_name[color_label] -%}
        {%- capture name -%}vs-swatch-{{ section.id }}-{{ product.id }}-{{ product_option.position }}{{ id_suffix }}{%- endcapture -%}
        <fieldset class="vs-buy__swatches h-stack gap-0.5" data-variant-swatches>
          <legend class="vs-buy__legend">Bumper colour</legend>
          {%- liquid
            for option_value in product_option.values limit: 4
              if option_value == buy_variant.title
                assign selected = true
              else
                assign selected = false
              endif
              assign swatch_variant = product.variants | where: 'title', option_value | first
              if swatch_variant.metafields.bumper.colour
                render 'option-value', type: 'swatch', value: option_value, color: swatch_variant.metafields.bumper.colour, name: name, selected: selected, size: 'sm'
              elsif option_value.swatch.color
                render 'option-value', type: 'swatch', value: option_value, color: option_value.swatch.color, name: name, selected: selected, size: 'sm'
              else
                render 'option-value', type: 'swatch', value: option_value, name: name, selected: selected, size: 'sm'
              endif
            endfor
          -%}
        </fieldset>
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if buy_variant.available -%}
    {%- form 'product', product, is: 'product-form', class: 'vs-buy__form' -%}
      <input type="hidden" name="id" value="{{ buy_variant.id }}" data-pack-variant-id>
      {%- capture variant_map -%}{%- for v in product.variants -%}{{ v.title | escape }}={{ v.id }}{% unless forloop.last %};{% endunless %}{%- endfor -%}{%- endcapture -%}
      <input type="hidden" data-pack-variant-map value="{{ variant_map }}">
      <button type="submit" class="vs-buy__button" data-vs-track="{{ track | default: 'add' }}" aria-label="{{ label | escape }}: {{ product.title | escape }}">
        {%- render 'icon' with 'cart', width: 18, height: 18 -%}<span>{{ label | escape }}</span>
      </button>
    {%- endform -%}
  {%- else -%}
    <a class="vs-buy__button vs-buy__button--secondary" href="{{ product.url }}" data-vs-track="{{ track | default: 'add' }}_sold_out">See details</a>
  {%- endif -%}
</div>
