{%- comment -%}
Black Friday countdown in sections/black-friday-code. Before: dark tiles counting to the start; live: glowing tiles to
the end. Digits are filled server-side and ticked by the section's script.
Accepts: phase ('before' or 'during'), variant, target_iso, left_d, left_h, left_m, left_x, start_label, end_label,
reload (true: reload the page at zero).
{%- endcomment -%}
<div class="bf-timer bf-timer--{{ phase }}">
  <p class="bf-timer__label">
    {%- if phase == 'before' -%}
      <svg class="bf-timer__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Opens in
    {%- else -%}
      <span class="bf-timer__dot" aria-hidden="true"></span>Live now · ends in
    {%- endif -%}
  </p>
  <div class="bf-timer__units" role="timer" aria-label="{% if phase == 'before' %}Time until the offers open{% else %}Time left on the offers{% endif %}" data-bf-timer data-target="{{ target_iso | escape }}"{% if reload %} data-reload{% endif %}>
    <span class="bf-timer__unit"><span class="bf-timer__num" data-unit="d">{% if left_d < 10 %}0{% endif %}{{ left_d }}</span><span class="bf-timer__name">days</span></span>
    <span class="bf-timer__unit"><span class="bf-timer__num" data-unit="h">{% if left_h < 10 %}0{% endif %}{{ left_h }}</span><span class="bf-timer__name">hrs</span></span>
    <span class="bf-timer__unit"><span class="bf-timer__num" data-unit="m">{% if left_m < 10 %}0{% endif %}{{ left_m }}</span><span class="bf-timer__name">mins</span></span>
    <span class="bf-timer__unit"><span class="bf-timer__num" data-unit="s">{% if left_x < 10 %}0{% endif %}{{ left_x }}</span><span class="bf-timer__name">secs</span></span>
  </div>
  <p class="bf-timer__when">{% if phase == 'before' %}{{ start_label }}{% elsif variant == 'during' %}Test countdown. Real end: {{ end_label }}{% else %}Ends {{ end_label }}{% endif %}</p>
</div>
