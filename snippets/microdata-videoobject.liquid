{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
VideoObject JSON-LD for the video section (rendered inside a <script type="application/ld+json"> by sections/video)

Name and description:
- Audiobook product page (product type "Audiobooks") or audiobook entry page: built from the book, as before.
- Everywhere else (homepage, player, packs, series, characters…): the section's "JSON-LD title/description" settings.
  Before 13 Oct 2026 every product page used the audiobook wording, so the player video was called
  "Transcript of Voxblock Audiobook Player Audiobook".

Thumbnail: the Shopify video's own preview image (the MP4 source has none, which gave the "no image" placeholder),
or YouTube's thumbnails for a YouTube video. uploadDate stays fixed until the section has a date setting (PR B).
----------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}
{%- liquid
  assign title = section.settings.jsonld_title
  assign description = section.settings.jsonld_description
  assign encodes = blank

  if request.page_type == 'product' and product.type == 'Audiobooks'
    assign title = product.title | prepend: 'Transcript of ' | append: ' audiobook'
    assign description = "Video of the scrolling transcript of the [t] audiobook, showing the text as it's narrated." | replace: '[t]', product.title
    assign encodes = product.title
  elsif request.page_type == 'metaobject' and metaobject.system.type == 'audiobook'
    assign book_product = all_products[metaobject.system.handle]
    assign title = metaobject.name | prepend: 'Video of '
    assign description = book_product.description | strip_html | strip_newlines | strip | truncatewords: 50
    assign encodes = book_product.title
  endif

  assign title = title | default: shop.name
  assign description = description | default: title

  assign content_url = blank
  assign embed_url = blank
  assign thumbnail_url = blank
  assign youtube_id = section.settings.youtube_id

  if section.settings.video != blank
    assign video_source = section.settings.video.sources | where: 'format', 'mp4' | first
    assign content_url = video_source.url
    unless content_url contains 'https:'
      assign content_url = content_url | prepend: 'https:'
    endunless
    if section.settings.video.preview_image != blank
      assign thumbnail_url = section.settings.video.preview_image | image_url: width: 1280 | prepend: 'https:'
    endif
  elsif youtube_id != blank
    assign content_url = 'https://www.youtube.com/watch?v=' | append: youtube_id
    assign embed_url = 'https://www.youtube.com/embed/' | append: youtube_id
    assign thumbnail_url = 'https://img.youtube.com/vi/' | append: youtube_id | append: '/hqdefault.jpg'
  endif
-%}
{%- if content_url != blank and thumbnail_url != blank -%}
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": {{ title | json }},
    "description": {{ description | json }},
    "uploadDate": "2022-08-31T08:00:00+01:00",
    "contentUrl": {{ content_url | json }},
    {%- if embed_url != blank -%}
      "embedUrl": {{ embed_url | json }},
    {%- endif -%}
    "thumbnailUrl": {{ thumbnail_url | json }},
    {%- if encodes != blank -%}
      "encodesCreativeWork": {
        "@type": "Audiobook",
        "name": {{ encodes | json }}
      },
    {%- endif -%}
    "publisher": {%- render 'microdata-snippet-publisher' -%}
  }
{%- endif -%}
