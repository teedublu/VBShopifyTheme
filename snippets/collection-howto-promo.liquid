{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
COLLECTION "HOW VOXBLOCK WORKS" PROMO (main-collection block type "promotion_howto")
----------------------------------------------------------------------------------------------------------------------

A full-width row inside the product grid (age collection template): photo, eyebrow, heading, three numbered steps, a
short line and two buttons (starter packs, player only). The player price is read live (cheapest variant).
Hidden for signed-in customers who already bought a player.

Supported variables: block, section
{%- endcomment -%}

{%- capture owns_player -%}{%- render 'customer-owns-player' -%}{%- endcapture -%}
{%- if owns_player == blank -%}
  {%- liquid
    assign player = all_products[block.settings.player_handle]
    assign player_variant = player.variants | sort: 'price' | first
    assign player_price = player_variant.price | money
  -%}
  <div id="block-{{ section.id }}-{{ block.id }}" class="howto-promo" {{ block.shopify_attributes }}>
    {%- if block.settings.image != blank -%}
      <div class="howto-promo__media">
        {{- block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 100vw, 50vw', widths: '400,600,800,1000,1200', alt: block.settings.image_alt -}}
      </div>
    {%- endif -%}
    <div class="howto-promo__text">
      {%- if block.settings.eyebrow != blank -%}<p class="howto-promo__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
      <p class="howto-promo__title">{{ block.settings.heading | escape }}</p>
      <ol class="howto-promo__steps">
        {%- if block.settings.step_1 != blank -%}<li><span aria-hidden="true">1</span>{{ block.settings.step_1 | escape }}</li>{%- endif -%}
        {%- if block.settings.step_2 != blank -%}<li><span aria-hidden="true">2</span>{{ block.settings.step_2 | escape }}</li>{%- endif -%}
        {%- if block.settings.step_3 != blank -%}<li><span aria-hidden="true">3</span>{{ block.settings.step_3 | escape }}</li>{%- endif -%}
      </ol>
      {%- if block.settings.note != blank -%}<p class="howto-promo__note">{{ block.settings.note | escape }}</p>{%- endif -%}
      <div class="howto-promo__actions">
        {%- if block.settings.packs_url != blank -%}
          <a href="{{ block.settings.packs_url }}" class="series-button" data-age-track="howto_packs">{{ block.settings.packs_label | escape }}</a>
        {%- endif -%}
        {%- if player != blank and player_variant.price > 0 -%}
          <a href="{{ player_variant.url }}" class="series-button series-button--secondary" data-age-track="howto_player">{{ 'collection.pack_intro.player_link' | t: price: player_price }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}
