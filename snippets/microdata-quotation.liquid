{%- comment -%}JSON-LD Quotation: points at the character page's "#character" node and the audiobook page's "#audiobook" node{%- endcomment -%}
{
  "@context": "https://schema.org",
  "@type": "Quotation",
  "text": {{ quote.content | strip_html | strip_newlines | strip | json }},
  "spokenByCharacter": {
    "@id": {{ character.system.url | prepend: shop.url | append: '#character' | json }},
    "name": {{ character.name.value | default: character.name | append: '' | json }}
  },
  "isPartOf": {
    "@type": "Audiobook",
    "@id": {{ audiobook.system.url | prepend: shop.url | append: '#audiobook' | json }},
    "name": {{ audiobook.title.value | default: audiobook.title | append: '' | json }},
    "url": {{ audiobook.system.url | prepend: shop.url | json }}
  }
}
