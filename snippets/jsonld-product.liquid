{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
JSON-LD Product for a product page: the only Product generator in the theme (rendered by microdata-schema in the
layout on every product page, audiobooks included). Replaces the product branch of microdata-schema and
microdata-audiobook-as-product (13 Oct 2026).

* product: the product

- @id is the product URL + "#product"; other blocks (collection lists, audiobook pages) point to it.
- Brand is Voxblock for every product: Voxblock is the publisher of its audiobooks and makes the players (owner,
  13 Oct 2026). The Shopify vendor field is internal only and is never used in structured data.
- sku, gtin and category are left out when blank; a barcode goes out as gtin only when it is 8, 12, 13 or 14 digits.
- Each Offer carries shipping and returns (snippets microdata-shippingdetails, microdata-returnpolicy) except gift
  cards. No priceValidUntil: prices have no end date.
----------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}
{%- liquid
  assign product_url = shop.url | append: product.url
  assign current_variant = product.selected_or_first_available_variant
  assign is_gift_card = false
  if product.gift_card? or product.type contains 'Gift Card'
    assign is_gift_card = true
  endif
-%}
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ product_url | append: '#product' | json }},
  "url": {{ product_url | json }},
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | strip_newlines | strip | json }},
  {%- if product.type != blank -%}
    "category": {{ product.type | json }},
  {%- endif -%}
  {%- if product.type == 'Audiobooks' -%}
    "additionalType": "https://schema.org/Audiobook",
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": "Voxblock"
  },
  {%- if current_variant.sku != blank -%}
    "sku": {{ current_variant.sku | json }},
  {%- endif -%}
  {%- assign barcode_length = current_variant.barcode | size -%}
  {%- if barcode_length == 8 or barcode_length == 12 or barcode_length == 13 or barcode_length == 14 -%}
    "gtin": {{ current_variant.barcode | json }},
  {%- endif -%}
  {%- if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value > 0 -%}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
      "reviewCount": {{ product.metafields.reviews.rating_count.value | json }},
      "worstRating": {{ product.metafields.reviews.rating.value.scale_min | json }},
      "bestRating": {{ product.metafields.reviews.rating.value.scale_max | json }}
    },
  {%- endif -%}
  {%- if current_variant.weight > 0 -%}
    {%- comment -%}UN/CEFACT unit codes, as schema.org expects{%- endcomment -%}
    {%- case current_variant.weight_unit -%}
      {%- when 'kg' -%}{%- assign weight_code = 'KGM' -%}
      {%- when 'lb' -%}{%- assign weight_code = 'LBR' -%}
      {%- when 'oz' -%}{%- assign weight_code = 'ONZ' -%}
      {%- else -%}{%- assign weight_code = 'GRM' -%}
    {%- endcase -%}
    "weight": {
      "@type": "QuantitativeValue",
      "unitCode": {{ weight_code | json }},
      "value": {{ current_variant.weight_in_unit | json }}
    },
  {%- endif -%}
  {%- if product.images.size > 0 -%}
    "image": [
      {%- for image in product.images limit: 3 -%}
        {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
  {%- endif -%}
  "offers": [
    {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        {%- unless product.has_only_default_variant -%}
          "name": {{ variant.title | json }},
        {%- endunless -%}
        "url": {{ shop.url | append: variant.url | json }},
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "availability": "https://schema.org/{% if variant.available %}InStock{% elsif variant.incoming %}BackOrder{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        {%- if variant.sku != blank -%}
          "sku": {{ variant.sku | json }},
        {%- endif -%}
        {%- assign variant_barcode_length = variant.barcode | size -%}
        {%- if variant_barcode_length == 8 or variant_barcode_length == 12 or variant_barcode_length == 13 or variant_barcode_length == 14 -%}
          "gtin": {{ variant.barcode | json }},
        {%- endif -%}
        {%- unless is_gift_card -%}
          {%- render 'microdata-shippingdetails', product: product, price: variant.price -%},
          {%- render 'microdata-returnpolicy', product: product -%},
        {%- endunless -%}
        "seller": {%- render 'jsonld-org-ref' -%}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
