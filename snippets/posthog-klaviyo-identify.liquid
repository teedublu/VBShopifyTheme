<script>
  // A Klaviyo form sign-up only reaches Klaviyo, so PostHog keeps the visitor anonymous and can't join this
  // session to a later purchase made from the welcome email in another browser. On submit, identify the
  // visitor in PostHog by the email they entered. Klaviyo dispatches 'klaviyoForms' on window for every form;
  // multi-step forms send the email with 'stepSubmit', single-step forms with 'submit'.
  var identifiedForms = {};

  window.addEventListener('klaviyoForms', function (event) {
    var detail = event.detail || {};
    if (detail.type !== 'submit' && detail.type !== 'stepSubmit') return;

    var email = detail.metaData && detail.metaData.$email;
    if (!email || !window.posthog) return;
    email = String(email).trim().toLowerCase();

    // A multi-step form sends the email on every later step too; act once per form
    if (identifiedForms[detail.formId]) return;
    identifiedForms[detail.formId] = true;

    posthog.capture('klaviyo_form_submitted', { form_id: detail.formId, step: detail.type });

    // Already identified (e.g. a signed-in customer): don't switch this browser to someone else's person
    if (posthog.get_property('$user_state') === 'identified') return;

    posthog.identify(email, { email: email });
  });
</script>
