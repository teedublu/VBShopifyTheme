{%- comment -%}JSON-LD Person for an author page; @id is the page + "#person" (audiobook pages point here){%- endcomment -%}
{%- liquid
  assign author_image = author.photos.value | first
  assign author_description = author.bio | metafield_tag | strip_html | strip_newlines | strip
  assign page_url = author.system.url | prepend: shop.url
-%}
{
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": {{ page_url | append: '#person' | json }},
  "url": {{ page_url | json }},
  "name": {{ author.name.value | default: author.name | append: '' | json }},
  "jobTitle": "Author"
  {%- if author_image != blank -%},
  "image": {{ author_image | image_url: width: 600 | prepend: 'https:' | json }}
  {%- endif -%}
  {%- if author_description != blank -%},
  "description": {{ author_description | json }}
  {%- endif -%}
  {%- if author.same_as.value != blank -%},
  "sameAs": [
    {%- for same in author.same_as.value -%}
      {{ same | append: '' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- endif -%}
}
