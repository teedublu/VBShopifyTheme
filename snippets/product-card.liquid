{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
MODIFIED PRODUCT CARD COMPONENT
----------------------------------------------------------------------------------------------------------------------
To allow for a product card specifc to each product type code from original copied to :
sections/product-card-default.liquid

Each product type has own product card if needed or product-card-default

* override_price / override_compare_at: display-only sale price override, see snippets/price-list.liquid

{%- endcomment -%}

{%- comment -%}The starter pack collection redesign opts in to the pack card through the main-collection "Product card style" setting{%- endcomment -%}
{%- if section.settings.card_style == 'pack' -%}
  {%- render 'product-card-pack', product: product, card_index: card_index, show_titles: section.settings.card_show_titles, group_collapse: group_collapse -%}
{%- else -%}
{%- case product.type -%}
  {%- when 'Audiobooks' -%}
    {%- render 'product-card-audiobooks', product: product, stacked: true, show_badges: true, section_settings: section.settings, override_price: override_price, override_compare_at: override_compare_at -%}
  {%- when 'Audiobooks Bundle' -%}
    {%- render 'product-card-audiobooks', product: product, stacked: true, show_badges: true, section_settings: section.settings, override_price: override_price, override_compare_at: override_compare_at -%}
  {%- when 'Starter Pack', 'Custom Starter Pack' -%}
    {%- render 'product-card-starterpack', product: product, stacked: true, show_badges: true, section_settings: section.settings -%}
  {%- else -%}
    {%- render 'product-card-default', product: product, stacked: true, show_badges: true, section_settings: section.settings, override_price: override_price, override_compare_at: override_compare_at -%}
{%- endcase -%}
{%- endif -%}