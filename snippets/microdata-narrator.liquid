{%- comment -%}JSON-LD Person for a narrator page; @id is the page + "#person" (audiobook pages point here){%- endcomment -%}
{%- liquid
  assign narrator_image = narrator.photos.value | first
  assign narrator_description = narrator.bio | metafield_tag | strip_html | strip_newlines | strip
  assign page_url = narrator.system.url | prepend: shop.url
-%}
{
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": {{ page_url | append: '#person' | json }},
  "url": {{ page_url | json }},
  "name": {{ narrator.name.value | default: narrator.name | append: '' | json }},
  "jobTitle": "Narrator"
  {%- if narrator_image != blank -%},
  "image": {{ narrator_image | image_url: width: 600 | prepend: 'https:' | json }}
  {%- endif -%}
  {%- if narrator_description != blank -%},
  "description": {{ narrator_description | json }}
  {%- endif -%}
  {%- if narrator.same_as.value != blank -%},
  "sameAs": [
    {%- for same in narrator.same_as.value -%}
      {{ same | append: '' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- endif -%}
}
