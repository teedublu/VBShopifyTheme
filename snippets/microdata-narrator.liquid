{%- assign narrator_image = narrator.photos.value | first -%}
{
  "@context": "https://schema.org/",
  "@type": "Person",
  "jobTitle": "Narrator",
  "name": {{ narrator.name | json }},
  {%- if narrator_image != blank -%}
    "image": {{ narrator_image | image_url: width: 600 | prepend: 'https:' | json }},
  {%- endif -%}
  "url": {{ narrator.system.url | prepend: shop.url | json }}
  {%- if narrator.same_as.value -%}
    ,"sameAs": [
      {%- for same in narrator.same_as.value -%}
        {{ same | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  {%- endif -%}
}
