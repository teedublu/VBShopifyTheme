{%- comment -%}
"What's in the box" for starter-pack bundle pages (section `pack-contents`, below the main product area so it adds
content without getting between the shopper and Add to basket).
Shows the player kit (three product pickers on the section, each with a caption) as picture tiles, then every book in
the pack's `bundles.products` metafield with its cover, narrator, length, ages and a sample button.

- Player and bumper tiles follow the colour swatch: one image per variant of the picked product, the one whose title
  matches the pack's selected colour is shown; voxblock.js swaps them on variant:change. A product with no variant of
  that colour keeps its first image.
- Sample buttons are ordinary .bookpreview buttons, so the shared player in voxblock.js plays them and sends
  `sample_played` { title } like every other sample button. voxblock.js also sets --sample-progress on the playing
  button, which fills the bar inside it.
- Book length reads book.duration as hours.minutes ("3.15" = 3 h 15 m).

Accepts: product (the pack), opts (the section's settings)
{%- endcomment -%}

{%- assign pack = product -%}
{%- assign pack_colour = pack.selected_or_first_available_variant.option1 -%}
{%- assign books = pack.metafields.bundles.products.value -%}

{%- assign total_minutes = 0 -%}
{%- for book in books -%}
  {%- assign d = book.metafields.book.duration.value | append: '' | split: '.' -%}
  {%- assign h = d[0] | plus: 0 -%}
  {%- assign m = d[1] | plus: 0 -%}
  {%- assign total_minutes = h | times: 60 | plus: m | plus: total_minutes -%}
{%- endfor -%}

<div class="pack-contents" data-pack-contents>
  <div class="pack-contents__head">
    {%- if opts.eyebrow != blank -%}<p class="pack-contents__eyebrow">{{ opts.eyebrow }}</p>{%- endif -%}
    {%- if opts.heading != blank -%}<h2 class="pack-contents__title">{{ opts.heading }}</h2>{%- endif -%}
    {%- if opts.intro != blank -%}<p class="pack-contents__intro">{{ opts.intro }}</p>{%- endif -%}
  </div>

  <div class="pack-contents__body">
  {%- capture kit -%}
    {%- for i in (1..3) -%}
      {%- capture pkey -%}item_{{ i }}{%- endcapture -%}
      {%- capture ckey -%}item_{{ i }}_caption{%- endcapture -%}
      {%- capture lkey -%}item_{{ i }}_label{%- endcapture -%}
      {%- assign item = opts[pkey] -%}
      {%- if item != blank -%}
        <li class="pack-contents__kit-item">
          <div class="pack-contents__kit-media">
            {%- assign shown = false -%}
            {%- for v in item.variants -%}
              {%- if v.featured_image != blank and v.title == pack_colour -%}{%- assign shown = v.id -%}{%- endif -%}
            {%- endfor -%}
            {%- assign drew_variant = false -%}
            {%- for v in item.variants -%}
              {%- if v.featured_image != blank and item.variants.size > 1 -%}
                {%- assign drew_variant = true -%}
                <img src="{{ v.featured_image | image_url: width: 400 }}" alt="{{ item.title | escape }}, {{ v.title | escape }}" width="400" height="400" loading="lazy" data-pack-colour="{{ v.title | escape }}" {% if shown == false %}{% unless forloop.first %}hidden{% endunless %}{% elsif v.id != shown %}hidden{% endif %}>
              {%- endif -%}
            {%- endfor -%}
            {%- unless drew_variant -%}
              {{- item.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: item.title -}}
            {%- endunless -%}
          </div>
          <p class="pack-contents__kit-name">{{ opts[lkey] | default: item.title }}</p>
          {%- if opts[ckey] != blank -%}<p class="pack-contents__kit-caption">{{ opts[ckey] }}</p>{%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if kit != blank -%}
    <div class="pack-contents__group">
      <div class="pack-contents__group-head">
        <h3 class="pack-contents__group-title">{{ opts.kit_heading }}</h3>
      </div>
      <ul class="pack-contents__kit" role="list">{{ kit }}</ul>
    </div>
  {%- endif -%}

  {%- if books.size > 0 -%}
    <div class="pack-contents__group">
      <div class="pack-contents__group-head">
        <h3 class="pack-contents__group-title">{{ opts.books_heading | replace: '[count]', books.size }}</h3>
        {%- if total_minutes > 0 -%}
          {%- assign th = total_minutes | divided_by: 60 -%}
          {%- assign tm = total_minutes | modulo: 60 -%}
          <span class="pack-contents__group-meta">{{ th }} h {{ tm }} m of stories</span>
        {%- endif -%}
      </div>
      <ul class="pack-contents__books" role="list">
        {%- for book in books -%}
          {%- assign narrator = book.metafields.book.narrators.value | first -%}
          {%- assign d = book.metafields.book.duration.value | append: '' | split: '.' -%}
          {%- assign age_lower = book.metafields.book.age_lower.value -%}
          {%- assign age_upper = book.metafields.book.age_upper.value -%}
          <li class="pack-contents__book">
            <a href="{{ book.url }}" class="pack-contents__cover" tabindex="-1" aria-hidden="true">
              {{- book.featured_media | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 1000px) 120px, 72px', widths: '120,240' -}}
            </a>
            <div class="pack-contents__book-body">
              <a href="{{ book.url }}" class="pack-contents__book-title">{{ book.title }}</a>
              {%- if narrator != blank -%}
                <p class="pack-contents__book-narrator">Read by <span>{{ narrator.name }}</span></p>
              {%- endif -%}
              <p class="pack-contents__book-meta">
                {%- if d[0] != blank -%}{{ d[0] | plus: 0 }} h{% if d[1] != blank %} {{ d[1] | plus: 0 }} m{% endif %}{%- endif -%}
                {%- if book.metafields.book.abridged.value == false %} · Unabridged{% endif -%}
                {%- if age_lower != blank and age_upper != blank %} · Ages {{ age_lower }}–{{ age_upper }}{% endif -%}
              </p>
              {%- if book.metafields.book.preview != blank -%}
                <button type="button" class="bookpreview pack-contents__play" aria-controls="product-sample" aria-expanded="false" data-mp3="{{ book.metafields.book.preview | file_url }}" data-title="{{ book.title | escape }}">
                  <span class="pack-contents__play-icon" aria-hidden="true">
                    <svg class="pack-contents__icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.9l10.2-6.5a1 1 0 0 0 0-1.7L9.5 4.6A1 1 0 0 0 8 5.5z"/></svg>
                    <svg class="pack-contents__icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
                  </span>
                  <span class="pack-contents__play-body">
                    <span class="pack-contents__play-label">
                      <span class="pack-contents__play-idle">Listen to a sample<span class="sr-only"> of {{ book.title }}</span></span>
                      <span class="pack-contents__play-on">Playing sample<span class="sr-only"> of {{ book.title }}, press to pause</span></span>
                    </span>
                    <span class="pack-contents__play-bar" aria-hidden="true"><span></span></span>
                  </span>
                </button>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  </div>

  {%- if opts.show_value -%}
    {%- assign v = pack.selected_or_first_available_variant -%}
    {%- if v.compare_at_price > v.price -%}
      <p class="pack-contents__value">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9"/></svg>
        <span><strong>{{ v.price | money }} together</strong> · {{ v.compare_at_price | money }} bought separately.{% if opts.value_note != blank %} {{ opts.value_note }}{% endif %}</span>
      </p>
    {%- endif -%}
  {%- endif -%}
</div>
