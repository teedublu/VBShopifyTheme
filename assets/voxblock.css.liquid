/* Saved books page: the list bar (sections/saved-books.liquid). One row for where the list is kept, one for the wish
   list prompt with the "Send my wish list" button */
.saved-books__bar { border-radius: var(--rounded-sm); background: rgb(var(--text-color) / .05); }
.saved-books__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--spacing-3) var(--spacing-6); padding: var(--spacing-4) var(--spacing-5); }
.saved-books__row[hidden] { display: none; }
.saved-books__row + .saved-books__row { border-top: 1px solid rgb(var(--text-color) / .1); }
.saved-books__row--quiet { padding-block: var(--spacing-3); font-size: var(--text-sm); }
.saved-books__row-text { flex: 1 1 16rem; margin: 0; }
.saved-books__send { position: relative; flex: none; }

/* Ways to send the link, on browsers without a share sheet */
.saved-books__menu { position: absolute; z-index: 10; inset-inline: 0; top: calc(100% + var(--spacing-2)); min-width: 11rem; display: grid; padding: var(--spacing-1); border-radius: var(--rounded-sm); background: rgb(var(--background)); box-shadow: 0 6px 20px rgb(0 0 0 / .18), 0 0 0 1px rgb(var(--text-color) / .1); }
.saved-books__menu[hidden] { display: none; }
.saved-books__menu > * { display: flex; align-items: center; gap: var(--spacing-3); width: 100%; padding: var(--spacing-3) var(--spacing-4); border-radius: var(--rounded-sm); text-align: start; }
.saved-books__menu > :is(:hover, :focus-visible) { background: rgb(var(--text-color) / .06); }

@media screen and (max-width: 699px) {
  .saved-books__send, .saved-books__send .button, .saved-books__row > .button { width: 100%; }
}

/* Saved books page: the view of a list someone shared */
.saved-books__shared-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-4) var(--spacing-6); }
.is-shared-saved-books [data-saved-books-own] { display: none; }


/* ---------------------------- */
/* PRODUCT CARD BADGES: stacked, left aligned */
/* ---------------------------- */
.product-card__badge-list { justify-items: start; }


/* ---------------------------- */
/* BUNDLE PRICE (snippets/bundle-price.liquid) */
/* ---------------------------- */
/* Packs / audiobook bundles: price + "saves" chip, with a "Bought separately" line underneath.
   The line is absolutely positioned so the card is exactly as tall as one showing a plain price. */
.badge--bundle { display: inline-flex; align-items: center; gap: 0.4rem; --badge-background: var(--badge-bundle-rgb); --badge-color: var(--badge-bundle-text); font-weight: 700; }
.badge--bundle svg { flex: none; }

.bundle-price { position: relative; display: inline-flex; align-items: center; gap: 0.5rem; min-width: 0; transform: translateY(-0.5rem); } /* lift so price + caption are centred on the basket button */
.bundle-price__now { font-weight: 700; color: rgb(var(--button-background-primary)); white-space: nowrap; }
.bundle-price__chip { background: rgb(var(--badge-bundle-rgb)); color: rgb(var(--badge-bundle-text)); font-size: 0.75rem; font-weight: 600; line-height: 1.2; padding: 0.15rem 0.5rem; border-radius: 3px; white-space: nowrap; }
.bundle-price__was { position: absolute; top: 100%; left: 0; margin-top: 0.1rem; font-size: 0.75rem; line-height: 1.2; font-weight: 500; white-space: nowrap; color: rgb(var(--text-color)); }
.bundle-price__was-short { display: none; }

/* Responsive to the width of the price row (the card), not the viewport */
.buy-price:has(.bundle-price) { container-type: inline-size; }
/* widths measured with Poppins: price + chip need ~230px of row; the long caption needs ~225px */
@container (max-width: 15.5rem) { .bundle-price__chip { display: none; } }
@container (max-width: 14.5rem) { .bundle-price__was-long { display: none; } .bundle-price__was-short { display: inline; } }

/* Product page: normal flow, the "bought separately" line sits under the price (no card height to protect) */
.bundle-price--page { display: inline-flex; flex-wrap: wrap; align-items: center; transform: none; }
.bundle-price--page .bundle-price__was { position: static; flex-basis: 100%; margin-top: 0; }
.bundle-price--page [hidden] { display: none !important; }

/* ---------------------------- */
/* PRODUCT PAGE PRICE: one size on every product page */
/* ---------------------------- */
/* Plain prices (sale-price) and pack prices (bundle-price) used to render at different sizes
   (36px vs 20px on phones). Both now use the theme's Large heading size, the same size as the product title.
   Product cards are unaffected (they are not inside .product-info__price). */
.product-info__price :is(sale-price.text-lg, .bundle-price__now) { font-size: var(--text-h2); line-height: 1.1; font-weight: 700; }
.product-info__price compare-at-price { font-size: var(--text-base); }
.product-info__price .bundle-price--page { row-gap: 0.25rem; }

/* Anchor target for the "Choose your pack" hero button (collection.starter-pack-collection): clear the sticky header */
#product-grid { scroll-margin-top: calc(var(--sticky-area-height, 0px) + 1rem); }

/* ---------------------------- */
/* STARTER PACK COLLECTION REDESIGN */
/* Intro band + explainer, sticky age bar, pack cards. Layout and copy: design canvas "Starter Pack collection redesign". */
/* Colours: var(--brand-heading) teal (headings, buttons), var(--brand-text) text, var(--accent-strong-dark) eyebrow/age, var(--accent-strong) prices (readable on white, the orange button colour is not) */
/* ---------------------------- */

/* INTRO BAND */
.pack-intro { background: var(--pack-intro-bg, #fff7f0); }
.pack-intro__inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "text image" "explainer explainer"; column-gap: 12px; align-items: start; padding-block: 12px 0; }
.pack-intro__text { grid-area: text; display: flex; flex-direction: column; gap: 6px; min-width: 0; padding-bottom: 8px; }
.pack-intro__eyebrow { margin: 0 0 2px; } /* 6px column gap + 2px = the standard 8px under an eyebrow */
.pack-intro__title { margin: 0; }
.pack-intro__lede { margin: 0; font-size: 13px; line-height: 19px; }
.pack-intro__desktop-only { display: none; }
.pack-intro__image { grid-area: image; }
.pack-intro__image img { display: block; width: 96px; height: 120px; object-fit: cover; object-position: 30% 50%; border-radius: 12px; }
/* mobile: the explainer sits on white under the band (full-bleed white via a clipped shadow) */
.pack-intro__explainer { grid-area: explainer; display: flex; flex-direction: column; gap: 8px; padding: 12px 0 4px; background: #fff; box-shadow: 0 0 0 100vmax #fff; clip-path: inset(0 -100vmax); }
.pack-intro__tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.pack-intro__tile { display: flex; align-items: center; gap: 6px; border: 1px solid var(--card-border); border-radius: 12px; padding: 5px 6px 5px 5px; background: #fff; }
.pack-intro__tile-media { flex: none; width: 48px; height: 48px; border-radius: 8px; background: var(--card-media-bg); overflow: hidden; }
.pack-intro__tile-media img { display: block; width: 100%; height: 100%; object-fit: contain; }
.pack-intro__tile-text { min-width: 0; }
.pack-intro__tile p { margin: 0; }
.pack-intro__tile-title { font-size: 12px; font-weight: 600; color: var(--brand-heading); }
.pack-intro__tile-contents { font-size: 11px; line-height: 15px; }
.pack-intro__tile-price { font-size: 13px; font-weight: 700; color: var(--accent-strong); }
.pack-intro__note { margin: 0; font-size: 11px; line-height: 16px; }
.pack-intro__player-link { color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

@media screen and (min-width: 1000px) {
  .pack-intro__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 380px) 220px; grid-template-areas: "text explainer image"; column-gap: 32px; align-items: center; padding-block: 28px; }
  .pack-intro__text { gap: 10px; padding-bottom: 0; }
  .pack-intro__eyebrow { margin-bottom: -2px; } /* 10px gap - 2px = 8px under the eyebrow */

  .pack-intro__lede { font-size: 15px; line-height: 23px; max-width: 560px; }
  .pack-intro__desktop-only { display: inline; }
  .pack-intro__image img { width: 220px; height: 180px; border-radius: 14px; object-position: 50% 55%; }
  .pack-intro__explainer { padding: 0; background: transparent; box-shadow: none; clip-path: none; gap: 10px; }
  .pack-intro__tiles { gap: 10px; }
  .pack-intro__tile { border-color: var(--card-border); border-radius: 14px; padding: 10px; gap: 10px; flex-direction: column; align-items: stretch; }
  .pack-intro__tile-media { width: 100%; height: 96px; border-radius: 10px; }
  .pack-intro__tile-title { font-size: 14px; }
  .pack-intro__tile-contents { font-size: 13px; line-height: normal; }
  .pack-intro__tile-price { font-size: 16px; }
  .pack-intro__note { font-size: 12px; line-height: 17px; }
}

/* The theme's collection grid adds a 32px top margin and a 32px row gap (48px top margin on desktop): too much air above the first row of prices on a phone */
.collection.collection--pack { gap: 0; margin-block-start: 0; }

/* STICKY AGE / SORT BAR. top follows the real sticky header (+ announcement bar when it is sticky) through --sticky-area-height, which the header and announcement bar sections measure at runtime */
.pack-bar { position: sticky; top: var(--sticky-area-height, 0px); z-index: 5; background: #fff; border-bottom: 1px solid var(--card-border); margin-bottom: 4px; color: var(--brand-text); }
.pack-bar__chips { display: flex; gap: 6px; margin: 0; padding: 6px 0 2px; overflow-x: auto; scrollbar-width: none; }
.pack-bar__chips::-webkit-scrollbar { display: none; }
.pack-chip { flex: 0 0 auto; min-height: 44px; min-width: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--card-border); background: #fff; color: var(--brand-text); font: inherit; font-size: 13px; font-weight: 500; line-height: 1; cursor: pointer; }
.pack-chip[aria-pressed="true"] { background: var(--brand-heading); border-color: var(--brand-heading); color: #fff; font-weight: 600; }
.pack-chip:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
.pack-bar__meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 12px; }
.pack-bar__count { margin: 0; }
.pack-bar__help { display: none; font-weight: 600; color: var(--brand-heading); }
.top-bar__help { margin-inline-start: auto; font-size: 13px; font-weight: 600; color: var(--brand-heading); }
.pack-bar__sort { margin-inline-start: auto; display: inline-flex; align-items: center; gap: 4px; }
.pack-bar__sort-button { min-height: 44px; }

@media screen and (min-width: 1000px) {
  .pack-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 10px 0; margin-bottom: 20px; }
  .pack-bar__chips { flex-wrap: wrap; overflow: visible; padding: 0; gap: 8px; }
  .pack-bar__meta { gap: 16px; font-size: 13px; margin-inline-start: auto; }
  .pack-bar__help { display: inline; }
}

/* PACK CARD: flex column, price + swatches pinned to the bottom so prices line up in every row */
.pack-card { display: flex; flex-direction: column; gap: 5px; height: 100%; position: relative; color: var(--brand-text); border: 1px solid var(--card-border); border-radius: 12px; overflow: hidden; background: #fff; }
.pack-card > :not(.pack-card__media) { padding-inline: 10px; }
.pack-card__buy { padding-bottom: 10px; }
.pack-card__media { position: relative; aspect-ratio: 1 / 1; border-radius: 0; background: var(--card-media-bg); overflow: hidden; }
.pack-card .pack-card__image { display: block; width: 100%; height: 100%; object-fit: contain; border-radius: 0; } /* also carries the theme's product-card__image classes so the swatch script can swap the image */
.pack-card__badge { position: absolute; top: 8px; padding: 2px 7px; border-radius: 999px; color: #fff; font-size: 10px; font-weight: 600; line-height: 1.4; }
.pack-card__badge--save { left: 8px; background: var(--accent-strong); color: rgb(var(--accent-strong-text)); display: inline-flex; align-items: center; gap: 4px; }
.pack-card__badge--save svg { flex: none; width: 12px; height: 12px; }
.pack-card__badge--best { right: 8px; background: var(--brand-heading); }
.pack-card__title { margin: 6px 0 0; font-size: 13px; line-height: 17px; font-weight: 600; color: var(--brand-heading); letter-spacing: normal; }
.pack-card__link { color: inherit; text-decoration: none; }
.pack-card__link::after { content: ""; position: absolute; inset: 0; z-index: 1; } /* whole card is one link */
.pack-card__link:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
.pack-card__contents, .pack-card__age { margin: 0; font-size: 11px; line-height: 15px; }
.pack-card__age { font-weight: 600; color: var(--accent-strong-dark); }
.pack-card__buy { margin-top: auto; padding-top: 4px; display: flex; flex-direction: column; gap: 5px; }
.pack-card__prices { margin: 0; display: flex; flex-wrap: wrap; gap: 0 6px; align-items: baseline; }
.pack-card__price { font-size: 18px; font-weight: 700; color: var(--accent-strong); }
.pack-card__from { font-size: 11px; color: var(--brand-text); }
.pack-card__was { font-size: 11px; color: rgb(var(--brand-text-rgb) / .75); }
.pack-card__swatches { position: relative; z-index: 2; margin: 0; padding: 0; border: 0; min-width: 0; } /* above the stretched link so swatches stay clickable */

@media screen and (min-width: 700px) {
  .pack-card { gap: 6px; }
  .pack-card { border-radius: 14px; }
  .pack-card > :not(.pack-card__media) { padding-inline: 12px; }
  .pack-card__buy { padding-bottom: 12px; }
  .pack-card__badge { top: 10px; font-size: 11px; padding: 3px 9px; }
  .pack-card__badge--save { left: 10px; gap: 5px; }
  .pack-card__badge--save svg { width: 14px; height: 14px; }
  .pack-card__badge--best { right: 10px; }
  .pack-card__title { font-size: 15px; line-height: 20px; }
  .pack-card__contents { font-size: 13px; line-height: 18px; }
  .pack-card__age { font-size: 12px; }
  .pack-card__prices { gap: 0 8px; }
  .pack-card__price { font-size: 22px; }
  .pack-card__was { font-size: 13px; }
}

/* "Help me choose" card after the grid, mobile only (desktop has the link in the bar) */
.pack-help { margin-top: 24px; padding: 14px; border-radius: 12px; background: #fff7f0; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; color: var(--brand-text); }
.pack-help__title { margin: 0; font-size: 14px; font-weight: 600; color: var(--brand-heading); }
.pack-help__text { margin: 0 0 4px; font-size: 12px; line-height: 17px; }
@media screen and (min-width: 1000px) { .pack-help { display: none; } }


/* ----------------------------------------------------------------------------------------------------------------
   CARD BADGES: one pill style for every product card (matches the pack card Save % / Bestseller badges)
   ---------------------------------------------------------------------------------------------------------------- */
.product-card { --product-card-badge-spacing: 9px; }
.product-card__badge-list .badge { border-radius: 999px; font-weight: 600; font-size: 10px; line-height: 1.4; padding: 2px 7px; gap: 4px; }
.product-card__badge-list .badge svg { width: 12px; height: 12px; flex: none; }
@media screen and (min-width: 700px) {
  .product-card { --product-card-badge-spacing: 11px; }
  .product-card__badge-list .badge { font-size: 11px; padding: 3px 9px; gap: 5px; }
  .product-card__badge-list .badge svg { width: 14px; height: 14px; }
}

/* ----------------------------------------------------------------------------------------------------------------
   CARD TITLES: same type as the pack cards, on every product card
   ---------------------------------------------------------------------------------------------------------------- */
.product-card__title a { font-size: 13px; line-height: 17px; font-weight: 600; color: var(--brand-heading); }
@media screen and (min-width: 700px) { .product-card__title a { font-size: 15px; line-height: 20px; } }

/* ----------------------------------------------------------------------------------------------------------------
   HEADINGS: one hierarchy for the whole site, set in Theme settings, not per section
   Size: Theme settings > Typography > Heading size (--text-h0..h6 in css-variables). H1 > H2 > H3 at every width.
   A bare heading tag takes the size of its level. A size class (.h0-.h6) styles text to look like a level whatever
   its tag, so a marketing line can look like an H1 while staying an H2 or a <p> for search engines.
   Font and weight: Theme settings > Typography > Heading font. Colour: Theme settings > Heading teal (--heading-color).
   Sections with light text (dark bands) switch --heading-color to their text colour (section-properties, surface).
   Headings laid over images keep the colour of their content. Sections should not set their own heading size or colour.
   ---------------------------------------------------------------------------------------------------------------- */
:where(#main) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font-family); font-weight: var(--heading-font-weight); font-style: var(--heading-font-style); letter-spacing: var(--heading-letter-spacing); text-transform: var(--heading-text-transform); }
:where(#main) h1 { font-size: var(--text-h1); line-height: 1.1; }
:where(#main) h2 { font-size: var(--text-h2); line-height: 1.1; }
:where(#main) h3 { font-size: var(--text-h3); line-height: 1.2; }
:where(#main) h4 { font-size: var(--text-h4); line-height: 1.3; }
:where(#main) :is(h5, h6) { font-size: var(--text-h5); line-height: 1.4; }
:where(#main) :where(h1, h2, h3, h4, .h0, .h1, .h2, .h3, .h4) { color: rgb(var(--heading-color)); }
:where(.content-over-media, .collection-card__content-wrapper) :where(h1, h2, h3, h4, .h0, .h1, .h2, .h3, .h4) { color: inherit; }

/* EYEBROWS (subheadings): the small line above a heading, one style everywhere. Every eyebrow carries the theme's
   .subheading class (section subheading settings, and each section's own __eyebrow element). Colour: --eyebrow-color,
   dark brand orange on light sections, the text colour on dark sections, inherited over images. */
.subheading { font-family: var(--text-font-family); font-size: 0.75rem; line-height: 1.25rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--eyebrow-color); }
/* the eyebrow sits the same 8px above whatever follows it, in rich text and in the bespoke sections alike */
.prose .subheading + *, .subheading + :is(h1, h2, h3, h4, h5, h6, .h0, .h1, .h2, .h3, .h4, .h5, .h6) { margin-block-start: var(--spacing-2); }
.product-info__eyebrow.subheading { margin-block-end: var(--spacing-2); }
.pack-intro__eyebrow + .pack-intro__title { margin-block-start: 0; } /* the pack intro spaces its lines with a flex gap instead */
@media screen and (min-width: 700px) { .subheading { font-size: 0.8125rem; line-height: 1.25rem; } }
:where(.content-over-media, .collection-card__content-wrapper) .subheading { color: inherit; }

/* ----------------------------------------------------------------------------------------------------------------
   ONE CARD LAYOUT for every product card (audiobook, starter pack, default, pack card)
   image panel / [books: preview + heart] / title (max 2 lines) / [swatches] / price left + add-to-cart right, pinned bottom
   ---------------------------------------------------------------------------------------------------------------- */
.product-card { display: flex; flex-direction: column; padding: 0; border: 1px solid var(--card-border); border-radius: 12px; overflow: hidden; background: #fff; row-gap: 0; }
.product-card__figure { flex: none; background: var(--card-media-bg); }
.product-card .product-card__image { border-radius: 0; }
.product-card:has(.sample-wishlist) .product-card__figure > a { padding: 10px 14px; } /* book covers sit inset, not hard against the card edge */
.product-card__details { display: flex; flex-direction: column; flex: 1; gap: 6px; padding: 8px 10px 10px; }
.product-card__details > :nth-child(2) { white-space: normal; overflow: visible; text-overflow: clip; width: auto; }
.product-card__info { padding: 0; order: 2; }
.product-card__row.sample-wishlist { order: 1; width: 100%; justify-content: space-between; }
.product-card__details > .product-card__sample, .product-card__details > .product-card__row:not(.buy-price):not(.sample-wishlist) { order: 3; }
.product-card__row.buy-price { order: 9; margin-top: auto; width: 100%; flex-direction: row-reverse; justify-content: space-between; gap: 8px; }
.product-card__row.buy-price .icon-circle { margin-right: 0; }
/* titles: two lines at most, always two lines tall so the rows beneath line up */
.product-card__title { display: block; min-height: 34px; }
.product-card__title a, .pack-card__title a { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; }
.pack-card__title { min-height: 34px; }
@media screen and (min-width: 700px) {
  .product-card { border-radius: 14px; }
  .product-card__details { padding: 10px 12px 12px; }
  .product-card__title, .pack-card__title { min-height: 40px; }
}


/* Pack card quick add: round button beside the price (same add-to-cart as the other cards), above the whole-card link */
.pack-card__buy-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.pack-card__add { position: relative; z-index: 2; margin: 0; flex: none; }
.pack-card__add-button { display: grid; place-items: center; width: 38px; height: 38px; min-width: 38px; padding: 0; border-radius: 50%; border: 0; background: rgb(var(--button-background-primary)); color: rgb(var(--button-text-primary)); cursor: pointer; } /* identical to .icon-circle on the other cards */
.pack-card__add-button:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }

/* Sold-out cards: greyed-out add to cart (same size as the live button) plus a "More coming soon" pill just above the price row */
.icon-circle--disabled, .pack-card__add-button--disabled { background: rgb(var(--text-color) / .12); color: rgb(var(--text-color) / .38); cursor: not-allowed; }
.icon-circle--disabled { display: block; border: 0; font: inherit; }
.product-card__row.buy-price > .icon-circle--disabled { flex: none; }
.coming-soon-row { order: 8; margin-top: auto; }
.coming-soon-row + .product-card__row.buy-price { margin-top: 0; }
.pack-card__buy > .coming-soon-row { order: 0; margin-top: 0; } /* pack card orders by DOM position: pill sits right above the price row, price row stays pinned to the bottom */

/* Back in stock alert: the pill becomes a button (above the whole-card link on pack cards), and a sheet takes the email: bottom sheet on phones, centred card on desktop */
.coming-soon-pill.coming-soon-pill--action { gap: 5px; margin: 0; padding: 2px 9px; border: 1.5px solid var(--brand-heading); background: transparent; color: var(--brand-heading); font-family: inherit; text-align: start; cursor: pointer; position: relative; z-index: 2; -webkit-appearance: none; appearance: none; transition: background-color .15s, color .15s, border-color .15s, opacity .15s; } /* outlined brand teal: clearly tappable, not the grey of a disabled control */
.coming-soon-pill--action svg { width: 12px; height: 12px; flex: none; }
.coming-soon-pill--action:hover { background: rgb(var(--brand-heading-rgb) / .1); }
.coming-soon-pill--action:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
.coming-soon-pill--action.is-set { border-color: transparent; background: rgb(var(--brand-heading-rgb) / .14); cursor: default; }
.coming-soon-pill--action.is-busy { opacity: .6; cursor: progress; }
.coming-soon-pill__tick { display: none; }
.coming-soon-pill.is-set .coming-soon-pill__bell { display: none; }
.coming-soon-pill.is-set .coming-soon-pill__tick { display: block; }
.coming-soon-pill.coming-soon-pill--pdp { width: 100%; max-width: none; justify-content: center; padding: 11px 16px; font-size: 14px; font-weight: 700; border: 2px solid var(--brand-heading); border-radius: var(--rounded-button, 999px); background: transparent; color: var(--brand-heading); } /* outlined so it reads as tappable under the greyed sold-out button */
.coming-soon-pill.coming-soon-pill--pdp:hover { background: rgb(var(--brand-heading-rgb) / .08); }
.coming-soon-pill.coming-soon-pill--pdp.is-set { border-color: var(--brand-heading); background: rgb(var(--brand-heading-rgb) / .12); color: var(--brand-heading); }
.coming-soon-pill.coming-soon-pill--pdp svg { width: 16px; height: 16px; }

.stock-alert { --alert-text: var(--text-primary, 42 85 90); position: fixed; border: 0; padding: 20px; width: min(440px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow: auto; border-radius: 18px; background: #fff; color: rgb(var(--alert-text)); box-shadow: 0 24px 64px rgb(0 0 0 / .28); }
.stock-alert::backdrop { background: rgb(0 0 0 / .5); }
.stock-alert [hidden] { display: none !important; }
.stock-alert__close-form { position: absolute; top: 10px; inset-inline-end: 10px; margin: 0; }
.stock-alert__close { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%; background: rgb(var(--alert-text) / .08); color: inherit; cursor: pointer; }
.stock-alert__product { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; padding-inline-end: 36px; }
.stock-alert__image-slot { flex: none; line-height: 0; }
.stock-alert__image-slot:empty { display: none; }
.stock-alert__image { flex: none; width: 56px; height: 56px; border-radius: 10px; background: rgb(var(--alert-text) / .05); object-fit: contain; }
.stock-alert__lead { margin: 0; font-size: 1.0625rem; line-height: 1.3; }
.stock-alert__product-title, .stock-alert__status { display: block; }
.stock-alert__product-title { color: var(--brand-heading); font-weight: 600; }
.stock-alert__status { font-weight: 500; }
.stock-alert__form { display: grid; gap: 14px; }
.stock-alert__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
.stock-alert__error { margin: 0; color: #b42318; font-size: 13px; }
.stock-alert__privacy { margin: 0; }
@media screen and (max-width: 699px) {
  .stock-alert { inset: auto 0 0 0; width: 100%; max-width: 100%; margin: 0; border-radius: 18px 18px 0 0; padding: 20px 20px calc(24px + env(safe-area-inset-bottom)); }
}
.coming-soon-pill { display: inline-flex; align-items: center; width: max-content; max-width: 100%; padding: 3px 10px; border-radius: 999px; background: rgb(var(--text-color) / .08); color: rgb(var(--text-color) / .75); font-size: 11px; font-weight: 600; line-height: 1.4; }

/* Card polish: equal image panels so every row lines up, tighter preview/heart row, add-to-cart always at the far right */
.product-card { align-items: stretch; }
.product-card__figure { aspect-ratio: 1 / 1; position: relative; width: 100%; }
.product-card__figure > a { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.product-card .product-card__figure img.product-card__image { width: auto !important; height: auto !important; max-width: 100% !important; max-height: 100% !important; aspect-ratio: auto !important; object-fit: contain !important; position: static !important; }
.product-card__row.sample-wishlist { gap: 6px; font-size: 13px; min-height: 24px; } /* keeps the row (and the card heights) the same for books with no preview, as the heart used to */
.product-card__row.buy-price > form { flex: none; margin: 0; }
.product-card__row.buy-price > :not(form) { flex: 1 1 auto; min-width: 0; }
.product-card__figure { min-height: 0; overflow: hidden; }

/* Pack intro: tiles are links that scroll to the first pack of that kind; hero image stretches to the explainer height on desktop */
a.pack-intro__tile { color: inherit; text-decoration: none; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
a.pack-intro__tile:hover { border-color: var(--brand-heading); box-shadow: 0 2px 8px rgba(25, 113, 119, .15); }
a.pack-intro__tile:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
@media screen and (min-width: 1000px) {
  .pack-intro__explainer { padding: 0; align-self: stretch; }
  .pack-intro__text { align-self: center; }
  .pack-intro__tiles { flex: 1 1 auto; }
  .pack-intro__image { align-self: stretch; }
  .pack-intro__image img { width: 220px; height: 100%; min-height: 220px; }
}

/* ---------------------------- */
/* SERIES PAGE (sections/series-page.liquid, sections/series-related.liquid; template metaobject/series.json) */
/* Character cards (snippets/character-card.liquid) are shared with the character page (sections/character-cast.liquid). */
/* One layout for every series. Design canvas "Series Page Mockup". Mobile first; 700px and 1000px as elsewhere. */
/* Colours: var(--brand-heading) teal (headings, buttons), var(--brand-text) text, hero band from the series colour. */
/* ---------------------------- */
.series-page, .series-related { color: var(--brand-text); }
.series-heading { margin: 0; }
.series-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 0 24px; border-radius: 999px; border: 2px solid var(--brand-heading); background: var(--brand-heading); color: #fff; font: inherit; font-size: 15px; font-weight: 700; line-height: 1.2; text-align: center; text-decoration: none; cursor: pointer; }
.series-button:hover { color: #fff; filter: brightness(1.08); }
.series-button:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 3px; }
.series-button--secondary { background: #fff; color: var(--brand-heading); }
.series-button--secondary:hover { color: var(--brand-heading); background: #f3f7f7; filter: none; }
.series-button--small { min-height: 44px; padding: 0 18px; font-size: 14px; }
.series-button--block { width: 100%; }
.series-button[disabled] { background: #e8e8e8; border-color: #e8e8e8; color: #6b6b6b; cursor: not-allowed; }
.series-button.bookpreview .playpause { width: 22px; height: 22px; flex: 0 0 22px; }

/* HERO */
.series-hero { background: var(--series-hero-bg, #ffead7); color: var(--series-hero-ink, #1e2b2c); }
.series-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; padding-block: 16px 28px; }
.series-hero__text { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.series-hero__eyebrow { margin: 0; }
.series-hero__title { margin: 0; }
.series-hero--dark h1.series-hero__title { color: inherit; }
/* The theme orange eyebrow is under 4:1 on dark series colours (e.g. Unicorn Academy purple): use the hero ink */
.series-hero--dark .series-hero__eyebrow { color: inherit; }
.series-hero__lede { margin: 0; font-size: 16px; line-height: 24px; max-width: 40ch; }
.series-hero__chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
.series-chip { padding: 5px 12px; border-radius: 999px; background: var(--series-chip-bg, rgba(255, 255, 255, 0.72)); font-size: 13px; font-weight: 500; line-height: 1.4; }
.series-chip--link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; color: inherit; text-decoration: none; border: 1px solid transparent; }
.series-chip--link:hover { color: inherit; border-color: currentColor; }
.series-chip--link:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
.series-hero__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
.series-hero--dark .series-button--primary { background: #fff; border-color: #fff; color: var(--brand-heading); }
.series-hero--dark .series-button--secondary { background: transparent; border-color: #fff; color: #fff; }
.series-hero--dark .series-button.bookpreview .playpause { filter: invert(1); }
.series-hero__covers { display: flex; justify-content: center; align-items: flex-end; padding-top: 8px; }
.series-hero__cover { width: 28%; max-width: 190px; position: relative; filter: drop-shadow(0 14px 18px rgba(0, 0, 0, 0.2)); }
.series-hero__cover img { width: 100%; height: auto; display: block; }
.series-hero__cover--1 { transform: rotate(-7deg) translateY(8px); margin-right: -5%; z-index: 3; }
.series-hero__cover--2 { transform: translateY(-10px); z-index: 2; }
.series-hero__cover--3 { transform: rotate(7deg) translateY(8px); margin-left: -5%; z-index: 1; }
.series-hero__cover--1:only-child { transform: none; margin: 0; }

/* BOOKS */
.series-books { padding-block: 40px 16px; scroll-margin-top: calc(var(--sticky-area-height, 0px) + 1rem); }
.series-books__head { display: flex; flex-direction: column; gap: 16px; }
.series-books__intro { margin: 6px 0 0; max-width: 60ch; }
.series-whole { display: flex; align-items: center; justify-content: space-between; gap: 12px 16px; flex-wrap: wrap; padding: 14px 16px; border-radius: 16px; background: #fff7f0; }
.series-whole__text p { margin: 0; line-height: 1.35; }
.series-whole__title { font-weight: 600; color: var(--brand-heading); }
.series-whole__meta { font-size: 13px; }
.series-whole__price { font-weight: 600; color: var(--brand-text); }
.series-whole__saving { font-weight: 600; color: var(--accent-strong); }
.series-books__list { display: flex; flex-direction: column; gap: 16px; margin: 24px 0 0; padding: 0; list-style: none; }
.series-book { display: grid; grid-template-columns: 88px minmax(0, 1fr); grid-template-areas: "media body" "buy buy"; gap: 14px 16px; padding: 16px; border: 1px solid var(--card-border); border-radius: 16px; background: #fff; }
.series-book__media { grid-area: media; position: relative; }
.series-book__media img { width: 100%; height: auto; display: block; }
.series-book__number { position: absolute; top: -8px; left: -8px; width: 32px; height: 32px; border-radius: 50%; background: var(--brand-heading); color: #fff; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.series-book__body { grid-area: body; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.series-book__eyebrow { margin: 0; }
.series-book__title { margin: 0; font-size: 17px; line-height: 23px; font-weight: 600; letter-spacing: normal; }
.series-book__title a { color: var(--brand-heading); text-decoration: none; }
.series-book__title a:hover { text-decoration: underline; text-underline-offset: 2px; }
.series-book__blurb { margin: 0; font-size: 14px; line-height: 21px; }
.series-book__meta { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: #6b6b6b; }
.series-book__buy { grid-area: buy; display: grid; grid-template-columns: auto 1fr 1fr; align-items: center; gap: 8px; }
.series-book__buy form { margin: 0; }
.series-book__price { margin: 0; font-size: 17px; font-weight: 700; color: var(--brand-text); white-space: nowrap; padding-right: 4px; }
.series-book__was { font-weight: 400; font-size: 13px; color: #6b6b6b; }

/* CHARACTERS */
.series-characters { padding-block: 32px; }
.character-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 12px; margin: 20px 0 0; padding: 0; list-style: none; }
.character-card { display: flex; flex-direction: column; gap: 6px; padding: 18px; border-radius: 16px; background: #fff7f0; color: var(--brand-text); }
.character-card__photo { width: var(--character-photo-size, 72px); height: var(--character-photo-size, 72px); border-radius: 50%; overflow: hidden; background: #fff; }
.character-card__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; } /* tall full-figure art: show the head */
.character-card__name { margin: 4px 0 0; font-size: 16px; line-height: 22px; font-weight: 600; letter-spacing: normal; color: var(--brand-heading); }
.character-card__name a { color: inherit; }
.character-card__text { margin: 0; font-size: 14px; line-height: 21px; }
/* Audiobook product page: "Part of the … series · Book n of m" (snippets/series-membership.liquid) */
.series-membership { margin: 0; font-size: 14px; color: var(--brand-text); }
.series-membership__link { color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
/* Character page: "Meet the others" (sections/character-cast.liquid) and the round photo in the hero (snippets/person-avatar.liquid) */
.character-cast { padding-block: 40px; color: var(--brand-text); }
.character-cast__intro { margin: 8px 0 0; max-width: 60ch; }
.person-image--character img { width: 100%; height: 100%; object-fit: cover; object-position: center top; } /* tall full-figure art: show the head */

/* ABOUT AND FACTS */
.series-about { background: #f6f8f8; }
.series-about__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; padding-block: 40px; }
.series-about__text { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.series-about__prose p { margin: 0 0 12px; }
.series-about__more { border-top: 1px solid #dfe5e5; padding-top: 12px; }
.series-about__more summary { cursor: pointer; font-weight: 600; color: var(--brand-heading); min-height: 44px; display: flex; align-items: center; }
.series-about__more .prose { margin-top: 8px; }
.series-facts { align-self: start; padding: 20px; border-radius: 16px; background: #fff; }
.series-facts__title { margin: 0 0 12px; font-size: 16px; font-weight: 600; letter-spacing: normal; color: var(--brand-heading); }
.series-facts__list { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 8px 18px; margin: 0; font-size: 14px; line-height: 20px; }
.series-facts__list dt { font-weight: 600; color: var(--brand-heading); }
.series-facts__list dd { margin: 0; }
.series-facts__list a { color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; }
.series-facts__list a:hover { text-decoration-thickness: 2px; }

/* MORE SERIES */
.series-related { padding-block: 40px 56px; }
.series-related__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 12px; margin: 20px 0 0; padding: 0; list-style: none; }
.series-related__card { display: flex; align-items: center; gap: 12px; min-height: 72px; height: 100%; padding: 8px 16px 8px 8px; border: 1px solid var(--card-border); border-radius: 16px; color: var(--brand-heading); font-weight: 600; text-decoration: none; }
.series-related__card:hover { border-color: var(--brand-heading); }
.series-related__image { flex: 0 0 56px; width: 56px; height: 56px; border-radius: 10px; overflow: hidden; background: #f6f8f8; }
.series-related__image img { width: 100%; height: 100%; object-fit: cover; }

@media screen and (min-width: 700px) {
  .series-book { grid-template-columns: 120px minmax(0, 1fr) 190px; grid-template-areas: "media body buy"; align-items: center; gap: 24px; padding: 20px 24px; }
  .series-book__buy { grid-template-columns: 1fr; align-self: center; }
  .series-book__price { font-size: 19px; }
  .series-book__title { font-size: 20px; line-height: 26px; }
  .series-books__head { flex-direction: row; align-items: flex-end; justify-content: space-between; }
}

@media screen and (min-width: 1000px) {
  .series-hero__inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: 40px; padding-block: 24px 56px; }
  .series-hero__lede { font-size: 19px; line-height: 29px; }
  .series-books { padding-block: 64px 24px; }
  .series-about__inner { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 48px; padding-block: 64px; }
}

/* ---------------------------- */
/* AGE COLLECTION TEMPLATE (collection.audiobooks-landing-cat) */
/* Intro band + age tabs + starter pack card (sections/collection-age-intro.liquid), "How Voxblock works" grid row
   (snippets/collection-howto-promo.liquid), About (sections/collection-about.liquid). Design canvas "Age Collection Template". */
/* ---------------------------- */
.age-intro { color: var(--brand-text); }
.age-intro__band { background: var(--age-intro-bg, #fff7f0); }
.age-intro__band-inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; padding-block: 18px 16px; }
.age-intro__text { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.age-intro__eyebrow { margin: 0; }
.age-intro__title { margin: 0; }
.age-intro__lede { margin: 0; font-size: 15px; line-height: 22px; max-width: 34rem; }
.age-intro__trust { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 2px 0 0; padding: 0; list-style: none; font-size: 13px; }
.age-intro__trust li { display: inline-flex; align-items: center; gap: 6px; }
.age-intro__trust svg { flex: none; color: var(--brand-heading); }
.age-intro__trust li:first-child svg { color: #e8862f; }
.age-intro__trust a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
.age-intro__tabs { display: flex; gap: 8px; margin-top: 6px; overflow-x: auto; scrollbar-width: none; }
.age-intro__tabs::-webkit-scrollbar { display: none; }
.age-intro__tab { flex: 0 0 auto; display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1.5px solid var(--card-border); background: #fff; color: var(--brand-heading); font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; }
.age-intro__tab:hover { border-color: var(--brand-heading); color: var(--brand-heading); }
.age-intro__tab[aria-current="page"] { background: var(--brand-heading); border-color: var(--brand-heading); color: #fff; }
.age-intro__tab:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
.collection-related { margin-bottom: 24px; }
.collection-faq { margin-bottom: 24px; }
.collection-related__title { margin: 0 0 10px; font-size: 17px; font-weight: 700; color: var(--brand-heading); }
.collection-related .age-intro__tabs { flex-wrap: wrap; overflow: visible; margin-top: 0; }

/* Starter pack card */
.age-intro__media { display: none; }
/* Ads intent hero (sections/ads-intent-hero.liquid): age-intro band plus a button row and an optional comparison link */
.ads-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 8px; }
.ads-hero__player, .ads-hero__compare a { color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
.ads-hero__compare { margin: 0; font-size: 15px; }
.age-pack { border: 2px solid var(--brand-heading); border-radius: 18px; background: #fff; overflow: hidden; align-self: start; }
.age-pack__head { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 14px; background: var(--brand-heading); color: #fff; font-size: 13px; font-weight: 600; }
.age-pack__save { padding: 2px 9px; border-radius: 999px; background: #fff; color: var(--brand-heading); font-size: 12px; white-space: nowrap; }
.age-pack__body { display: flex; gap: 12px; align-items: center; padding: 12px 14px 4px; }
.age-pack__media { flex: none; width: 112px; height: 112px; }
.age-pack__media img { width: 100%; height: 100%; object-fit: contain; display: block; }
.age-pack__info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.age-pack__title { margin: 0; font-size: 16px; line-height: 21px; font-weight: 700; letter-spacing: normal; }
.age-pack__title a { color: var(--brand-heading); text-decoration: none; }
.age-pack__title a:hover { text-decoration: underline; text-underline-offset: 2px; }
.age-pack__contents { margin: 0; font-size: 13px; line-height: 18px; }
.age-pack__prices { margin: 2px 0 0; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.age-pack__from { font-size: 13px; }
.age-pack__price { font-size: 20px; font-weight: 700; color: var(--accent-strong); }
.age-pack__was { font-size: 13px; color: #6b6b6b; }
.age-pack__buy { display: flex; flex-direction: column; gap: 10px; padding: 6px 14px 14px; }
.age-pack__swatches { border: 0; margin: 0; padding: 0; }
.age-pack__form { margin: 0; }
.age-pack__links { margin: 0; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px 12px; font-size: 13px; }
.age-pack__links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

/* Line above the grid */
.age-intro__grid-head { padding-block: 18px 6px; }
.age-intro__grid-title { margin: 0; font-size: 17px; font-weight: 700; color: var(--brand-heading); }
.age-intro__count { margin: 0; font-size: 13px; }

/* Author and narrator pages (sections/person-intro.liquid): same band and card as the age collections.
   Phones get a one-line pack strip instead of the card, so the books start near the top. */
.person-intro__head { display: flex; align-items: center; gap: 12px; }
.person-intro__initials { flex: none; width: 52px; height: 52px; border-radius: 50%; background: var(--brand-heading); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 19px; font-weight: 700; letter-spacing: 0.5px; }
.person-intro__more { color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; white-space: nowrap; }
.person-intro__strip { margin: 2px 0 0; font-size: 14px; line-height: 20px; }
.person-intro__strip a { color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
.person-intro__card { display: none; }

/* "How Voxblock works" row inside the product grid */
.howto-promo { grid-column: 1 / -1; display: flex; flex-direction: column; border-radius: 18px; overflow: hidden; background: #fff7f0; color: var(--brand-text); margin-block: 8px; }
.howto-promo__media img { display: block; width: 100%; height: 210px; object-fit: cover; }
.howto-promo__text { display: flex; flex-direction: column; gap: 12px; padding: 18px 18px 20px; }
.howto-promo__eyebrow { margin: 0; }
.howto-promo__title { margin: 0; font-size: 20px; line-height: 26px; font-weight: 700; color: var(--brand-heading); }
.howto-promo__steps { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 14px; }
.howto-promo__steps li { display: flex; align-items: center; gap: 10px; }
.howto-promo__steps span { flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--brand-heading); color: #fff; font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
.howto-promo__note { margin: 0; font-size: 14px; }
.howto-promo__actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 4px; }
.howto-promo__actions .series-button { padding: 0 12px; font-size: 14px; }

/* About (collection description, collapsed) */
.collection-about { margin-block: 24px 8px; }
.collection-about__details { border-block: 1px solid var(--card-border); }
.collection-about__summary { display: flex; justify-content: space-between; align-items: center; min-height: 56px; cursor: pointer; list-style: none; font-weight: 600; color: var(--brand-heading); }
.collection-about__summary::-webkit-details-marker { display: none; }
.collection-about__details[open] .collection-about__summary svg { transform: rotate(180deg); }
.collection-about__body { padding-bottom: 16px; max-width: 70ch; }

@media screen and (min-width: 700px) {
  .howto-promo { flex-direction: row; }
  .howto-promo__media { flex: 1 1 50%; min-width: 0; }
  .howto-promo__media img { height: 100%; min-height: 320px; }
  .howto-promo__text { flex: 1 1 50%; justify-content: center; padding: 32px 36px; }
  .howto-promo__title { font-size: 26px; line-height: 33px; }
  .howto-promo__steps { flex-direction: row; flex-wrap: wrap; gap: 10px 22px; font-size: 15px; }
  .howto-promo__actions { display: flex; flex-wrap: wrap; }
  .howto-promo__actions .series-button { padding: 0 24px; font-size: 15px; }
}

@media screen and (min-width: 1000px) {
  .age-intro__band-inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: 48px; padding-block: 36px; }
  .age-intro__lede { font-size: 17px; line-height: 26px; }
  .age-intro__trust { font-size: 14px; }
  .age-pack { max-width: 520px; justify-self: end; }
  .age-intro__media { display: block; justify-self: end; width: 100%; max-width: 460px; }
  .age-intro__media img { display: block; width: 100%; height: auto; border-radius: 18px; }
  .age-pack__media { width: 160px; height: 160px; }
  .age-pack__title { font-size: 19px; line-height: 25px; }
  .age-pack__price { font-size: 24px; }
  .age-intro__grid-head { padding-block: 28px 8px; }
  .age-intro__grid-title { font-size: 20px; }
  .person-intro__initials { width: 72px; height: 72px; font-size: 26px; }
  .person-intro__strip { display: none; }
  .person-intro__card { display: block; justify-self: end; width: 100%; max-width: 520px; }
}

/* ---------------------------- */
/* CART: "Stories play on a Voxblock player" prompt (snippets/cart-player-prompt.liquid) */
/* ---------------------------- */
.cart-player-prompt { display: flex; flex-direction: column; gap: 10px; padding: 14px; border-radius: 16px; background: #fff7f0; border: 1.5px solid #f4c9a4; color: var(--brand-text); }
html.vb-has-player .cart-player-prompt { display: none; }
.cart-player-prompt p { margin: 0; }
.cart-player-prompt__intro { display: flex; gap: 10px; align-items: flex-start; }
.cart-player-prompt__intro svg { flex: none; margin-top: 2px; color: var(--accent-strong-dark); }
.cart-player-prompt__title { font-size: 15px; font-weight: 700; line-height: 20px; color: var(--brand-heading); }
.cart-player-prompt__text { font-size: 13px; line-height: 19px; }
.cart-player-prompt__option { display: flex; align-items: center; gap: 10px; padding: 10px; border-radius: 12px; border: 1px solid var(--card-border); background: #fff; }
.cart-player-prompt__option--best { border: 2px solid var(--brand-heading); }
.cart-player-prompt__option form { margin: 0; }
.cart-player-prompt__media { flex: none; width: 56px; height: 56px; border-radius: 8px; background: var(--card-media-bg); overflow: hidden; }
.cart-player-prompt__media img { width: 100%; height: 100%; object-fit: contain; display: block; }
.cart-player-prompt__info { flex: 1 1 auto; min-width: 0; }
.cart-player-prompt__badge { display: inline-block; padding: 1px 8px; border-radius: 999px; background: var(--brand-heading); color: #fff; font-size: 11px; font-weight: 600; }
.cart-player-prompt__name { font-size: 13.5px; font-weight: 600; line-height: 18px; color: var(--brand-heading); }
.cart-player-prompt__price { font-size: 13px; font-weight: 700; color: var(--accent-strong); }
.cart-player-prompt__price s { font-weight: 400; color: #6b6b6b; }
.cart-player-prompt__add { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--brand-heading); background: var(--brand-heading); color: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
.cart-player-prompt__add--secondary { background: #fff; color: var(--brand-heading); }
.cart-player-prompt__add:focus-visible, .cart-player-prompt__dismiss:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
.cart-player-prompt__dismiss { align-self: center; min-height: 44px; padding: 0 8px; border: 0; background: none; font: inherit; font-size: 13px; font-weight: 600; color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }

/* ---------------------------- */
/* STORY HERO (sections/story-hero.liquid): Gruffalo character + cast pages */
/* Sample, starter pack and audiobook in the first screen, next to the character artwork. */
/* ---------------------------- */
.story-hero { background: var(--story-hero-bg, #fff7f0); color: var(--brand-text); }
.story-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; padding-block: 12px 22px; }
.story-hero__text { display: flex; flex-direction: column; gap: 10px; min-width: 0; order: 2; }
.story-hero__art { order: 1; display: flex; justify-content: center; }
.story-hero__art img { display: block; width: auto; max-width: 50vw; max-height: 150px; height: auto; object-fit: contain; mix-blend-mode: multiply; } /* multiply: the white artwork backgrounds sit into the cream band */
.story-hero__eyebrow { margin: 0; }
.story-hero__title { margin: 0; }
.story-hero__intro { font-size: 15px; line-height: 23px; max-width: 38rem; }
.story-hero__intro p { margin: 0 0 8px; }
.story-hero__actions { display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }
.story-hero__sample-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; }
.story-hero__sample { flex: none; }
.story-hero__sample-note { margin: 0; font-size: 13px; line-height: 18px; max-width: 26rem; }

/* Two routes under the sample: at home (starter pack) and in the classroom (sign-up + school packages) */
.story-routes { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
.story-route { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; border-radius: 16px; color: var(--brand-text); text-decoration: none; min-width: 0; }
.story-route--home { border: 2px solid var(--brand-heading); background: #fff; }
.story-route--home:hover { color: var(--brand-text); box-shadow: 0 4px 14px rgba(25, 113, 119, 0.15); }
.story-route--home:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 3px; }
.story-route--class { border: 2px solid #cfe5e5; background: #eaf4f4; }
.story-route__label { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-strong-dark); }
.story-route__row { display: flex; align-items: center; gap: 12px; }
.story-route__media { flex: none; width: 64px; height: 64px; }
.story-route__media img { width: 100%; height: 100%; object-fit: contain; display: block; }
.story-route__body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.story-route__title { font-size: 15px; font-weight: 700; line-height: 20px; color: var(--brand-heading); }
.story-route__text { font-size: 13px; line-height: 18px; }
.story-route__prices { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; margin-top: 2px; }
.story-route__price { font-size: 17px; font-weight: 700; color: var(--brand-heading); }
.story-route__was { font-size: 13px; color: #6b6b6b; }
.story-route__save { font-size: 12px; font-weight: 600; padding: 1px 8px; border-radius: 999px; background: var(--brand-heading); color: #fff; }
.story-route__more { margin-top: auto; padding-top: 4px; font-size: 14px; font-weight: 700; color: var(--brand-heading); }
.story-route__link { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 600; color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; }
.story-route .school-signup { margin-top: 4px; }

/* School sign-up (snippets/school-signup.liquid) */
.school-signup__row { display: flex; gap: 6px; }
.school-signup__input { flex: 1 1 auto; min-width: 0; min-height: 44px; padding: 0 14px; border: 1px solid #b9cfcf; border-radius: 999px; background: #fff; font: inherit; font-size: 15px; color: var(--brand-text); }
.school-signup__input:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 1px; border-color: var(--brand-heading); }
.school-signup__input[aria-invalid="true"] { border-color: #b3261e; }
.school-signup__button { flex: none; }
.school-signup__status { margin: 6px 0 0; font-size: 13px; line-height: 18px; font-weight: 600; color: var(--brand-heading); }
.school-signup__status[data-state="error"] { color: #b3261e; }
.story-hero__links { margin: 0; display: flex; flex-direction: column; gap: 2px; font-size: 14px; }
.story-hero__links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

@media screen and (min-width: 1000px) {
  .story-hero__inner { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; gap: 48px; padding-block: 32px 40px; }
  .story-hero__text { order: 1; }
  .story-hero__art { order: 2; }
  .story-hero__art img { max-width: 100%; max-height: 460px; }
  .story-hero__intro { font-size: 16px; line-height: 25px; }
  .story-hero__links { flex-direction: row; flex-wrap: wrap; gap: 0 20px; }
  .story-routes { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
}

/* CHARACTER FEATURES (sections/character-features.liquid): "What does the Gruffalo look like?" */
.character-features { padding-block: 36px; color: var(--brand-text); }
.character-features__intro { margin: 8px 0 0; max-width: 60ch; }
.character-features__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 20px 0 0; padding: 0; list-style: none; }
.character-features__card { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; border: 1px solid var(--card-border); border-radius: 14px; background: #fff; }
.character-features__card-title { font-size: 15px; font-weight: 700; line-height: 20px; color: var(--brand-heading); }
.character-features__card-text { font-size: 13px; line-height: 18px; }
.character-features__answers { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; margin-top: 28px; }
.character-features__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
.character-features__main { min-width: 0; }
.character-features__media { display: flex; justify-content: center; order: 2; }
.character-features__media img { display: block; width: auto; max-width: 55vw; max-height: 280px; height: auto; object-fit: contain; }
.character-features__question { margin: 0 0 4px; font-size: 18px; line-height: 24px; font-weight: 600; letter-spacing: normal; color: var(--brand-heading); }
.character-features__text p { margin: 0; font-size: 15px; line-height: 23px; }
.character-features__more { margin: 12px 0 0; }
.character-features__more a, .character-cast__link a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; }
.character-cast__link { margin: 4px 0 0; }

/* CLASSROOM BAND (sections/classroom-band.liquid): light teal band, photo left, text + sign-up right */
.classroom-band { background: #eaf4f4; color: var(--brand-text); }
.classroom-band__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; padding-block: 32px; }
.classroom-band__media img { display: block; width: 100%; height: 260px; object-fit: cover; object-position: center 40%; border-radius: 16px; }
.classroom-band__text { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.classroom-band__eyebrow { margin: 0; }
.classroom-band__title { margin: 0; }
.classroom-band__intro p { margin: 0; font-size: 15px; line-height: 24px; }
.classroom-band__points { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
.classroom-band__point { display: flex; gap: 10px; font-size: 15px; line-height: 23px; }
.classroom-band__tick { flex: none; margin-top: 2px; color: var(--brand-heading); }
.classroom-band__point p { margin: 0; }
.classroom-band__point strong { color: var(--brand-heading); }
.classroom-band__signup { max-width: 34rem; padding: 16px; border-radius: 16px; background: #fff; }
.classroom-band__signup-title { margin: 0 0 8px; font-size: 16px; font-weight: 700; color: var(--brand-heading); }
.classroom-band__signup-note { margin: 8px 0 0; font-size: 13px; line-height: 18px; }
.classroom-band__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
.classroom-band__link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; }

/* STORY STEPS (sections/story-steps.liquid): cast order on the cast page */
.story-steps { padding-block: 36px; background: #f6fbfb; color: var(--brand-text); }
.story-steps__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
.story-steps__eyebrow { margin: 0 0 4px; }
.story-steps__intro { margin-top: 8px; }
.story-steps__intro p { margin: 0 0 10px; font-size: 15px; line-height: 23px; }
.story-steps__list { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
.story-steps__step { display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px; border-radius: 14px; background: #fff; border: 1px solid var(--card-border); }
.story-steps__num { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: var(--brand-heading); color: #fff; font-weight: 700; }
.story-steps__body { display: flex; flex-direction: column; gap: 2px; }
.story-steps__title { font-weight: 700; color: var(--brand-heading); }
.story-steps__text { font-size: 14px; line-height: 20px; }

/* STORY HOME BAND (sections/story-home-band.liquid) */
.story-home-band { background: var(--story-home-bg, #fff7f0); color: var(--brand-text); }
.story-home-band__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; padding-block: 32px; align-items: center; }
.story-home-band__media { display: flex; justify-content: center; }
.story-home-band__media img { display: block; width: auto; max-width: 60vw; max-height: 220px; height: auto; object-fit: contain; }
.story-home-band__text { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.story-home-band__eyebrow { margin: 0; }
.story-home-band__title { margin: 0; }
.story-home-band__intro p { margin: 0; font-size: 15px; line-height: 23px; }
.story-home-band__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 20px; margin-top: 4px; }
.story-home-band__link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; }

@media screen and (min-width: 700px) {
  .character-features__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .character-features__answers { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; }
  .story-home-band__inner { grid-template-columns: 240px minmax(0, 1fr); gap: 40px; }
  .story-home-band__media img { max-width: 100%; max-height: 300px; }
}
@media screen and (min-width: 1000px) {
  .character-features { padding-block: 48px; }
  .character-features__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .character-features--image .character-features__inner { grid-template-columns: 240px minmax(0, 1fr); gap: 40px; align-items: start; }
  .character-features--image .character-features__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .character-features__media { order: 0; }
  .character-features__media img { max-width: 100%; max-height: 420px; }
  .classroom-band__inner { grid-template-columns: minmax(0, 440px) minmax(0, 1fr); gap: 48px; padding-block: 48px; align-items: center; }
  .classroom-band__media img { height: 420px; border-radius: 20px; }
  .story-steps { padding-block: 48px; }
  .story-steps__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
}

/* ----------------------------------------------------------------------------------------------------------------
   VS CTA: the one button on /pages/voxblock-vs-yoto (snippets/vs-cta.liquid). Uses the theme's .button, so it
   matches every other primary button; these lines only centre the label when it wraps.
---------------------------------------------------------------------------------------------------------------- */
.vs-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; text-align: center; }
.vs-cta__from { white-space: nowrap; margin-inline-start: .3em; } /* the leading space is dropped inside a flex button */

/* ----------------------------------------------------------------------------------------------------------------
   PACK CONTENTS: "What's in the box" section below the main product area on starter-pack bundle pages
   (sections/pack-contents.liquid, snippets/pack-contents.liquid). Layout only: headings, eyebrow, links and text take
   the site-wide styles (section-header's .subheading + .h2, bare h3/h4 for the groups and books, .text-sm, .link). Phone: kit tiles in a row of three,
   then one card per book. Desktop: kit in a 300px column, books as three cards beside it. Sample buttons are the
   site's standard .bookpreview button. Also renders in the buy column as block `pack_contents` (.pack-contents--column).
---------------------------------------------------------------------------------------------------------------- */
.pack-contents { display: flex; flex-direction: column; gap: 24px; scroll-margin-top: calc(var(--header-height, 80px) + 24px); }
.pack-contents p { margin: 0; }
.pack-contents__body { display: flex; flex-direction: column; gap: 24px; }
.pack-contents__group { display: flex; flex-direction: column; gap: 12px; }
.pack-contents__group-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 12px; }
.pack-contents__group-head > * { margin: 0; }
.pack-contents-jump { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; }
/* .link draws its underline 1.35em from the top; this box is 44px tall with centred text, so anchor the line to the text instead */
.pack-contents-jump.link { background-position: 0 calc(50% + 0.6em); }

.pack-contents__kit { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.pack-contents__kit-item { display: flex; flex-direction: column; gap: 6px; }
.pack-contents__kit-media { aspect-ratio: 1; border-radius: var(--rounded-sm, 12px); background: rgb(var(--background)); overflow: hidden; }
.pack-contents__kit-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.pack-contents__kit-media img[hidden] { display: none; }

.pack-contents__books { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.pack-contents__book { display: flex; gap: 14px; align-items: center; padding: 12px 14px 12px 10px; border-radius: var(--rounded, 16px); background: rgb(var(--background-primary, 255 255 255)); }
.pack-contents__cover { flex: 0 0 64px; }
.pack-contents__cover img { display: block; width: 64px; height: auto; }
.pack-contents__book-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.pack-contents__book-body > h4 { margin: 0; }
.pack-contents__play { margin-top: 8px; align-self: flex-start; }
.pack-contents__value { display: flex; align-items: center; gap: 12px; }
.pack-contents__value svg { flex: 0 0 26px; }

@media screen and (min-width: 1000px) {
  .pack-contents:not(.pack-contents--column) { gap: 32px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__body { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 40px; align-items: start; }
  .pack-contents:not(.pack-contents--column) .pack-contents__kit { grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__kit-item { display: grid; grid-template-columns: 88px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 14px; row-gap: 2px; align-content: center; padding: 10px; border-radius: var(--rounded, 16px); background: rgb(var(--background-primary, 255 255 255)); }
  .pack-contents:not(.pack-contents--column) .pack-contents__kit-media { grid-row: 1 / span 2; width: 88px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__kit-name { align-self: end; }
  .pack-contents:not(.pack-contents--column) .pack-contents__kit-caption { align-self: start; }
  .pack-contents:not(.pack-contents--column) .pack-contents__books { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__book { flex-direction: column; align-items: stretch; gap: 14px; padding: 16px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__cover { flex: none; display: flex; justify-content: center; padding-top: 4px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__cover img { width: auto; height: 190px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__book-body { flex-grow: 1; }
  .pack-contents:not(.pack-contents--column) .pack-contents__play { margin-top: auto; padding-top: 10px; }
}

/* Buy column (block `pack_contents` in main-product): phone layout at every width (the desktop layout above is for the
   full-width section only), on a light panel so the white kit tiles and book cards stand out. */
.pack-contents--column { gap: 16px; padding: 16px; border-radius: var(--rounded, 16px); background: rgb(var(--text-color) / .04); }
.pack-contents--column .pack-contents__head { display: flex; flex-direction: column; gap: 6px; }
.pack-contents--column .pack-contents__head > * { margin: 0; }

/* Basket line items (cart drawer and /cart): every product image sits in the same square box, so tall audiobook
   covers are no bigger than the player or accessories. Theme-wide, not per section. */
.line-item__media-wrapper {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.line-item__media-wrapper > .line-item__media {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* Small product cards (cart drawer "Why not include...", complementary products): one square box for every image. */
.horizontal-product__image {
  height: var(--horizontal-product-image-size);
  aspect-ratio: 1;
  object-fit: contain;
}

/* Empty cart drawer: the recommendations carousel spans the drawer and its cards keep their normal left-aligned
   layout (the empty state centres everything else). */
.empty-state > .cart-drawer__recommendations {
  justify-self: stretch;
  width: 100%;
  text-align: start;
}

.empty-state .cart-drawer__recommendations .horizontal-product {
  text-align: start;
}

/* Cart page: "Continue shopping" link under the order table (same destination as the empty-cart button). */
.cart-order__continue {
  margin-block-start: var(--spacing-6);
}

/* Refer a friend (sections/referral-intro, referral-steps, referral-rewards; snippets referral-share, referral-token).
   Token picture: assets/golden-token.webp (640px) and golden-token-240.webp. Buttons are .series-button. */
.referral-token { display: block; width: var(--token-size, 34px); height: var(--token-size, 34px); border-radius: 50%; filter: drop-shadow(0 2px 3px rgb(120 80 10 / 0.35)); }
.referral-token--outline { box-sizing: border-box; border: 2px dashed #a8612e; filter: none; }

.referral-hero { position: relative; overflow: hidden; background: #fff7f0; color: var(--brand-text); }
.referral-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; padding-block: 12px 32px; }
.referral-hero__visual { position: relative; height: 172px; }
.referral-hero__glow { position: absolute; inset: -20% 0; background: radial-gradient(closest-side, rgb(255 205 110 / 0.75), rgb(255 205 110 / 0) 100%); }
.referral-hero__coin { position: absolute; top: 50%; left: 50%; width: 118px; height: 118px; margin: -59px 0 0 -59px; animation: referral-float 6s ease-in-out infinite; }
.referral-hero__coin .referral-token { width: 100%; height: 100%; filter: drop-shadow(0 10px 14px rgb(120 80 10 / 0.35)); }
.referral-hero__coin::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.55) 48%, transparent 60%) no-repeat; background-size: 250% 100%; background-position: 130% 0; animation: referral-shine 5s ease-in-out infinite; mix-blend-mode: screen; pointer-events: none; }
.referral-hero__coin--1 { transform: translate(-82px, 10px) rotate(-14deg); animation-delay: -1s; }
.referral-hero__coin--2 { z-index: 2; transform: translate(0, -6px) scale(1.12); }
.referral-hero__coin--3 { transform: translate(82px, 12px) rotate(12deg); animation-delay: -3s; }
.referral-hero__coin--1::after { animation-delay: 1.2s; }
.referral-hero__coin--3::after { animation-delay: 2.4s; }
@keyframes referral-float { 50% { margin-top: -67px; } }
@keyframes referral-shine { 0%, 55% { background-position: 130% 0; } 85%, 100% { background-position: -30% 0; } }
@media (prefers-reduced-motion: reduce) { .referral-hero__coin, .referral-hero__coin::after { animation: none; } }
.referral-hero__text { position: relative; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.referral-hero__eyebrow, .referral-hero__title, .referral-hero__lede { margin: 0; }
.referral-hero__lede { font-size: 15px; line-height: 23px; max-width: 34rem; }
.referral-hero__offer { display: flex; align-items: center; gap: 12px; margin: 0; padding: 12px 14px; border-radius: 16px; background: #fff; box-shadow: 0 2px 8px rgb(86 86 86 / 0.1); font-size: 14px; line-height: 20px; font-weight: 600; color: var(--brand-heading); }
.referral-hero__mini-tokens { display: inline-flex; flex: none; }
.referral-hero__mini-tokens .referral-token + .referral-token { margin-left: -8px; }
.referral-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
.referral-hero__actions .series-button { flex: 1 1 100%; }
.referral-hero__note { margin: 0; font-size: 13px; line-height: 20px; }
.referral-hero__note a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
.referral-hero__progress { display: flex; align-items: center; gap: 12px; font-size: 14px; font-weight: 600; color: var(--brand-heading); }
.referral-hero__progress .referral-hero__mini-tokens { gap: 6px; }
.referral-hero__progress .referral-token + .referral-token { margin-left: 0; }

.referral-share { container-type: inline-size; display: flex; flex-direction: column; gap: 12px; padding: 18px; border-radius: 16px; background: #fff; box-shadow: 0 5px 30px rgb(86 86 86 / 0.12); }
.referral-share--compact { margin-top: 10px; padding: 0; background: none; box-shadow: none; }
.referral-share__label { margin: 0; font-size: 13px; }
.referral-share__code-row { display: flex; gap: 8px; align-items: center; }
/* Code and buttons scale with the panel width (container units) and never wrap. */
.referral-share__code { flex: 1 1 auto; min-width: 0; padding: 8px 10px; border: 2px dashed #e0b25a; border-radius: 12px; background: #fffaf1; font-size: 16px; font-size: clamp(13px, 7cqi, 22px); font-weight: 700; letter-spacing: 0.03em; line-height: 1.3; text-align: center; white-space: nowrap; color: var(--brand-heading); }
.referral-share__code-row .series-button { flex: none; padding: 0 16px; white-space: nowrap; }
.referral-share__links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.referral-share__links .series-button { min-height: 44px; padding: 0 4px; font-size: 13px; font-size: clamp(11px, 4.6cqi, 14px); white-space: nowrap; }

.referral-rewards { padding-block: 40px; color: var(--brand-text); }
.referral-rewards__inner { display: flex; flex-direction: column; gap: 20px; }
.referral-rewards__intro { margin: 8px 0 0; }
.referral-rewards__list { display: flex; flex-direction: column; gap: 12px; margin: 0; padding: 0; list-style: none; }
.referral-rewards__item { display: flex; align-items: center; gap: 14px; padding: 12px; border: 1px solid var(--card-border); border-radius: 16px; background: #fff; transition: transform 0.2s ease, box-shadow 0.2s ease; }
.referral-rewards__media { flex: none; width: 96px; height: 96px; border-radius: 12px; background: #eaf4f4; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.referral-rewards__media img { width: 100%; height: 100%; object-fit: contain; }
.referral-rewards__media--value { background: var(--brand-heading); color: #fff; font-size: 24px; font-weight: 700; }
.referral-rewards__body { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; min-width: 0; }
.referral-rewards__cost { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px 3px 4px; border-radius: 999px; background: #fff3dc; font-size: 12px; font-weight: 700; color: var(--brand-heading); }
.referral-rewards__cost-tokens { display: inline-flex; }
.referral-rewards__cost-tokens .referral-token + .referral-token { margin-left: -9px; }
.referral-rewards__title { font-weight: 700; color: var(--brand-heading); }
.referral-rewards__text { font-size: 14px; line-height: 20px; }

.referral-steps { padding-block: 40px; background: #f6fbfb; color: var(--brand-text); }
.referral-steps__inner { display: flex; flex-direction: column; gap: 24px; }
.referral-steps__intro { margin: 8px 0 0; max-width: 40rem; }
.referral-steps__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; margin: 0; padding: 0; list-style: none; }
.referral-steps__step { display: flex; align-items: flex-start; gap: 14px; padding: 16px; border-radius: 16px; background: #fff; border: 1px solid var(--card-border); }
.referral-steps__step--code { border: 2px solid #e0b25a; }
.referral-steps__num { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #ffe7a3, #f2b544 55%, #c98a1c); box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.5), 0 2px 4px rgb(120 80 10 / 0.3); color: #1d3f43; font-size: 17px; font-weight: 700; }
.referral-steps__body { flex: 1 1 auto; min-width: 0; }
.referral-steps__title { margin: 6px 0 2px; font-size: 17px; line-height: 1.3; color: var(--brand-heading); }
.referral-steps__text { margin: 0; font-size: 14px; line-height: 21px; }

@media screen and (min-width: 750px) {
  .referral-hero__actions .series-button { flex: 0 0 auto; }
  .referral-rewards { padding-block: 64px; }
  .referral-rewards__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .referral-rewards__item { flex-direction: column; align-items: stretch; padding: 0; overflow: hidden; }
  .referral-rewards__item:hover { transform: translateY(-4px); box-shadow: 0 5px 30px rgb(86 86 86 / 0.12); }
  .referral-rewards__media { width: 100%; height: 220px; border-radius: 0; }
  .referral-rewards__media--value { font-size: 56px; }
  .referral-rewards__body { padding: 0 20px 20px; }
  .referral-steps__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .referral-steps__step--code { grid-column: 1 / -1; }
}
@media screen and (min-width: 1000px) {
  .referral-hero__inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: 48px; padding-block: 56px; }
  .referral-hero__visual { order: 2; height: 380px; }
  .referral-hero__coin { width: 190px; height: 190px; margin: -95px 0 0 -95px; }
  .referral-hero__coin--1 { transform: translate(-122px, 30px) rotate(-14deg); }
  .referral-hero__coin--2 { transform: translate(0, -24px) scale(1.12); }
  .referral-hero__coin--3 { transform: translate(122px, 34px) rotate(12deg); }
  @keyframes referral-float { 50% { margin-top: -107px; } }
  .referral-hero__lede { font-size: 17px; line-height: 26px; }
  .referral-steps { padding-block: 64px; }
  .referral-steps__list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .referral-steps__step { flex-direction: column; padding: 22px; }
  .referral-steps__step--code { flex-direction: row; }
}

/* Black Friday code (sections/black-friday-code; templates page.black-friday, page.black-friday-preview).
   Campaign look (owner, 16 Oct): before the start the panel is orange with dark ink; while live it is black with cyan
   and a glow. Two offers get equal billing as side-by-side cards: the player (everyone) and audiobooks (existing
   customers, applied automatically while signed in; shown as a ladder of book stacks). Every colour is a --bf-* variable set per clock phase, so it restyles in one place. */
.bf { --bf-ground: #10282b; --bf-card: #17353a; --bf-text: #fff; --bf-soft: #d9e6e7; --bf-line: #2f4f53;
  --bf-accent: #ff9e57; --bf-accent-ink: #1d3f43; --bf-glow: transparent;
  padding-block: 24px 48px; color: var(--brand-text); }
.bf--t-before { --bf-ground: #ff9e57; --bf-card: #fff4ea; --bf-text: #1d3f43; --bf-soft: #1d3f43; --bf-line: rgb(29 63 67 / 0.18);
  --bf-accent: #1d3f43; --bf-accent-ink: #ff9e57; --bf-glow: rgb(255 158 87 / 0.45); }
.bf--t-during { --bf-ground: #000; --bf-card: #071012; --bf-text: #fff; --bf-soft: #b9cbce; --bf-line: #1d3a3f;
  --bf-accent: #00e1ff; --bf-accent-ink: #000; --bf-glow: rgb(0 225 255 / 0.35); }

.bf__review-label { margin: 0 0 10px; font-size: 13px; font-weight: 500; color: var(--brand-heading); }
.bf__panel { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; gap: 24px; padding: 24px 16px; border-radius: 24px;
  background: var(--bf-ground); color: var(--bf-text); box-shadow: 0 18px 60px var(--bf-glow); }
.bf__panel > * { position: relative; z-index: 1; }
.bf__panel--quiet { background: #fff; color: var(--brand-text); border: 1px solid #d6e6e7; box-shadow: none; }
.bf--t-during .bf__panel:not(.bf__panel--quiet) {
  background:
    radial-gradient(70% 60% at 100% 0%, rgb(0 225 255 / 0.22), transparent 70%),
    radial-gradient(50% 50% at 0% 100%, rgb(0 225 255 / 0.12), transparent 70%),
    repeating-linear-gradient(90deg, rgb(0 225 255 / 0.05) 0 1px, transparent 1px 48px),
    repeating-linear-gradient(0deg, rgb(0 225 255 / 0.05) 0 1px, transparent 1px 48px),
    #000;
  box-shadow: 0 0 0 1px rgb(0 225 255 / 0.55), 0 0 40px rgb(0 225 255 / 0.25), 0 24px 70px rgb(0 0 0 / 0.35); }
.bf--t-before .bf__panel:not(.bf__panel--quiet) {
  background: radial-gradient(60% 70% at 100% 0%, rgb(255 230 200 / 0.55), transparent 70%), repeating-linear-gradient(135deg, rgb(255 255 255 / 0.07) 0 14px, transparent 14px 28px), #ff9e57; }
.bf__backdrop { position: absolute; z-index: 0; right: -0.06em; top: -0.12em; font-size: clamp(72px, 16vw, 210px); line-height: 1; font-weight: 800; letter-spacing: -0.04em;
  text-transform: uppercase; white-space: nowrap; color: transparent; -webkit-text-stroke: 1.5px var(--bf-accent); opacity: 0.14; pointer-events: none; user-select: none; }

.bf__top { display: flex; flex-direction: column; gap: 20px; }
.bf__intro { display: flex; flex-direction: column; gap: 10px; max-width: 620px; }
.bf__eyebrow { margin: 0; align-self: flex-start; padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  background: var(--bf-accent); color: var(--bf-accent-ink); }
.bf__panel--quiet .bf__eyebrow { padding: 0; background: none; color: #a8612e; }
.bf__title { margin: 0; font-size: 38px; line-height: 1.02; font-weight: 800; letter-spacing: -0.03em; color: inherit; }
.bf--t-during .bf__panel:not(.bf__panel--quiet) .bf__title { text-shadow: 0 0 28px rgb(0 225 255 / 0.35); }
.bf__panel--quiet .bf__title { font-size: 30px; font-weight: 600; color: var(--brand-heading); }
.bf__lede { margin: 0; font-size: 15px; line-height: 1.6; color: var(--brand-text); }
.bf__lede a { color: inherit; }

/* Timers: before = dark ink tiles on orange; live = glowing cyan tiles on black. */
.bf-timer { display: flex; flex-direction: column; gap: 8px; }
.bf-timer__label { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bf-accent); }
.bf-timer__units { display: flex; gap: 6px; }
.bf-timer__unit { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center; padding: 10px 0 8px; border-radius: 14px; }
.bf-timer__num { font-size: 30px; line-height: 1; font-weight: 800; font-variant-numeric: tabular-nums; }
.bf-timer__name { margin-top: 4px; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
.bf-timer__when { margin: 0; font-size: 12px; color: var(--bf-soft); }
.bf-timer--before .bf-timer__unit { background: #1d3f43; color: #ff9e57; box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.25); }
.bf-timer--before .bf-timer__name { color: #ffd2b0; }
.bf-timer--during .bf-timer__unit { background: var(--bf-accent); color: #000; box-shadow: 0 0 22px rgb(0 225 255 / 0.55), inset 0 -3px 0 rgb(0 0 0 / 0.18); }
.bf-timer__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--bf-accent); box-shadow: 0 0 0 4px rgb(0 225 255 / 0.25), 0 0 12px var(--bf-accent); animation: bf-pulse 1.4s ease-in-out infinite; }
@keyframes bf-pulse { 50% { box-shadow: 0 0 0 8px rgb(0 225 255 / 0.04), 0 0 4px var(--bf-accent); } }
@keyframes bf-tick { 0% { transform: translateY(-3px); opacity: 0.6; } 100% { transform: none; opacity: 1; } }
.bf-timer--during [data-unit="s"] { display: inline-block; animation: bf-tick 1s ease-out infinite; }

/* The two offers, equal billing. */
.bf-offers { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
.bf-offer { display: grid; grid-template-rows: auto auto auto 1fr auto; gap: 6px; padding: 20px; border-radius: 20px; background: var(--bf-card); border: 1px solid var(--bf-line); color: var(--bf-text); min-width: 0; }
.bf--t-during .bf-offer { border-color: rgb(0 225 255 / 0.45); box-shadow: inset 0 0 40px rgb(0 225 255 / 0.06); }
.bf-offer__tag { margin: 0; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bf-soft); }
.bf-offer__big { margin: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 6px; font-size: 76px; line-height: 0.9; font-weight: 800; letter-spacing: -0.05em; color: var(--bf-text); }
.bf--t-during .bf-offer__big { color: var(--bf-accent); text-shadow: 0 0 26px rgb(0 225 255 / 0.55); }
.bf-offer__upto { flex-basis: 100%; font-size: 15px; font-weight: 700; letter-spacing: 0.02em; line-height: 1.4; }
.bf-offer__off { font-size: 26px; letter-spacing: -0.01em; }
.bf-offer__name { margin: 0; font-size: 22px; line-height: 1.2; font-weight: 700; color: var(--bf-text); }
.bf-offer__visual { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; padding-block: 8px; min-height: 140px; }
.bf-offer__visual--player { align-items: center; }
.bf-offer__player-img { width: 150px; height: 150px; object-fit: contain; border-radius: 50%; background: #fff; padding: 10px; box-sizing: border-box; flex: 0 0 auto; }
.bf--t-during .bf-offer__player-img { box-shadow: 0 0 0 3px var(--bf-accent), 0 0 30px rgb(0 225 255 / 0.5); }
.bf-offer__price { margin: 0; display: flex; flex-direction: column; align-items: flex-end; text-align: right; }
.bf-offer__now { font-size: 30px; font-weight: 800; letter-spacing: -0.02em; }
.bf-offer__was { font-size: 16px; color: var(--bf-soft); }
.bf-offer__action { display: flex; flex-direction: column; gap: 10px; }
.bf-offer__soon { display: inline-flex; align-self: flex-start; padding: 8px 14px; border-radius: 999px; border: 2px dashed var(--bf-accent); font-weight: 700; font-size: 14px; }
.bf-offer__nudge { margin: 0; font-size: 14px; font-weight: 600; color: var(--bf-soft); }

/* Book ladder: three columns of book spines, taller for more books. */
.bf-ladder { flex: 1 1 auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: end; gap: 8px; margin: 0; padding: 0; list-style: none; }
.bf-ladder__step { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 8px 4px; border-radius: 14px; text-align: center; }
.bf-ladder__pct { font-size: 24px; line-height: 1; font-weight: 800; letter-spacing: -0.02em; }
.bf-ladder__books { display: flex; flex-direction: column-reverse; align-items: center; gap: 2px; }
.bf-ladder__books i { display: block; width: 46px; height: 9px; border-radius: 3px; background: var(--bf-accent); opacity: 0.85; }
.bf-ladder__books i:nth-child(2n) { width: 40px; opacity: 0.6; }
.bf-ladder__books i:nth-child(3n) { width: 50px; opacity: 0.75; }
.bf-ladder__qty { font-size: 13px; font-weight: 700; }
.bf-ladder__unit { font-weight: 500; color: var(--bf-soft); }
.bf-ladder__step--active { background: var(--bf-accent); color: var(--bf-accent-ink); box-shadow: 0 0 26px var(--bf-glow); }
.bf-ladder__step--active .bf-ladder__books i { background: var(--bf-accent-ink); }
.bf-ladder__step--active .bf-ladder__unit { color: var(--bf-accent-ink); }

/* Buttons, and the "applied automatically" line on the audiobook card. */
.bf-code { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.bf-offer__auto { margin: 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: var(--bf-text); }
.bf-button:focus-visible { outline: 2px solid var(--bf-text); outline-offset: 3px; }
.bf-button { display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 26px; border-radius: 999px;
  background: var(--bf-accent); color: var(--bf-accent-ink); font-size: 16px; font-weight: 800; text-decoration: none; text-align: center; transition: transform 0.15s ease, box-shadow 0.15s ease; }
.bf--t-during .bf-button { box-shadow: 0 0 26px rgb(0 225 255 / 0.5); }
.bf-button:hover { color: var(--bf-accent-ink); transform: translateY(-1px); }
.bf--t-during .bf-button:hover { box-shadow: 0 0 40px rgb(0 225 255 / 0.75); }
.bf-button--quiet, .bf-button--quiet:hover { background: #237a74; color: #fff; box-shadow: none !important; }
.bf-code .bf-button { flex: 1 1 100%; }

/* Quiet panel (ended) keep the offer cards readable on white. */
.bf__panel--quiet .bf-offer { --bf-text: #1d3f43; --bf-soft: #4a4a4a; --bf-accent: #ff9e57; --bf-accent-ink: #1d3f43; background: #fff7f0; border-color: #f3e2d3; box-shadow: none; }
.bf__panel--quiet .bf-offer__big { color: #1d3f43; text-shadow: none; }
.bf__panel--quiet .bf-button:not(.bf-button--quiet) { background: #ff9e57; color: #1d3f43; box-shadow: none; }
.bf__panel--quiet .bf-chips { --bf-soft: #4a4a4a; --bf-line: #d6e6e7; }
.bf__panel--quiet .bf-button:focus-visible { outline-color: var(--brand-heading); }

/* Rules as icon chips instead of paragraphs. */
.bf-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
.bf-chips li { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--bf-line); font-size: 13px; font-weight: 600; color: var(--bf-soft); }
.bf-chips svg { flex: 0 0 auto; color: var(--bf-accent); }
.bf--t-before .bf-chips svg { color: #1d3f43; }
.bf__terms { font-size: 12px; color: var(--bf-soft); }

@media (min-width: 750px) {
  .bf { padding-block: 40px 64px; }
  .bf__panel { padding: 44px 48px; gap: 28px; }
  .bf__top { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; }
  .bf__title { font-size: 64px; }
  .bf-timer { align-items: flex-end; }
  .bf-timer__unit { flex: 0 0 76px; padding: 12px 0 10px; }
  .bf-timer__num { font-size: 40px; }
  .bf-offers { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .bf-offers--single { grid-template-columns: minmax(0, 1fr); }
  .bf-offer { padding: 28px; }
  .bf-offer__big { font-size: 112px; }
  .bf-offer__off { font-size: 34px; }
  .bf-offer__player-img { width: 190px; height: 190px; }
  .bf-offer__visual { min-height: 190px; }
  .bf-ladder__books i { width: 56px; height: 11px; }
  .bf-ladder__books i:nth-child(2n) { width: 48px; }
  .bf-ladder__books i:nth-child(3n) { width: 60px; }
  .bf-ladder__pct { font-size: 30px; }
}
@media (prefers-reduced-motion: reduce) {
  .bf-timer__dot, .bf-timer--during [data-unit="s"] { animation: none; }
  .bf-button { transition: none; }
}

/* Black Friday: locked customer card (signed out / no orders). Accent-coloured so it stands out, nothing of the book
   offer revealed, no paragraph: lock, blurred ladder, sign-in button. */
.bf-offer.bf-offer--locked { background: var(--bf-accent); color: var(--bf-accent-ink); border-color: transparent; box-shadow: 0 18px 50px rgb(0 0 0 / 0.2); }
.bf--t-during .bf-offer.bf-offer--locked { border-color: transparent; box-shadow: 0 0 44px rgb(0 225 255 / 0.5); }
.bf-offer--locked .bf-offer__tag, .bf-offer--locked .bf-offer__name, .bf-offer--locked .bf-offer__nudge { color: inherit; }
.bf-offer--locked .bf-offer__tag { opacity: 0.75; }
.bf-offer__big--lock, .bf--t-during .bf-offer__big--lock { color: inherit; line-height: 1; text-shadow: none; }
.bf-offer__visual--locked { min-height: 120px; }
.bf-ladder--blur { filter: blur(5px); opacity: 0.8; user-select: none; }
.bf-offer--locked .bf-ladder__books i { background: currentColor; }
.bf-offer--locked .bf-offer__visual--locked { align-items: center; }
.bf-offer--locked .bf-ladder__books { gap: 4px; }
.bf-offer--locked .bf-ladder__books i { width: 60px; height: 14px; }
.bf-offer--locked .bf-ladder__pct { font-size: 34px; }
@media (min-width: 750px) {
  .bf-offer--locked .bf-ladder__books i { width: 76px; height: 18px; border-radius: 4px; }
  .bf-offer--locked .bf-ladder__pct { font-size: 46px; }
}
.bf-offer--locked .bf-button, .bf-offer--locked .bf-button:hover { background: var(--bf-accent-ink); color: var(--bf-accent); box-shadow: none; }

/* Black Friday: player card veiled until a couple of days before (percentage and price blurred). */
.bf-offer--veiled [data-bf-veil] { filter: blur(16px); opacity: 0.7; user-select: none; pointer-events: none; }
.bf-offer__soon.bf-offer__soon--veiled { display: none; }
.bf-offer--veiled .bf-offer__soon.bf-offer__soon--veiled { display: inline-flex; }
.bf-offer--veiled .bf-offer__soon--open { display: none; }

/* Black Friday: email sign-up inside the player card (signed out, before it opens). */
.bf-signup { display: grid; gap: 8px; margin: 0; }
.bf-signup__title { margin: 0; font-size: 16px; line-height: 1.35; font-weight: 700; color: var(--bf-text); }
.bf-signup__text { margin: 0; font-size: 12px; line-height: 1.5; color: var(--bf-soft); }
.bf-signup__row { display: flex; flex-direction: column; gap: 8px; }
.bf-signup__input { width: 100%; min-width: 0; min-height: 54px; padding: 0 22px; border-radius: 999px; border: 2px solid var(--bf-accent); background: #fff; color: #1d3f43; font: inherit; font-size: 16px; box-sizing: border-box; }
.bf-signup__input:focus-visible { outline: 2px solid var(--bf-text); outline-offset: 3px; }
.bf-signup__done, .bf-signup__error { margin: 0; font-size: 15px; line-height: 1.5; font-weight: 600; }
.bf-signup__error { color: #b3123f; }
@media (min-width: 750px) {
  .bf-signup__row { flex-direction: row; }
  .bf-signup__input { flex: 1 1 auto; }
  .bf-signup__row .bf-button { flex: 0 0 auto; }
}


/* ---------------------------- */
/* PRODUCT PAGE: "from" price + opt-out picker */
/* Shared components, switched on per product by block settings: price block "Show from price", variant picker
   "Opt-out option value". First use: the player (bumper colour tiles, "Prefer it without the bumper?" link).
   Design canvas: "Player page variant picker". */
/* ---------------------------- */
/* Headline price: "from £49.99" until a value is chosen, then that variant's own price, plus a short note beside it that
   follows the choice (e.g. "including red bumper"). Theme price colour (--accent-strong). */
.product-info__headline-price { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--spacing-3); }
.product-info__headline-price .product-info__from-price,
.product-info__headline-price sale-price { margin: 0; font-size: var(--text-h2); line-height: 1.1; font-weight: 700; color: var(--accent-strong); }
.product-info__headline-price[data-state="from"] price-list { display: none; }
.product-info__headline-price[data-state="selected"] .product-info__from-price { display: none; }
.product-info__price-note { font-size: var(--text-base); font-weight: 600; color: var(--accent-strong); }

/* Values as tiles: a mini player in its bumper colour over the name, one row of four on a phone */
.variant-picker__option-values--tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(4.25rem, 1fr)); gap: var(--spacing-2); }
.variant-picker__option-values--tiles { gap: var(--spacing-2-5, .625rem); padding-block: .5rem; }
.variant-picker__option-values--tiles .block-swatch { flex-direction: column; justify-content: center; gap: var(--spacing-2); height: auto; min-height: 7rem; padding: var(--spacing-3) var(--spacing-1) var(--spacing-2); border-radius: 1rem; border-color: var(--card-border); font-size: var(--text-sm); color: var(--brand-text); cursor: pointer; transition: transform .15s ease, box-shadow .15s ease, background-color .15s ease; }
.variant-picker__option-values--tiles .block-swatch:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgb(86 86 86 / .14); }
/* The colour is drawn as a small player in its bumper: coloured frame, white face, book tray */
.variant-picker__option-values--tiles .block-swatch__color { position: relative; width: 2.75rem; height: 3.5rem; border-radius: .85rem; box-shadow: 0 3px 8px rgb(0 0 0 / .18); }
.variant-picker__option-values--tiles .block-swatch__color::before { content: ""; position: absolute; inset: .3rem; border-radius: .6rem; background: #fff; }
.variant-picker__option-values--tiles .block-swatch__color::after { content: ""; position: absolute; left: 50%; top: .85rem; width: 1.35rem; height: 1.6rem; transform: translateX(-50%); border-radius: .35rem; background: #eef2f2; box-shadow: inset 0 1px 3px rgb(0 0 0 / .14); }
/* Selected: one brand ring (replaces the theme's dark ring), a tick badge, a soft tint, bolder name */
.variant-picker__option-values--tiles .block-swatch:before { box-shadow: 0 0 0 2px var(--brand-heading); }
.variant-picker__option-values--tiles :checked + .block-swatch { border-color: transparent; background: rgb(var(--brand-heading-rgb) / .06); color: var(--brand-heading); font-weight: 600; box-shadow: 0 6px 16px rgb(var(--brand-heading-rgb) / .18); }
.variant-picker__option-values--tiles :checked + .block-swatch::after { content: "\2713"; position: absolute; top: -.45rem; right: -.45rem; display: grid; place-items: center; width: 1.4rem; height: 1.4rem; border-radius: 50%; background: var(--brand-heading); color: #fff; font-size: .8rem; line-height: 1; }
.variant-picker__option-values--tiles :focus-visible + .block-swatch { outline: 2px solid var(--brand-heading); outline-offset: 3px; }

/* The opt-out value: a quiet text link on its own row under the tiles, still a real radio in the same group */
.variant-picker__option-values--tiles .opt-out-link { grid-column: 1 / -1; justify-self: start; display: inline-flex; flex-wrap: wrap; align-items: center; gap: .35em; min-height: 44px; padding: .5rem .75rem; margin-inline-start: -.75rem; border-radius: 999px; color: var(--brand-heading); font-size: var(--text-sm); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
.opt-out-link__price { font-weight: 600; }
.opt-out-link:hover { background: rgb(var(--brand-heading-rgb) / .06); }
:checked + .opt-out-link { background: rgb(var(--brand-heading-rgb) / .1); font-weight: 600; text-decoration: none; }
:focus-visible + .opt-out-link { outline: 2px solid currentColor; outline-offset: 2px; }
:disabled + .opt-out-link { opacity: .5; cursor: not-allowed; }

/* Photo tiles: each colour is a crop of its own product photo (the bumper off and on the player).
   Selected = a thick ring in the bumper's own colour, a tick and a lift; the rest stay bright so every colour tempts. */
.variant-picker__option-values--photos { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: var(--spacing-2); }
.photo-swatch { --photo-swatch-colour: var(--brand-heading); display: flex; flex-direction: column; gap: .4rem; cursor: pointer; -webkit-tap-highlight-color: transparent; }
.photo-swatch__frame { position: relative; display: block; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 1rem; background: #fff; box-shadow: 0 0 0 1.5px var(--card-border), 0 2px 8px rgb(86 86 86 / .08); transition: transform .18s ease, box-shadow .18s ease; }
.photo-swatch__img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.02); transition: transform .35s ease; }
.photo-swatch:hover .photo-swatch__frame { transform: translateY(-2px); box-shadow: 0 0 0 1.5px var(--photo-swatch-colour), 0 8px 18px rgb(86 86 86 / .16); }
.photo-swatch:hover .photo-swatch__img { transform: scale(1.08); }
:checked + .photo-swatch .photo-swatch__frame { box-shadow: 0 0 0 3px var(--photo-swatch-colour), 0 10px 22px rgb(86 86 86 / .2); transform: translateY(-2px); }
:checked + .photo-swatch .photo-swatch__img { transform: scale(1.08); }
.photo-swatch__tick { position: absolute; top: .35rem; right: .35rem; display: grid; place-items: center; width: 1.4rem; height: 1.4rem; border-radius: 50%; background: var(--photo-swatch-colour); color: #fff; font-size: .8rem; line-height: 1; box-shadow: 0 1px 4px rgb(0 0 0 / .3); opacity: 0; transform: scale(.6); transition: opacity .15s ease, transform .15s ease; }
.photo-swatch__tick::before { content: "\2713"; }
:checked + .photo-swatch .photo-swatch__tick { opacity: 1; transform: scale(1); }
:focus-visible + .photo-swatch { outline: none; }
:focus-visible + .photo-swatch .photo-swatch__frame { outline: 2px solid var(--brand-heading); outline-offset: 3px; }
:disabled + .photo-swatch { opacity: .5; cursor: not-allowed; }
@media (prefers-reduced-motion: reduce) { .photo-swatch__frame, .photo-swatch__img, .photo-swatch__tick { transition: none; } }

/* ---------------------------------------------------------------------------------------------------------------------
   SAGA — "Ask Saga" grid tile (snippets/collection-saga-promo.liquid) and chat dialog (snippets/saga-chat.liquid)
   --------------------------------------------------------------------------------------------------------------------- */
.saga-tile { grid-column: span 1; display: flex; height: 100%; }
.saga-tile__button { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; width: 100%; height: 100%; min-height: 240px; padding: 18px 12px; border: 1px solid var(--card-border); border-radius: 12px; background: #fff7f0; color: var(--brand-text); font: inherit; text-align: center; cursor: pointer; }
.saga-tile__button:hover .saga-tile__cta, .saga-tile__button:focus-visible .saga-tile__cta { background: #fff; color: var(--brand-heading); }
.saga-tile__button:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 3px; }
.saga-tile__avatar-wrap { position: relative; display: inline-flex; margin-bottom: 4px; border-radius: 50%; }
.saga-tile__avatar-wrap::before { content: ''; position: absolute; inset: -14px; border-radius: 50%; background: radial-gradient(circle, rgb(242 181 68 / 0.5) 0%, rgb(242 181 68 / 0) 70%); z-index: 0; }
.saga-tile__avatar-wrap::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #ffe7a3, #f2b544 55%, #c98a1c); z-index: 0; }
.saga-tile__avatar { position: relative; z-index: 1; width: 88px; height: 88px; border-radius: 50%; object-fit: cover; box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.5), 0 4px 10px rgb(120 80 10 / 0.35); transition: transform .25s ease, box-shadow .25s ease; }
.saga-tile__button:hover .saga-tile__avatar, .saga-tile__button:focus-visible .saga-tile__avatar { transform: scale(1.06); box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.6), 0 6px 16px rgb(120 80 10 / 0.45); }
.saga-tile__eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #C2560F; }
.saga-tile__title { font-size: 18px; font-weight: 700; line-height: 1.2; color: var(--brand-heading); }
.saga-tile__text { font-size: 13px; line-height: 18px; }
.saga-tile__cta { margin-top: 8px; min-height: 40px; padding: 0 16px; font-size: 14px; }
@media screen and (min-width: 1000px) { .saga-tile__avatar { width: 104px; height: 104px; } .saga-tile__button { min-height: 300px; } }

.saga-dialog { --saga-text: var(--brand-text, #2a555a); position: fixed; inset: 0; margin: auto; border: 0; padding: 0; width: min(460px, calc(100vw - 24px)); height: min(680px, calc(100dvh - 24px)); display: none; flex-direction: column; border-radius: 18px; background: #fff; color: var(--saga-text); box-shadow: 0 24px 64px rgb(0 0 0 / .28); overflow: hidden; letter-spacing: -0.01em; }
.saga-dialog[open] { display: flex; }
.saga-dialog::backdrop { background: rgb(0 0 0 / .5); }
.saga-dialog [hidden] { display: none !important; }
.saga-dialog__actions { position: absolute; top: 10px; inset-inline-end: 10px; display: flex; gap: 6px; z-index: 2; }
.saga-dialog__close-form { margin: 0; }
.saga-dialog__icon-btn { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%; background: rgb(255 255 255 / .85); color: var(--brand-heading); cursor: pointer; }
.saga-dialog__head { display: flex; align-items: center; gap: 12px; padding: 14px 92px 12px 16px; background: #fff7f0; border-bottom: 1px solid var(--card-border); }
.saga-dialog__avatar { width: 48px; height: 48px; border-radius: 50%; flex: none; }
.saga-dialog__title { margin: 0; font-size: 16px; font-weight: 600; color: var(--brand-heading); }
.saga-dialog__intro { margin: 2px 0 0; font-size: 13px; line-height: 17px; }
.saga-dialog__consent { display: flex; flex-direction: column; gap: 14px; padding: 24px 20px; }
.saga-dialog__consent p { margin: 0; font-size: 14px; line-height: 20px; }
.saga-dialog__small { font-size: 12px !important; opacity: .8; }
.saga-dialog__body { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; }
.saga-dialog__loading { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; font-size: 14px; }
.saga-thread { flex: 1; min-height: 0; overflow-y: auto; padding: 16px 14px 8px; display: flex; flex-direction: column; gap: 10px; scroll-behavior: smooth; }
.saga-bubble { display: flex; align-items: flex-end; gap: 8px; max-width: 92%; }
.saga-bubble--user { align-self: flex-end; flex-direction: row-reverse; }
.saga-bubble__avatar { width: 28px; height: 28px; border-radius: 50%; flex: none; }
.saga-bubble__content { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.saga-bubble__text { padding: 10px 14px; border-radius: 16px 16px 16px 4px; background: #fff7f0; font-size: 14px; line-height: 20px; }
.saga-bubble--user .saga-bubble__text { background: var(--brand-heading); color: #fff; border-radius: 16px 16px 4px 16px; }
.saga-bubble__text p { margin: 0; } .saga-bubble__text p + p { margin-top: 8px; }
.saga-cards { display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x proximity; padding: 2px 2px 4px; margin: -2px -2px 0; }
.saga-cards[hidden] { display: none; }
.saga-card { flex: none; scroll-snap-align: start; width: 128px; height: 212px; display: flex; flex-direction: column; border: 1px solid var(--card-border); border-radius: 12px; background: #fff; overflow: hidden; }
.saga-card:hover, .saga-card:has(:focus-visible) { border-color: var(--brand-heading); }
.saga-card__figure { position: relative; flex: none; }
.saga-card__image-link { display: block; }
.saga-card__image { display: block; width: 100%; height: 96px; object-fit: contain; background: #fff7f0; }
.saga-card__body { flex: 1; min-height: 0; padding: 8px; display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: inherit; }
.saga-card__title { flex: none; min-height: 30px; font-size: 12px; font-weight: 600; line-height: 15px; color: var(--brand-heading); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.saga-card__price { flex: none; font-size: 12px; font-weight: 700; color: #C2560F; }
.saga-card__cta { flex: none; margin-top: auto; padding: 5px 0; border-radius: 999px; background: #ff9e57; color: #fff; font-size: 11px; font-weight: 700; text-align: center; }
.saga-card:hover .saga-card__cta, .saga-card:has(:focus-visible) .saga-card__cta { background: #C2560F; }
/* The overlay heart (.save-book--overlay, global rules) is sized for a full product card; shrink it a touch
   to fit this one's small 96px-tall image without crowding it. */
.saga-card .save-book--overlay { width: 26px; height: 26px; inset-block-end: 4px; inset-inline-end: 4px; }
.saga-bubble__prompts { display: flex; flex-wrap: wrap; gap: 6px; }
.saga-bubble__prompts:empty { display: none; }
.saga-prompt { padding: 6px 12px; border: 1px solid var(--brand-heading); border-radius: 999px; background: #fff; color: var(--brand-heading); font-size: 13px; font-weight: 600; line-height: 1.3; cursor: pointer; }
.saga-prompt:hover, .saga-prompt:focus-visible { background: var(--brand-heading); color: #fff; }
.saga-link { display: block; width: fit-content; max-width: 100%; margin: 6px 0; padding: 0; background: none; color: var(--brand-heading); font-weight: 700; font-size: 14px; text-decoration: underline; text-underline-offset: 2px; }
.saga-link:hover { color: #C2560F; }
.saga-bubble.is-pending .saga-bubble__text { display: flex; gap: 4px; padding: 14px; }
.saga-bubble.is-pending span { width: 7px; height: 7px; border-radius: 50%; background: var(--brand-heading); opacity: .35; animation: saga-dot 1.2s infinite; }
.saga-bubble.is-pending span:nth-child(2) { animation-delay: .2s; } .saga-bubble.is-pending span:nth-child(3) { animation-delay: .4s; }
@keyframes saga-dot { 0%, 80%, 100% { opacity: .35; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-3px); } }
.saga-faq { margin: 0 14px; padding: 8px 0; border-top: 1px solid var(--card-border); }
.saga-faq[hidden] { display: none; }
.saga-faq__summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 5px; font-size: 13px; font-weight: 600; color: var(--brand-heading); }
.saga-faq__summary::-webkit-details-marker { display: none; }
.saga-faq__summary::after { content: '▾'; font-size: 10px; transition: transform .15s ease; }
.saga-faq[open] .saga-faq__summary::after { transform: rotate(180deg); }
.saga-faq__list { display: flex; flex-direction: column; gap: 5px; margin-top: 8px; max-height: 150px; overflow-y: auto; }
.saga-faq__item { text-align: left; padding: 8px 11px; border: 1px solid var(--card-border); border-radius: 10px; background: #fff; color: var(--brand-text); font: inherit; font-size: 13px; cursor: pointer; }
.saga-faq__item:hover, .saga-faq__item:focus-visible { background: #fff7f0; border-color: var(--brand-heading); }
.saga-compose { display: flex; align-items: flex-end; gap: 8px; margin: 0; padding: 8px 12px; border-top: 1px solid var(--card-border); }
.saga-compose__input { flex: 1; resize: none; min-height: 44px; max-height: 120px; padding: 11px 14px; border: 1px solid var(--card-border); border-radius: 22px; font: inherit; font-size: 16px; line-height: 20px; color: var(--brand-text); background: #fff; }
.saga-compose__input:focus { outline: 2px solid var(--brand-heading); outline-offset: 1px; }
.saga-compose__send { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border: 0; border-radius: 50%; background: var(--brand-heading); color: #fff; cursor: pointer; }
.saga-compose__send:disabled { opacity: .5; cursor: default; }
.saga-dialog__body .saga-dialog__small { margin: 0; padding: 0 14px 10px; }
@media screen and (max-width: 600px) { .saga-dialog { width: 100vw; height: 100dvh; max-height: none; border-radius: 0; } }

/* Find a bookshop (sections/stockist-hero, stockist-finder, stockist-suggest, stockist-join;
   snippet stockist-form-thanks-script). Buttons are the theme .button; map is Leaflet (loaded by stockist-finder). */
.stockist-hero { background: #fff7f0; color: var(--brand-text); }
.stockist-hero__inner { display: grid; gap: var(--spacing-8); padding-block: var(--spacing-10) var(--spacing-10); }
.stockist-hero__title { margin-block: var(--spacing-2) var(--spacing-4); }
.stockist-hero__lede { max-width: 38rem; font-size: 1.0625rem; margin: 0; }
.stockist-hero__actions { display: flex; flex-wrap: wrap; gap: var(--spacing-3); margin-block-start: var(--spacing-6); }
.stockist-hero__side { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--spacing-3); align-content: end; }
.stockist-hero__stat { display: flex; flex-direction: column; background: #fff; border-radius: 16px; padding: 16px 18px; box-shadow: 0 2px 8px rgb(86 86 86 / .1); }
.stockist-hero__stat-number { font-family: var(--heading-font-family); font-size: 1.875rem; line-height: 1.2; font-weight: 500; color: var(--brand-heading); }
.stockist-hero__stat-label { font-size: .8125rem; color: var(--brand-text); }
.stockist-hero__tile { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #1d3f43; color: #fff; border-radius: 16px; padding: 16px 20px; font-size: .875rem; line-height: 1.4; text-decoration: none; }
.stockist-hero__tile:hover { color: #fff; filter: brightness(1.15); }
.stockist-hero__tile-link { color: #ffb37d; font-weight: 600; white-space: nowrap; }
@media screen and (min-width: 1000px) {
  .stockist-hero__inner { grid-template-columns: minmax(0, 1fr) 380px; align-items: end; gap: var(--spacing-16); padding-block: var(--spacing-14) var(--spacing-12); }
}

.stockist-finder { padding-block: var(--spacing-8) var(--spacing-12); }
.stockist-finder__grid { display: grid; gap: var(--spacing-4); grid-template-areas: "controls" "map" "list"; }
.stockist-finder__controls { grid-area: controls; display: flex; flex-direction: column; gap: var(--spacing-3); }
.stockist-finder__label { display: block; font-size: .8125rem; font-weight: 600; color: var(--brand-text); margin-block-end: 6px; }
.stockist-finder__search-row { display: flex; gap: 8px; }
.stockist-finder__search-row .input { flex: 1 1 auto; min-width: 0; }
.stockist-finder__locate { flex: 0 0 48px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; border: 1.5px solid var(--card-border, #d6e6e7); background: #fff; color: var(--brand-heading); cursor: pointer; }
.stockist-finder__locate:hover { border-color: var(--brand-heading); }
.stockist-finder__chips { display: flex; flex-wrap: wrap; gap: 8px; }
.stockist-chip { min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--card-border, #d6e6e7); background: #fff; color: var(--brand-text); font: inherit; font-size: .875rem; font-weight: 600; cursor: pointer; }
.stockist-chip span { opacity: .75; font-weight: 400; margin-inline-start: 2px; }
.stockist-chip[aria-pressed="true"] { background: #237a74; border-color: #237a74; color: #fff; }
.stockist-finder__count { margin: 0; font-size: .8125rem; color: var(--brand-text); }
.stockist-finder__list-wrap { grid-area: list; }
.stockist-finder__list { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
.stockist-row { border: 1.5px solid var(--card-border, #d6e6e7); border-radius: 16px; background: #fff; transition: border-color .15s ease, background-color .15s ease; }
.stockist-row.is-selected { border-color: var(--brand-heading); background: #eaf4f4; }
.stockist-row__select { display: block; width: 100%; text-align: start; padding: 14px 16px 6px; background: none; border: 0; font: inherit; color: inherit; cursor: pointer; }
.stockist-row__top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.stockist-row__name { font-weight: 600; color: #1d3f43; line-height: 1.35; }
.stockist-row__region { flex: 0 0 auto; font-size: .6875rem; font-weight: 600; color: #fff; background: #237a74; border-radius: 10px; padding: 2px 8px; }
.stockist-row__address { display: block; font-size: .8125rem; margin-block-start: 2px; }
.stockist-row__distance { display: inline-block; margin-block-start: 4px; font-size: .75rem; font-weight: 600; color: #a8612e; }
.stockist-row__links { display: flex; gap: 16px; padding: 0 16px 12px; font-size: .8125rem; font-weight: 600; }
.stockist-row__links a { color: var(--brand-heading); }
.stockist-finder__empty { border: 1.5px dashed #a8612e; border-radius: 16px; padding: 18px; background: #fff7f0; }
.stockist-finder__empty-title { font-weight: 600; color: #1d3f43; margin: 0 0 4px; }
.stockist-finder__empty p { margin: 0 0 10px; font-size: .875rem; }
.stockist-finder__map { grid-area: map; position: relative; border-radius: 16px; overflow: hidden; background: #eaf4f4; min-height: 360px; box-shadow: 0 18px 50px rgb(86 86 86 / .1); isolation: isolate; }
.stockist-finder__map-canvas { position: absolute; inset: 0; background: #eaf4f4; }
.stockist-finder--no-map .stockist-finder__map { display: none; }
.stockist-finder__legend { position: absolute; z-index: 500; top: 12px; right: 12px; display: flex; flex-wrap: wrap; gap: 6px 14px; background: #fff; border-radius: 12px; padding: 6px 12px; font-size: .75rem; color: var(--brand-text); box-shadow: 0 2px 8px rgb(86 86 86 / .12); pointer-events: none; }
.stockist-finder__legend > span { display: inline-flex; align-items: center; gap: 6px; }
.stockist-marker { background: none; border: 0; }
.stockist-pin { display: block; width: 16px; height: 16px; margin: 6px; border-radius: 50%; background: #237a74; border: 2.5px solid #fff; box-shadow: 0 2px 8px rgb(29 63 67 / .4); box-sizing: border-box; transition: transform .15s ease; }
.stockist-marker:hover .stockist-pin { transform: scale(1.2); }
.stockist-marker.is-selected .stockist-pin { width: 26px; height: 26px; margin: 1px; background: rgb(var(--accent)); border-width: 3px; }
.stockist-marker.is-dimmed { opacity: .25; }
.stockist-pin--legend { width: 12px; height: 12px; margin: 0; border-width: 2px; }
.stockist-pin--invite { display: grid; place-items: center; width: 22px; height: 22px; margin: 3px; background: #fff7f0; border: 2px dashed #a8612e; box-shadow: none; color: #a8612e; font-size: 15px; font-weight: 700; line-height: 1; }
.stockist-pin--invite.stockist-pin--legend { width: 12px; height: 12px; margin: 0; font-size: 0; }
.stockist-invite-label { display: none; position: absolute; top: 30px; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 11px; font-weight: 600; color: #a8612e; background: #fff; border-radius: 10px; padding: 2px 8px; box-shadow: 0 2px 8px rgb(86 86 86 / .12); }
.stockist-card { position: absolute; z-index: 600; left: 12px; right: 12px; bottom: 12px; max-width: 400px; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 5px 30px rgb(86 86 86 / .2); }
.stockist-card[hidden] { display: none; }
.stockist-card__photo { display: none; }
.stockist-card__photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
.stockist-card__body { position: relative; padding: 14px 16px 16px; }
.stockist-card__close { position: absolute; top: 6px; right: 6px; width: 40px; height: 40px; border: 0; background: none; font-size: 22px; line-height: 1; color: var(--brand-text); cursor: pointer; }
.stockist-card__name { margin: 0 32px 2px 0; font-family: var(--heading-font-family); font-size: 1.125rem; font-weight: 500; line-height: 1.35; color: var(--brand-heading); }
.stockist-card__address { margin: 0 0 4px; font-size: .875rem; }
.stockist-card__note { margin: 0 0 12px; font-size: .8125rem; color: var(--brand-text); }
.stockist-card__actions { display: flex; flex-wrap: wrap; gap: 8px; }
.stockist-card__actions [hidden] { display: none; }
.stockist-finder .leaflet-container { font-family: var(--text-font-family); }
.stockist-finder .leaflet-control-zoom a { width: 36px; height: 36px; line-height: 36px; color: var(--brand-heading); }
@media screen and (min-width: 700px) {
  .stockist-finder__map { min-height: 460px; }
  .stockist-card__photo:not([hidden]) { display: block; height: 130px; }
}
@media screen and (min-width: 1000px) {
  .stockist-finder { padding-block: var(--spacing-12) var(--spacing-16); }
  .stockist-finder__grid { grid-template-columns: minmax(320px, 420px) minmax(0, 1fr); grid-template-rows: auto 1fr; grid-template-areas: "controls map" "list map"; column-gap: var(--spacing-6); }
  .stockist-finder__map { min-height: 660px; }
  .stockist-finder__list-wrap { max-height: 520px; overflow-y: auto; padding-inline-end: 4px; }
  .stockist-card { right: auto; left: 16px; bottom: 16px; width: min(400px, calc(100% - 32px)); }
}

.stockist-suggest { background: #eaf4f4; color: var(--brand-text); }
.stockist-suggest__inner { display: grid; gap: var(--spacing-5); padding-block: var(--spacing-8); align-items: center; }
.stockist-suggest__text p { margin: var(--spacing-2) 0 0; }
.stockist-suggest__fields { display: grid; gap: 10px; }
.stockist-suggest__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-block-start: 12px; }
.stockist-suggest__form.is-sent .stockist-suggest__fields, .stockist-suggest__form.is-sent button[type="submit"] { display: none; }
.stockist-form-thanks { margin: 0 0 10px; padding: 12px 16px; border-radius: 12px; background: #fff; color: #1d3f43; font-weight: 600; }
.stockist-form-error { margin: 0 0 12px; padding: 10px 14px; border-radius: 12px; background: #fdecec; color: #a3201f; font-size: .875rem; }
@media screen and (min-width: 1000px) {
  .stockist-suggest__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: var(--spacing-12); padding-block: var(--spacing-10); }
  .stockist-suggest__fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

.stockist-join { --heading-color: 255 255 255; background: #1d3f43; color: #e6f0f0; padding-block: var(--spacing-12) var(--spacing-14); }
.stockist-join .subheading { --eyebrow-color: #ffb37d; }
.stockist-join h2, .stockist-join h3 { color: #fff; }
.stockist-join__head { max-width: 46rem; }
.stockist-join__intro { font-size: 1.0625rem; margin: var(--spacing-3) 0 0; }
.stockist-join__benefits { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin: var(--spacing-8) 0 0; padding: 0; list-style: none; }
.stockist-join__benefit { background: #2a555a; border-radius: 16px; padding: 22px; }
.stockist-join__benefit svg { color: rgb(var(--accent)); }
.stockist-join__benefit-title { margin: 12px 0 6px; font-size: 1.0625rem; font-weight: 500; }
.stockist-join__benefit p { margin: 0; font-size: .875rem; }
.stockist-join__photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: var(--spacing-8) 0 0; padding: 0; list-style: none; }
.stockist-join__photo { position: relative; aspect-ratio: 4 / 3; border-radius: 16px; overflow: hidden; background: #2a555a; }
.stockist-join__photo img { width: 100%; height: 100%; object-fit: cover; }
.stockist-join__caption { position: absolute; left: 10px; bottom: 10px; font-size: .75rem; color: #1d3f43; background: #fff; border-radius: 10px; padding: 2px 8px; }
.stockist-join__bottom { display: grid; gap: var(--spacing-10); margin-block-start: var(--spacing-12); }
.stockist-join__step-list { list-style: none; margin: var(--spacing-5) 0 0; padding: 0; display: flex; flex-direction: column; gap: 20px; }
.stockist-join__step-list li { display: flex; gap: 14px; font-size: .875rem; }
.stockist-join__step-list strong { display: block; color: #fff; font-size: 1rem; font-weight: 500; }
.stockist-join__step-num { flex: 0 0 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: rgb(var(--accent)); color: #1d3f43; font-weight: 700; }
.stockist-join__email { margin-block-start: var(--spacing-6); font-size: .875rem; }
.stockist-join__email a { color: #ffb37d; font-weight: 600; }
.stockist-join__form-card { --heading-color: var(--brand-heading-rgb); background: #fff; color: var(--brand-text); border-radius: 16px; padding: 24px 18px; }
.stockist-join__form-card h3 { color: var(--brand-heading); margin: 0; }
.stockist-join__required { margin: 4px 0 16px; font-size: .8125rem; }
.stockist-join__grid { display: grid; gap: 12px; margin-block-end: 12px; }
.stockist-join__submit { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-block-start: 16px; font-size: .75rem; }
.stockist-join__submit span { flex: 1 1 200px; }
.stockist-join__form.is-sent .stockist-join__form-fields { display: none; }
.stockist-form-thanks--large { text-align: center; padding: 28px 8px; background: none; font-weight: 400; color: var(--brand-text); }
.stockist-form-thanks--large svg { color: var(--brand-heading); }
.stockist-form-thanks--large .h5 { color: var(--brand-heading); margin: 8px 0 4px; }
@media screen and (min-width: 700px) {
  .stockist-join__photos { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .stockist-join__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stockist-join__form-card { padding: 32px; }
}
@media screen and (min-width: 1000px) {
  .stockist-join { padding-block: var(--spacing-16); }
  .stockist-join__bottom { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--spacing-14); }
}
.stockist-marker--invite:hover .stockist-invite-label, .stockist-marker--invite:focus .stockist-invite-label { display: block; }
.stockist-marker--invite:hover { z-index: 2000 !important; }
@media (prefers-reduced-motion: reduce) { .stockist-pin, .stockist-row { transition: none; } }

/* ---------------------------- */
/* HELP PAGES                   */
/* ---------------------------- */
/* Help centre, quick fixes, player guide, delivery and returns, FAQ, contact (briefs/help-pages.md).
   Sections: help-hero, help-cards, help-topic, help-contact, quick-fixes, player-lights; snippets player-light-icon,
   help-icon. Buttons are the theme .button. Tint = the light teal of the design canvas "Quick fixes page mockup".
   --led-* are the real colours of the player's lights (a fact about the product, not a style): one place for all. */
:root {
  --help-tint: #eaf4f4;
  --led-off: #cfd8d8;
  --led-blue: #3f8fe0;
  --led-blue-dim: #8fb8e8;
  --led-green: #4faa54;
  --led-orange: #f39545;
  --led-pink: #d94bb4;
  --led-yellow-green: #a6c93a;
  --led-red: #ef4a31;
}
.help-band--tinted { background: var(--help-tint); }
.help-hero, .help-cards, .help-topic, .help-contact, .player-lights { color: var(--brand-text); }
.help-hero h1, .help-cards h2, .help-topic h2, .help-topic h3, .help-contact h2, .player-lights h2, .player-lights h3,
.qf h2, .qf h3 { color: var(--brand-heading); margin: 0; }

/* Numbered steps: orange numbers (state steps from a textarea, restart steps from rich text) */
.help-steps ol, ol.help-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; counter-reset: help-step; }
/* number placed beside the text (not flex), so bold or linked words stay inside the sentence */
.help-steps li { counter-increment: help-step; position: relative; min-height: 28px; padding-left: 40px; line-height: 1.6; margin: 0; }
.help-steps li::before { content: counter(help-step); position: absolute; left: 0; top: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--accent-strong); color: rgb(var(--accent-strong-text)); font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; margin-top: 1px; }
.help-steps--grid ol { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; }

/* HERO */
.help-hero { background: var(--help-tint); }
.help-hero__inner { display: flex; flex-direction: column; align-items: center; gap: var(--spacing-3); text-align: center; padding-block: var(--spacing-8) var(--spacing-8); }
.help-hero--joined .help-hero__inner { padding-block-end: 0; }
.help-hero__trail { align-self: flex-start; display: flex; gap: 6px; font-size: var(--text-sm); }
.help-hero__trail a { color: var(--brand-heading); }
.help-hero__intro { max-width: 38rem; font-size: 1.0625rem; line-height: 1.6; }
.help-hero__intro p { margin: 0; }
.help-hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--spacing-3); margin-block-start: var(--spacing-2); }
.help-hero__saga { display: inline-flex; align-items: center; gap: 10px; }
.help-hero__saga-avatar { width: 28px; height: 28px; flex: 0 0 auto; }
.help-hero__jump { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px 12px; margin-block-start: var(--spacing-3); font-size: var(--text-sm); }
.help-hero__jump-label { font-weight: 600; }
.help-hero__jump ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
.help-hero__jump a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; border-radius: 999px; background: #fff; border: 1px solid var(--card-border); color: var(--brand-heading); font-weight: 500; text-decoration: none; }
.help-hero__jump a:hover { border-color: var(--brand-heading); }
@media screen and (min-width: 1000px) {
  .help-hero__inner { padding-block: var(--spacing-10) var(--spacing-10); }
}

/* CARDS */
.help-cards { padding-block: var(--spacing-10); }
.help-cards__inner { display: flex; flex-direction: column; gap: var(--spacing-5); }
.help-cards__head { display: flex; flex-direction: column; gap: var(--spacing-2); max-width: 46rem; }
.help-cards__intro p, .help-cards__footnote p { margin: 0; }
.help-cards__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
.help-card { display: flex; gap: 14px; align-items: flex-start; padding: 18px 20px; border: 1px solid var(--card-border); border-radius: 12px; background: #fff; color: var(--brand-text); text-align: start; font: inherit; text-decoration: none; min-height: 44px; }
.help-card--link { cursor: pointer; transition: border-color .15s ease, box-shadow .15s ease; }
.help-card--link:hover, .help-card--link:focus-visible { border-color: var(--brand-heading); box-shadow: 0 5px 20px rgb(86 86 86 / .1); color: var(--brand-text); }
.help-card__body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.help-card__title { font-size: 1rem; font-weight: 500; color: var(--brand-heading); }
.help-card__text { font-size: .875rem; line-height: 1.5; }
.help-card__icon { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--help-tint); color: var(--brand-heading); }
.help-card__icon svg { width: 24px; height: 24px; }
.help-card__icon .accent { stroke: var(--eyebrow-color); }
.help-cards--tiles .help-cards__grid { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
.help-cards--tiles .help-card { flex-direction: column; padding: 24px; border-radius: 16px; }
.help-cards--tiles .help-card__title { font-size: 1.125rem; }
.help-cards--tiles .help-card__text { font-size: .9375rem; line-height: 1.6; }
.help-band--tinted .help-card { border-color: transparent; }
@media screen and (max-width: 699px) {
  .help-cards--tiles .help-card { flex-direction: row; padding: 18px; }
}

/* TOPIC */
.help-topic { padding-block: var(--spacing-10); scroll-margin-top: var(--sticky-area-height, 0px); }
.help-topic + .help-topic:not(.help-band--tinted) { padding-block-start: 0; }
.help-topic__inner { display: grid; gap: var(--spacing-8); align-items: center; }
.help-topic__text { display: flex; flex-direction: column; gap: var(--spacing-4); max-width: 46rem; }
.help-topic__eyebrow { margin: 0; font-size: var(--text-sm); font-weight: 600; color: var(--eyebrow-color); }
.help-topic__content > :first-child { margin-top: 0; }
.help-topic__content > :last-child { margin-bottom: 0; }
.help-topic__note { background: #fff7f0; border-radius: 12px; padding: 14px 18px; font-size: .9375rem; line-height: 1.6; }
.help-band--tinted .help-topic__note { background: #fff; }
.help-topic__note p { margin: 0; }
.help-topic__note p + p { margin-top: 8px; }
.help-topic__table { width: 100%; border-collapse: collapse; font-size: .9375rem; }
.help-topic__table th, .help-topic__table td { text-align: start; padding: 10px 12px; border-bottom: 1px solid var(--card-border); vertical-align: top; }
.help-topic__table thead th { font-size: var(--text-sm); color: var(--brand-heading); }
.help-topic__table tbody th { font-weight: 500; }
.help-topic__links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0; }
.help-topic__links a { font-weight: 500; color: var(--brand-heading); }
.help-topic__files { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
.help-topic__file { display: flex; gap: 14px; align-items: center; padding: 12px; border: 1px solid var(--card-border); border-radius: 12px; background: #fff; color: var(--brand-text); text-decoration: none; }
.help-topic__file:hover { border-color: var(--brand-heading); color: var(--brand-text); }
.help-topic__file img { width: 72px; height: 72px; object-fit: contain; flex: 0 0 auto; }
.help-topic__file-text { display: flex; flex-direction: column; gap: 2px; font-size: .875rem; line-height: 1.5; }
.help-topic__file-title { font-weight: 500; font-size: 1rem; color: var(--brand-heading); }
.help-topic__file-link { font-weight: 600; color: var(--brand-heading); text-decoration: underline; }
.help-topic__media img { width: 100%; height: auto; border-radius: 16px; }
@media screen and (min-width: 1000px) {
  .help-topic--media .help-topic__inner { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--spacing-14); }
  .help-topic--media-start .help-topic__media { order: -1; }
  .help-topic--media-start .help-topic__inner { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
}

/* CONTACT BAND */
.help-contact { padding-block: var(--spacing-4) var(--spacing-12); }
.help-contact__card { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; border: 1px solid var(--card-border); border-radius: 16px; padding: 28px; }
.help-contact__text { flex: 1 1 420px; display: flex; flex-direction: column; gap: 8px; }
.help-contact__text p { margin: 0; }

/* LIGHT ICONS (snippets/player-light-icon) */
.player-light-icon { flex: 0 0 auto; }
.player-light-icon__ring { fill: color-mix(in srgb, var(--icon-led) 33%, #fff); stroke: var(--icon-led); stroke-width: 2.5; }
.player-light-icon.is-off .player-light-icon__ring { fill: #fff; stroke: #8a9a9b; stroke-dasharray: 3 2.5; }
.player-light-icon__arrow { fill: var(--brand-text); }
.player-light-icon__case { fill: #fff; stroke: var(--brand-text); stroke-width: 1.5; }
.player-light-icon.is-off .player-light-icon__case { stroke: #8a9a9b; stroke-dasharray: 3 2.5; }
.player-light-icon__tip { fill: var(--brand-text); }

/* Light movements: the quick-fixes player always shows the chosen light's; icons only under the pointer. Never with
   reduced motion. */
@keyframes led-blink { 0%, 100% { opacity: 1; } 50% { opacity: .1; } }
@keyframes led-fast { 0%, 100% { opacity: 1; } 50% { opacity: .05; } }
@keyframes led-pulse { 0%, 100% { opacity: .25; } 50% { opacity: .9; } }
@keyframes led-flash { 0%, 70%, 100% { opacity: .05; } 10%, 40% { opacity: 1; } }
@keyframes led-fade { 0%, 75% { opacity: 1; } 100% { opacity: .05; } }
@media (hover: hover) and (prefers-reduced-motion: no-preference) {
  .qf-host:hover .qf-anim--blink { animation: led-blink 1s ease-in-out infinite; }
  .qf-host:hover .qf-anim--fast { animation: led-fast .25s linear infinite; }
  .qf-host:hover .qf-anim--pulse { animation: led-pulse 5s ease-in-out infinite; }
  .qf-host:hover .qf-anim--flash { animation: led-flash 2s ease-out infinite; }
  .qf-host:hover .qf-anim--fade { animation: led-fade 4s ease-in-out infinite; }
}
@media (prefers-reduced-motion: no-preference) {
  .qf-player[data-play-anim="blink"] .qf-player__glow, .qf-player[data-strip-anim="blink"] .qf-player__strip { animation: led-blink 1s ease-in-out infinite; }
  .qf-player[data-play-anim="fast"] .qf-player__glow, .qf-player[data-strip-anim="fast"] .qf-player__strip { animation: led-fast .25s linear infinite; }
  .qf-player[data-play-anim="pulse"] .qf-player__glow, .qf-player[data-strip-anim="pulse"] .qf-player__strip { animation: led-pulse 5s ease-in-out infinite; }
  .qf-player[data-play-anim="flash"] .qf-player__glow, .qf-player[data-strip-anim="flash"] .qf-player__strip { animation: led-flash 2s ease-out infinite; }
  .qf-player[data-play-anim="fade"] .qf-player__glow, .qf-player[data-strip-anim="fade"] .qf-player__strip { animation: led-fade 4s ease-in-out infinite; }
}

/* QUICK FIXES (sections/quick-fixes; script in voxblock.js) */
.qf { color: var(--brand-text); }
.qf-top { background: var(--help-tint); padding-block: var(--spacing-6) var(--spacing-10); }
.qf-layout { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--spacing-6) var(--spacing-8); }
.qf-col { min-width: 0; }
.qf-col--player { flex: 1 1 440px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
.qf-col--answer { flex: 1 1 420px; scroll-margin-top: calc(var(--sticky-area-height, 0px) + 16px); }

.qf-player { width: 240px; height: 360px; box-sizing: border-box; background: #fff; border: 1px solid var(--card-border); border-radius: 32px; box-shadow: 0 18px 50px rgb(86 86 86 / .12); padding: 20px 22px 18px; display: flex; flex-direction: column; align-items: center; gap: 16px; }
.qf-player__grill { display: flex; flex-direction: column; gap: 4px; align-items: center; }
.qf-player__grill span { display: block; width: 64px; height: 3px; border-radius: 2px; background: var(--card-border); }
.qf-player__grill span:nth-child(2) { width: 72px; }
.qf-player__dock { width: 164px; height: 186px; border-radius: 16px; background: var(--card-media-bg); border: 1px solid var(--card-border); display: flex; align-items: center; justify-content: center; }
.qf-player__book { width: 128px; height: 150px; border-radius: 10px; background: #237a74; display: flex; align-items: flex-end; padding: 12px; box-sizing: border-box; color: #fff; font-size: 12px; font-weight: 500; }
.qf-player[data-book="false"] .qf-player__book { visibility: hidden; }
.qf-player__keys { display: flex; align-items: center; gap: 10px; color: var(--brand-text); }
.qf-key { position: relative; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; width: 36px; height: 36px; border-radius: 50%; background: #fff; border: 1.5px solid var(--card-border); }
.qf-key--left, .qf-key--right { width: 30px; height: 30px; }
.qf-key--play { width: 52px; height: 52px; background: transparent; }
.qf-key svg { position: relative; }
.qf-player__glow { position: absolute; inset: 0; border-radius: 50%; box-sizing: border-box; background: color-mix(in srgb, var(--qf-play) 25%, #fff); border: 3px solid var(--qf-play); box-shadow: 0 0 14px 4px color-mix(in srgb, var(--qf-play) 60%, transparent); }
.qf-player[data-play-led="off"] .qf-player__glow { background: #fff; border-color: transparent; box-shadow: none; }
/* the buttons to press, outlined in a deep orange */
.qf-player[data-press~="play"] .qf-key--play, .qf-player[data-press~="left"] .qf-key--left, .qf-player[data-press~="right"] .qf-key--right,
.qf-player[data-press~="minus"] .qf-key--minus, .qf-player[data-press~="plus"] .qf-key--plus { outline: 3px solid var(--accent-strong-dark); outline-offset: 3px; }
.qf-player__strip-row { align-self: stretch; display: flex; justify-content: flex-end; padding-right: 8px; }
.qf-player__strip { display: block; width: 22px; height: 5px; border-radius: 3px; background: var(--qf-strip); box-shadow: 0 0 8px 2px color-mix(in srgb, var(--qf-strip) 55%, transparent); }
.qf-player[data-strip-led="off"] .qf-player__strip { box-shadow: none; }

/* Photo of the player (Files: quick-fixes-player-front.webp, 642 × 1022). Book, buttons and battery light are placed
   by % of the photo, measured from it: change these if the photo changes. */
.qf-player--photo { position: relative; display: block; width: 240px; height: auto; aspect-ratio: 642 / 1022; padding: 0; background: none; border: 0; border-radius: 0; box-shadow: none; }
.qf-player--photo .qf-player__photo { display: block; width: 100%; height: auto; filter: drop-shadow(0 16px 24px rgb(86 86 86 / .16)); }
.qf-player--photo .qf-player__book { position: absolute; left: 20.7%; top: 16.3%; width: 58.3%; height: auto; aspect-ratio: 450 / 660; padding: 0; border-radius: 7%; background: #237a74; overflow: visible; }
.qf-player--photo .qf-player__book:has(img) { background: none; }
.qf-player--photo .qf-player__book img { display: block; width: 100%; height: auto; filter: drop-shadow(0 3px 4px rgb(0 0 0 / .18)); }
/* centred on the button with margins, not transform: a transform would stop the glow below blending with the photo */
.qf-player--photo .qf-key { --qf-key: 11%; position: absolute; top: 84.7%; width: var(--qf-key); height: auto; aspect-ratio: 1; margin: calc(var(--qf-key) / -2) 0 0 calc(var(--qf-key) / -2); background: none; border: 0; }
.qf-player--photo .qf-key--left { --qf-key: 6.6%; left: 19%; }
.qf-player--photo .qf-key--minus { left: 32.2%; }
.qf-player--photo .qf-key--play { --qf-key: 16%; left: 49.4%; }
.qf-player--photo .qf-key--plus { left: 66.4%; }
.qf-player--photo .qf-key--right { --qf-key: 6.8%; left: 79.4%; }
/* no outlines on the photo: next to the real lights they read as another light (the caption says what to press) */
.qf-player--photo[data-press] .qf-key { outline: none; }
/* the play button lit: the colour tints the button (multiply keeps the arrow showing through) and glows around it */
.qf-player--photo .qf-player__glow { background: color-mix(in srgb, var(--qf-play) 38%, #fff); border: 0; box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--qf-play) 70%, #fff), 0 0 12px 4px color-mix(in srgb, var(--qf-play) 55%, transparent); mix-blend-mode: multiply; }
/* charging cable: USB-C port on the bottom edge, below the battery light (player_charging_graphic in Files) */
.qf-player--photo .qf-player__cable { position: absolute; left: 79.4%; top: 99.6%; width: 16%; height: auto; margin-left: -8%; visibility: hidden; }
.qf-player--photo[data-cable="true"] { margin-bottom: 64px; }
.qf-player--photo[data-cable="true"] .qf-player__cable { visibility: visible; }
.qf-player--photo .qf-player__strip { position: absolute; left: 79.4%; top: 93.6%; width: 8%; height: auto; aspect-ratio: 4 / 1; transform: translateX(-50%); }
@media screen and (min-width: 1000px) {
  .qf-player--photo { width: 280px; }
  .qf-player--photo[data-cable="true"] { margin-bottom: 76px; }
}

.qf-caption { margin: 0; font-size: 13px; line-height: 1.5; text-align: center; max-width: 280px; }
.qf-jump { display: none; align-items: center; gap: 6px; min-height: 44px; font-size: 1rem; font-weight: 500; color: var(--brand-heading); }
.qf-footnote { margin: 0 0 var(--spacing-2); font-size: 12px; line-height: 1.5; text-align: center; max-width: 320px; }
.qf-footnote a { color: var(--brand-heading); }
.qf-row { align-self: stretch; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.qf-row__title { font-size: 15px; font-weight: 600; text-align: center; color: var(--brand-text) !important; font-family: inherit; letter-spacing: normal; }
.qf-chips { display: flex; flex-wrap: nowrap; gap: 10px; overflow-x: auto; padding: 4px 4px 10px; justify-content: safe center; scrollbar-width: thin; }
.qf-chip { flex: 0 0 auto; white-space: nowrap; display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 18px; border-radius: 999px; background: #fff; border: 2px solid var(--card-border); color: var(--brand-text); font-size: 15px; font-weight: 500; text-decoration: none; }
.qf-chip:hover { border-color: var(--brand-heading); color: var(--brand-text); }
.qf-chip[aria-current="true"] { background: var(--help-tint); border-color: var(--brand-heading); }
.qf-top .qf-chip[aria-current="true"] { background: #fff; box-shadow: 0 0 0 1px var(--brand-heading); }
.qf-chip:focus-visible, .qf-tile:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }

.qf-answer { border: 1px solid var(--card-border); border-radius: 16px; box-shadow: 0 5px 30px rgb(86 86 86 / .1); padding: 32px clamp(20px, 4vw, 40px); display: flex; flex-direction: column; gap: 18px; background: #fff; scroll-margin-top: calc(var(--sticky-area-height, 0px) + 16px); }
.qf-answer + .qf-answer { margin-top: var(--spacing-4); }
.qf.is-ready .qf-answer:not(.is-active) { display: none; }
.qf.is-ready .qf-answer + .qf-answer { margin-top: 0; }
.qf-answer__eyebrow { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 13px; font-weight: 600; }
.qf-answer__meaning { margin: 0; line-height: 1.6; }
.qf-answer__fix { display: flex; flex-direction: column; gap: 12px; }
.qf-answer__done { display: flex; gap: 10px; align-items: center; margin: 0; background: var(--help-tint); border-radius: 12px; padding: 12px 16px; font-size: .875rem; }
.qf-answer__done svg { color: var(--brand-heading); flex: 0 0 auto; }
.qf-answer__more { align-self: flex-start; font-weight: 500; color: var(--brand-heading); }

.qf-more { display: flex; flex-direction: column; gap: var(--spacing-10); padding-block: var(--spacing-10) var(--spacing-6); }
.qf-glance { display: flex; flex-direction: column; gap: var(--spacing-5); }
.qf-glance__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
.qf-tile { display: flex; flex-direction: column; gap: 8px; padding: 16px; border-radius: 12px; background: #fff; border: 2px solid var(--card-border); color: var(--brand-text); text-decoration: none; }
.qf-tile:hover { border-color: var(--brand-heading); color: var(--brand-text); }
.qf-tile[aria-current="true"] { border-color: var(--brand-heading); }
.qf-tile__eyebrow { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; }
.qf-tile__title { font-size: .9375rem; font-weight: 500; color: var(--brand-heading); }
.qf-tile__text { font-size: 13px; line-height: 1.5; }
.qf-note { border: 1px dashed #9fb9ba; border-radius: 16px; padding: 24px 28px; display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; }
.qf-note h2 { flex: 0 0 auto; }
.qf-note p { margin: 0; flex: 1 1 480px; line-height: 1.6; }
.qf-restart { display: flex; flex-direction: column; gap: var(--spacing-4); scroll-margin-top: calc(var(--sticky-area-height, 0px) + 16px); }
.qf-restart__intro { max-width: 46rem; line-height: 1.6; }
.qf-restart__intro p { margin: 0; }
.qf-restart__card { border: 1px solid var(--card-border); border-radius: 16px; padding: 28px; display: flex; flex-direction: column; gap: 20px; background: #fff7f0; }
.qf-timeline { display: flex; align-items: stretch; min-height: 56px; border-radius: 12px; overflow: hidden; border: 1px solid var(--card-border); background: #fff; font-size: 13px; font-weight: 600; }
.qf-timeline > span { display: flex; align-items: center; padding: 6px 10px; }
.qf-timeline__a { flex: 3 0 auto; white-space: nowrap; justify-content: center; text-align: center; background: var(--led-blue); color: #fff; }
.qf-timeline__b { flex: 27 1 0; background: var(--help-tint); border-left: 2px solid #fff; font-weight: 500; }
.qf-timeline__c { flex: 0 0 auto; white-space: nowrap; background: var(--accent-strong); color: rgb(var(--accent-strong-text)); }

.qf-earlier__inner { display: flex; flex-direction: column; gap: var(--spacing-6); padding-block: var(--spacing-8) var(--spacing-10); }
.qf-earlier__head { display: flex; flex-direction: column; gap: 8px; }
.qf-earlier__head p, .qf-earlier__back { margin: 0; max-width: 46rem; }
.qf-earlier__back a { color: var(--brand-heading); }
.qf-earlier__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
.qf-earlier__card { border: 1px solid var(--card-border); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 10px; }
.qf-earlier__card ol { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; line-height: 1.6; }
.qf-earlier__card p { margin: 0; line-height: 1.6; }
/* With the script running, show one model at a time (without it, both show, current first) */
.qf.is-ready .qf-earlier__back { display: block; }
.qf:not(.is-ready) .qf-earlier__back { display: none; }
.qf.is-ready[data-model="current"] .qf-earlier, .qf.is-ready[data-model="earlier"] .qf-current { display: none; }
.qf.is-ready[data-model="earlier"] .qf-earlier { background: var(--help-tint); }

@media screen and (max-width: 999px) {
  .qf-jump { display: inline-flex; }
}
@media screen and (max-width: 699px) {
  .qf-top { padding-block: var(--spacing-4) var(--spacing-8); }
  .qf-chips { justify-content: flex-start; margin-inline: calc(-1 * var(--container-gutter, 20px)); padding-inline: var(--container-gutter, 20px); scroll-padding-inline: var(--container-gutter, 20px); }
  .qf-answer { padding: 24px 20px; }
  .qf-restart__card { padding: 20px; }
  .qf-timeline__b { font-size: 12px; }
}

/* PLAYER LIGHTS (sections/player-lights) */
.player-lights { padding-block: var(--spacing-10); scroll-margin-top: var(--sticky-area-height, 0px); }
.player-lights__inner { display: flex; flex-direction: column; gap: var(--spacing-6); }
.player-lights__head { display: flex; flex-direction: column; gap: var(--spacing-3); max-width: 46rem; }
.player-lights__groups { display: grid; gap: var(--spacing-8); }
.player-lights__group { display: flex; flex-direction: column; gap: var(--spacing-3); }
.player-lights__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
.player-lights__item { display: flex; gap: 14px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid var(--card-border); }
.player-lights__item .player-light-icon { margin-top: 2px; }
.player-lights__text { display: flex; flex-direction: column; gap: 2px; line-height: 1.5; font-size: .9375rem; }
.player-lights__text strong { color: var(--brand-heading); font-weight: 500; }
.player-lights__text a { align-self: flex-start; font-size: .875rem; font-weight: 500; color: var(--brand-heading); }
@media screen and (min-width: 1000px) {
  .player-lights__groups { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--spacing-14); }
}

/* PLAYER OFFER (sections/player-offer): hero or closing band with a buy button for one player variant. Colours come
   from the section background and the theme's buttons; text sizes from the theme's h1/h2 and prose. */
.player-offer { scroll-margin-top: calc(var(--header-height, 0px) + 24px); }
.player-offer__inner { display: grid; gap: var(--spacing-8); align-items: center; }
.player-offer__text { display: flex; flex-direction: column; gap: var(--spacing-4); align-items: flex-start; }
.player-offer__text > * { margin: 0; }
.player-offer__eyebrow + .player-offer__heading { margin-block-start: calc(-1 * var(--spacing-2)); }
.player-offer__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
.player-offer__amount { font-size: 1.75rem; line-height: 1.2; font-weight: 700; color: rgb(var(--heading-color)); }
.player-offer__note { font-size: .9375rem; }
.player-offer__actions { display: flex; flex-wrap: wrap; gap: 12px; width: 100%; }
.player-offer__trust { font-size: .875rem; line-height: 1.5; font-weight: 500; }
.player-offer__image { width: 100%; height: auto; display: block; }
.player-offer--band .player-offer__inner { justify-items: center; text-align: center; }
.player-offer--band .player-offer__text { align-items: center; }
.player-offer--band .player-offer__actions { justify-content: center; }
.player-offer-sticky { position: fixed; inset-inline: 0; bottom: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px var(--container-gutter, 20px) calc(10px + env(safe-area-inset-bottom)); background: rgb(var(--background-primary)); box-shadow: 0 -2px 12px rgb(0 0 0 / .12); }
.player-offer-sticky[hidden] { display: none; }
.player-offer-sticky__label { margin: 0; display: flex; flex-direction: column; font-size: .875rem; line-height: 1.3; }
.player-offer-sticky__label strong { font-size: 1.125rem; color: var(--brand-heading); }
@media screen and (max-width: 699px) {
  .player-offer__actions > * { flex: 1 1 100%; }
  .player-offer__actions .button { width: 100%; }
}
@media screen and (min-width: 700px) {
  .player-offer-sticky { display: none !important; }
}
@media screen and (min-width: 1000px) {
  .player-offer--hero .player-offer__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--spacing-14); }
}


