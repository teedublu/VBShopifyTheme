  --shopify-accelerated-checkout-button-block-size: 58px;
}
/* ---------------------------- */
/* AUDIOBOOK DATA               */
/* ---------------------------- */
.mobile_float { border-radius: 20px; margin: 5px; --background: 255 247 240; background-color: rgb(var(--background));}

/* ---------------------------- */
/* COLLECTION PAGES                */
/* ---------------------------- */

/* Sticky filter bar on desktop */
@media screen and (min-width: 1400px) {
  .sticky-filterbar {
    position: -webkit-sticky; position: sticky; top: 72px; background-color: #ffffffdb; z-index: 500; width: 100%; padding: 10px;
  }
}

/* ---------------------------- */
/* PRODUCT CARDS                */
/* ---------------------------- */

/* GENERAL                      */
.product-card { padding: 10px; border: 1px solid silver; align-items: center; height: 100%;}
.product-card { row-gap: var(--spacing-2); grid-template-rows: 1fr auto; }
.product-card__figure { align-content: center; } /* make smaller bundle images align in center of image block */
.product-card__details { display: grid; grid-template-rows: 1fr 1fr 1fr; align-items: start; row-gap: var(--spacing-2); }
.product-card__details > :nth-child(2) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; }
.product-card__info { padding-top: 0;}
.product-card__row { display: flex; align-items: center; }
.product-card img.product-card__image.product-card__image--primary { max-height: 40vh }

.product-card .price-list {flex-wrap: nowrap;}


/* SAVE BOOK HEART (snippets/save-book-button.liquid) */
save-book-button { display: inline-flex; vertical-align: middle; }
save-book-button:not(:defined) { visibility: hidden; } /* keeps its space until the script has loaded */
.no-js save-book-button { display: none; }

.save-book__button { display: inline-flex; color: rgb(var(--text-color)); transition: color .2s ease, transform .2s ease; }
.save-book__button svg path { transition: fill-opacity .2s ease; }
.save-book__button[aria-pressed="true"] { color: rgb(var(--accent)); }
.save-book__button[aria-pressed="true"] svg path { fill-opacity: 1; }
.save-book__button:active { transform: scale(.85); }

/* On every product card the heart floats over the bottom-right corner of the image (the top corners hold the badges) */
.save-book--overlay { position: absolute; z-index: 6; inset-block-end: 8px; inset-inline-end: 8px; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: rgb(255 255 255 / .88); box-shadow: 0 1px 4px rgb(0 0 0 / .14); }

.product-info__title-row { display: flex; align-items: flex-start; gap: var(--spacing-4); }
.product-info__title-row > .product-info__title { flex: 1 1 auto; min-width: 0; }
.product-info__title-row > save-book-button { flex-shrink: 0; margin-block-start: .25em; }

saved-books-list { display: block; } /* custom elements are inline by default, which drops the section's gutters */

/* Header heart: shown once something is saved ("has-saved-books" is set in snippets/saved-books-head.liquid) */
.header__saved-books { display: none; }
.has-saved-books .header__saved-books { display: block; }
saved-books-count:empty { opacity: 0; }

/* ...and a quick bump each time a book is saved, so people see where their list went (saved-books.js adds "is-bumping") */
@keyframes saved-books-heart-bump {
  0%   { transform: scale(1); }
  20%  { transform: scale(1.35); color: rgb(var(--accent)); }
  40%  { transform: scale(.9); }
  60%  { transform: scale(1.12); color: rgb(var(--accent)); }
  100% { transform: scale(1); }
}
@keyframes saved-books-heart-fill {
  15%, 65% { fill-opacity: 1; }
}
@keyframes saved-books-count-pop {
  0%, 100% { transform: scale(1); }
  30% { transform: scale(1.5); }
  55% { transform: scale(.9); }
}
.header__saved-books.is-bumping svg { animation: saved-books-heart-bump .8s ease-out; }
.header__saved-books.is-bumping svg path { animation: saved-books-heart-fill .8s ease-out; }
.header__saved-books.is-bumping saved-books-count { animation: saved-books-count-pop .6s ease-out .15s; }

/* "Saved" / "Removed" message: saved-books.js sets "top" to just below the header. The z-index clears sticky bars such
   as the collection "Sort by" bar (500) but stays under drawers (999) */
.saved-books-toast {
  position: fixed;
  z-index: 998;
  inset-inline: 0;
  top: var(--spacing-4);
  width: max-content;
  max-width: calc(100vw - 2 * var(--container-gutter));
  margin-inline: auto;
  display: flex;
  align-items: center;
  gap: var(--spacing-4);
  padding: var(--spacing-3) var(--spacing-5);
  border-radius: var(--rounded-full);
  background: rgb(var(--text-primary));
  color: rgb(var(--background-primary));
  box-shadow: 0 6px 20px rgb(0 0 0 / .18);
  opacity: 0;
  transform: translateY(-.5rem);
  pointer-events: none;
  transition: opacity .2s ease, transform .2s ease;
}
.saved-books-toast.is-visible { opacity: 1; transform: none; pointer-events: auto; }
.saved-books-toast a, .saved-books-toast button { font-weight: bold; text-decoration: underline; text-underline-offset: 2px; }

@media (prefers-reduced-motion: reduce) {
  .save-book__button, .save-book__button svg path, .saved-books-toast { transition: none; }
  .header__saved-books.is-bumping :is(svg, svg path, saved-books-count) { animation: none; }
}


.badge { border-radius: 3px;}
.badge.new { background: linear-gradient(180deg, var(--badge-new), color-mix(in srgb, var(--badge-new) 85%, black)); color: rgb(var(--badge-new-text)); }
.badge.teachers { background: linear-gradient(180deg, var(--badge-teachers), color-mix(in srgb, var(--badge-teachers) 85%, black)); color: rgb(var(--badge-teachers-text)); }
.badge.coming { background: linear-gradient(180deg, var(--badge-coming), color-mix(in srgb, var(--badge-coming) 85%, black)); color: rgb(var(--badge-coming-text)); }
.badge.just { background: linear-gradient(180deg, var(--badge-just), color-mix(in srgb, var(--badge-just) 85%, black)); color: rgb(var(--badge-just-text)); }
.badge.book { background: linear-gradient(180deg, var(--badge-book), color-mix(in srgb, var(--badge-book) 85%, black)); color: rgb(var(--badge-book-text)); }
.badge.black { background: linear-gradient(180deg, var(--badge-black), color-mix(in srgb, var(--badge-black) 85%, black)); color: rgb(var(--badge-black-text)); }
/* .badge.bestseller uses the theme's primary badge colours (Theme settings > Badges) */

