/* Saved books page: the list bar (sections/saved-books.liquid). One row for where the list is kept, one for the wish
   list prompt with the "Send my wish list" button */
.saved-books__bar { border-radius: var(--rounded-sm); background: rgb(var(--text-color) / .05); }
.saved-books__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--spacing-3) var(--spacing-6); padding: var(--spacing-4) var(--spacing-5); }
.saved-books__row[hidden] { display: none; }
.saved-books__row + .saved-books__row { border-top: 1px solid rgb(var(--text-color) / .1); }
.saved-books__row--quiet { padding-block: var(--spacing-3); font-size: var(--text-sm); }
.saved-books__row-text { flex: 1 1 16rem; margin: 0; }
.saved-books__send { position: relative; flex: none; }

/* Ways to send the link, on browsers without a share sheet */
.saved-books__menu { position: absolute; z-index: 10; inset-inline: 0; top: calc(100% + var(--spacing-2)); min-width: 11rem; display: grid; padding: var(--spacing-1); border-radius: var(--rounded-sm); background: rgb(var(--background)); box-shadow: 0 6px 20px rgb(0 0 0 / .18), 0 0 0 1px rgb(var(--text-color) / .1); }
.saved-books__menu[hidden] { display: none; }
.saved-books__menu > * { display: flex; align-items: center; gap: var(--spacing-3); width: 100%; padding: var(--spacing-3) var(--spacing-4); border-radius: var(--rounded-sm); text-align: start; }
.saved-books__menu > :is(:hover, :focus-visible) { background: rgb(var(--text-color) / .06); }

@media screen and (max-width: 699px) {
  .saved-books__send, .saved-books__send .button, .saved-books__row > .button { width: 100%; }
}

/* Saved books page: the view of a list someone shared */
.saved-books__shared-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-4) var(--spacing-6); }
.is-shared-saved-books [data-saved-books-own] { display: none; }


/* ---------------------------- */
/* OFFER PRICE (snippets/offer-price.liquid) */
/* ---------------------------- */
/* Offer price keeps the theme's normal price colour (same as sale-price.text-lg above) */
.offer-price { display: inline-flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; }
.offer-price__now { font-weight: 700; }
.offer-price__now.text-lg { color: rgb(var(--button-background-primary)); }
.offer-price__now--regular { color: inherit; }
.offer-price__was[hidden], offer-badges[hidden] { display: none !important; }
.offer-price__from { font-size: 0.7em; margin-inline-end: -0.25rem; }

/* cards: same placement as the existing compare-at price (struck-through, small, above the price) */
.product-card .offer-price { flex-wrap: nowrap; position: relative; }
.product-card .offer-price__was { position: absolute; top: -14px; left: 0; font-size: 0.8em; white-space: nowrap; }

/* badges: "Online offer" (teal, brand primary badge) stacked over the red sale badge */
.badge--offer { --badge-background: var(--badge-offer-rgb); --badge-color: var(--badge-offer-text); }
.badge--offer-sale { --badge-background: var(--badge-offer-sale-rgb); --badge-color: var(--badge-offer-sale-text); font-weight: 700; }
.product-card__badge-list { justify-items: start; }


/* ---------------------------- */
/* BUNDLE PRICE (snippets/bundle-price.liquid) */
/* ---------------------------- */
/* Packs / audiobook bundles: price + "saves" chip, with a "Bought separately" line underneath.
   The line is absolutely positioned so the card is exactly as tall as one showing a plain price. */
.badge--bundle { display: inline-flex; align-items: center; gap: 0.4rem; --badge-background: var(--badge-bundle-rgb); --badge-color: var(--badge-bundle-text); font-weight: 700; }
.badge--bundle svg { flex: none; }

.bundle-price { position: relative; display: inline-flex; align-items: center; gap: 0.5rem; min-width: 0; transform: translateY(-0.5rem); } /* lift so price + caption are centred on the basket button */
.bundle-price__now { font-weight: 700; color: rgb(var(--button-background-primary)); white-space: nowrap; }
.bundle-price__chip { background: rgb(var(--badge-bundle-rgb)); color: rgb(var(--badge-bundle-text)); font-size: 0.75rem; font-weight: 600; line-height: 1.2; padding: 0.15rem 0.5rem; border-radius: 3px; white-space: nowrap; }
.bundle-price__was { position: absolute; top: 100%; left: 0; margin-top: 0.1rem; font-size: 0.75rem; line-height: 1.2; font-weight: 500; white-space: nowrap; color: rgb(var(--text-color)); }
.bundle-price__was-short { display: none; }

/* Responsive to the width of the price row (the card), not the viewport */
.buy-price:has(.bundle-price) { container-type: inline-size; }
/* widths measured with Poppins: price + chip need ~230px of row; the long caption needs ~225px */
@container (max-width: 15.5rem) { .bundle-price__chip { display: none; } }
@container (max-width: 14.5rem) { .bundle-price__was-long { display: none; } .bundle-price__was-short { display: inline; } }

/* Product page: normal flow, the "bought separately" line sits under the price (no card height to protect) */
.bundle-price--page { display: inline-flex; flex-wrap: wrap; align-items: center; transform: none; }
.bundle-price--page .bundle-price__was { position: static; flex-basis: 100%; margin-top: 0; }
.bundle-price--page [hidden] { display: none !important; }

/* ---------------------------- */
/* PRODUCT PAGE PRICE: one size on every product page */
/* ---------------------------- */
/* Plain prices (sale-price), pack prices (bundle-price) and offer prices (offer-price) used to render at different sizes
   (36px vs 20px on phones). All three now use the theme's Large heading size, the same size as the product title.
   Product cards are unaffected (they are not inside .product-info__price). */
.product-info__price :is(sale-price.text-lg, .bundle-price__now, .offer-price__now) { font-size: var(--text-h2); line-height: 1.1; font-weight: 700; }
.product-info__price compare-at-price, .product-info__price .offer-price__was { font-size: var(--text-base); }
.product-info__price .bundle-price--page { row-gap: 0.25rem; }

/* Anchor target for the "Choose your pack" hero button (collection.starter-pack-collection): clear the sticky header */
#product-grid { scroll-margin-top: calc(var(--sticky-area-height, 0px) + 1rem); }

/* ---------------------------- */
/* STARTER PACK COLLECTION REDESIGN */
/* Intro band + explainer, sticky age bar, pack cards. Layout and copy: design canvas "Starter Pack collection redesign". */
/* Colours: var(--brand-heading) teal (headings, buttons), var(--brand-text) text, var(--accent-strong-dark) eyebrow/age, var(--accent-strong) prices (readable on white, the orange button colour is not) */
/* ---------------------------- */

/* INTRO BAND */
.pack-intro { background: var(--pack-intro-bg, #fff7f0); }
.pack-intro__inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "text image" "explainer explainer"; column-gap: 12px; align-items: start; padding-block: 12px 0; }
.pack-intro__text { grid-area: text; display: flex; flex-direction: column; gap: 6px; min-width: 0; padding-bottom: 8px; }
.pack-intro__eyebrow { margin: 0 0 2px; } /* 6px column gap + 2px = the standard 8px under an eyebrow */
.pack-intro__title { margin: 0; }
.pack-intro__lede { margin: 0; font-size: 13px; line-height: 19px; }
.pack-intro__desktop-only { display: none; }
.pack-intro__image { grid-area: image; }
.pack-intro__image img { display: block; width: 96px; height: 120px; object-fit: cover; object-position: 30% 50%; border-radius: 12px; }
/* mobile: the explainer sits on white under the band (full-bleed white via a clipped shadow) */
.pack-intro__explainer { grid-area: explainer; display: flex; flex-direction: column; gap: 8px; padding: 12px 0 4px; background: #fff; box-shadow: 0 0 0 100vmax #fff; clip-path: inset(0 -100vmax); }
.pack-intro__tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.pack-intro__tile { display: flex; align-items: center; gap: 6px; border: 1px solid var(--card-border); border-radius: 12px; padding: 5px 6px 5px 5px; background: #fff; }
.pack-intro__tile-media { flex: none; width: 48px; height: 48px; border-radius: 8px; background: var(--card-media-bg); overflow: hidden; }
.pack-intro__tile-media img { display: block; width: 100%; height: 100%; object-fit: contain; }
.pack-intro__tile-text { min-width: 0; }
.pack-intro__tile p { margin: 0; }
.pack-intro__tile-title { font-size: 12px; font-weight: 600; color: var(--brand-heading); }
.pack-intro__tile-contents { font-size: 11px; line-height: 15px; }
.pack-intro__tile-price { font-size: 13px; font-weight: 700; color: var(--accent-strong); }
.pack-intro__note { margin: 0; font-size: 11px; line-height: 16px; }
.pack-intro__player-link { color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

@media screen and (min-width: 1000px) {
  .pack-intro__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 380px) 220px; grid-template-areas: "text explainer image"; column-gap: 32px; align-items: center; padding-block: 28px; }
  .pack-intro__text { gap: 10px; padding-bottom: 0; }
  .pack-intro__eyebrow { margin-bottom: -2px; } /* 10px gap - 2px = 8px under the eyebrow */

  .pack-intro__lede { font-size: 15px; line-height: 23px; max-width: 560px; }
  .pack-intro__desktop-only { display: inline; }
  .pack-intro__image img { width: 220px; height: 180px; border-radius: 14px; object-position: 50% 55%; }
  .pack-intro__explainer { padding: 0; background: transparent; box-shadow: none; clip-path: none; gap: 10px; }
  .pack-intro__tiles { gap: 10px; }
  .pack-intro__tile { border-color: var(--card-border); border-radius: 14px; padding: 10px; gap: 10px; flex-direction: column; align-items: stretch; }
  .pack-intro__tile-media { width: 100%; height: 96px; border-radius: 10px; }
  .pack-intro__tile-title { font-size: 14px; }
  .pack-intro__tile-contents { font-size: 13px; line-height: normal; }
  .pack-intro__tile-price { font-size: 16px; }
  .pack-intro__note { font-size: 12px; line-height: 17px; }
}

/* The theme's collection grid adds a 32px top margin and a 32px row gap (48px top margin on desktop): too much air above the first row of prices on a phone */
.collection.collection--pack { gap: 0; margin-block-start: 0; }

/* STICKY AGE / SORT BAR. top follows the real sticky header (+ announcement bar when it is sticky) through --sticky-area-height, which the header and announcement bar sections measure at runtime */
.pack-bar { position: sticky; top: var(--sticky-area-height, 0px); z-index: 5; background: #fff; border-bottom: 1px solid var(--card-border); margin-bottom: 4px; color: var(--brand-text); }
.pack-bar__chips { display: flex; gap: 6px; margin: 0; padding: 6px 0 2px; overflow-x: auto; scrollbar-width: none; }
.pack-bar__chips::-webkit-scrollbar { display: none; }
.pack-chip { flex: 0 0 auto; min-height: 44px; min-width: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--card-border); background: #fff; color: var(--brand-text); font: inherit; font-size: 13px; font-weight: 500; line-height: 1; cursor: pointer; }
.pack-chip[aria-pressed="true"] { background: var(--brand-heading); border-color: var(--brand-heading); color: #fff; font-weight: 600; }
.pack-chip:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
.pack-bar__meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 12px; }
.pack-bar__count { margin: 0; }
.pack-bar__help { display: none; font-weight: 600; color: var(--brand-heading); }
.pack-bar__sort { margin-inline-start: auto; display: inline-flex; align-items: center; gap: 4px; }
.pack-bar__sort-button { min-height: 44px; }

@media screen and (min-width: 1000px) {
  .pack-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 10px 0; margin-bottom: 20px; }
  .pack-bar__chips { flex-wrap: wrap; overflow: visible; padding: 0; gap: 8px; }
  .pack-bar__meta { gap: 16px; font-size: 13px; margin-inline-start: auto; }
  .pack-bar__help { display: inline; }
}

/* PACK CARD: flex column, price + swatches pinned to the bottom so prices line up in every row */
.pack-card { display: flex; flex-direction: column; gap: 5px; height: 100%; position: relative; color: var(--brand-text); border: 1px solid var(--card-border); border-radius: 12px; overflow: hidden; background: #fff; }
.pack-card > :not(.pack-card__media) { padding-inline: 10px; }
.pack-card__buy { padding-bottom: 10px; }
.pack-card__media { position: relative; aspect-ratio: 1 / 1; border-radius: 0; background: var(--card-media-bg); overflow: hidden; }
.pack-card .pack-card__image { display: block; width: 100%; height: 100%; object-fit: contain; border-radius: 0; } /* also carries the theme's product-card__image classes so the swatch script can swap the image */
.pack-card__badge { position: absolute; top: 8px; padding: 2px 7px; border-radius: 999px; color: #fff; font-size: 10px; font-weight: 600; line-height: 1.4; }
.pack-card__badge--save { left: 8px; background: var(--accent-strong); color: rgb(var(--accent-strong-text)); display: inline-flex; align-items: center; gap: 4px; }
.pack-card__badge--save svg { flex: none; width: 12px; height: 12px; }
.pack-card__badge--best { right: 8px; background: var(--brand-heading); }
.pack-card__title { margin: 6px 0 0; font-size: 13px; line-height: 17px; font-weight: 600; color: var(--brand-heading); letter-spacing: normal; }
.pack-card__link { color: inherit; text-decoration: none; }
.pack-card__link::after { content: ""; position: absolute; inset: 0; z-index: 1; } /* whole card is one link */
.pack-card__link:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
.pack-card__contents, .pack-card__age { margin: 0; font-size: 11px; line-height: 15px; }
.pack-card__age { font-weight: 600; color: var(--accent-strong-dark); }
.pack-card__buy { margin-top: auto; padding-top: 4px; display: flex; flex-direction: column; gap: 5px; }
.pack-card__prices { margin: 0; display: flex; flex-wrap: wrap; gap: 0 6px; align-items: baseline; }
.pack-card__price { font-size: 18px; font-weight: 700; color: var(--accent-strong); }
.pack-card__from { font-size: 11px; color: var(--brand-text); }
.pack-card__was { font-size: 11px; color: rgb(var(--brand-text-rgb) / .75); }
.pack-card__swatches { position: relative; z-index: 2; margin: 0; padding: 0; border: 0; min-width: 0; } /* above the stretched link so swatches stay clickable */

@media screen and (min-width: 700px) {
  .pack-card { gap: 6px; }
  .pack-card { border-radius: 14px; }
  .pack-card > :not(.pack-card__media) { padding-inline: 12px; }
  .pack-card__buy { padding-bottom: 12px; }
  .pack-card__badge { top: 10px; font-size: 11px; padding: 3px 9px; }
  .pack-card__badge--save { left: 10px; gap: 5px; }
  .pack-card__badge--save svg { width: 14px; height: 14px; }
  .pack-card__badge--best { right: 10px; }
  .pack-card__title { font-size: 15px; line-height: 20px; }
  .pack-card__contents { font-size: 13px; line-height: 18px; }
  .pack-card__age { font-size: 12px; }
  .pack-card__prices { gap: 0 8px; }
  .pack-card__price { font-size: 22px; }
  .pack-card__was { font-size: 13px; }
}

/* "Help me choose" card after the grid, mobile only (desktop has the link in the bar) */
.pack-help { margin-top: 24px; padding: 14px; border-radius: 12px; background: #fff7f0; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; color: var(--brand-text); }
.pack-help__title { margin: 0; font-size: 14px; font-weight: 600; color: var(--brand-heading); }
.pack-help__text { margin: 0 0 4px; font-size: 12px; line-height: 17px; }
@media screen and (min-width: 1000px) { .pack-help { display: none; } }


/* ----------------------------------------------------------------------------------------------------------------
   CARD BADGES: one pill style for every product card (matches the pack card Save % / Bestseller badges)
   ---------------------------------------------------------------------------------------------------------------- */
.product-card { --product-card-badge-spacing: 9px; }
.product-card__badge-list .badge { border-radius: 999px; font-weight: 600; font-size: 10px; line-height: 1.4; padding: 2px 7px; gap: 4px; }
.product-card__badge-list .badge svg { width: 12px; height: 12px; flex: none; }
@media screen and (min-width: 700px) {
  .product-card { --product-card-badge-spacing: 11px; }
  .product-card__badge-list .badge { font-size: 11px; padding: 3px 9px; gap: 5px; }
  .product-card__badge-list .badge svg { width: 14px; height: 14px; }
}

/* ----------------------------------------------------------------------------------------------------------------
   CARD TITLES: same type as the pack cards, on every product card
   ---------------------------------------------------------------------------------------------------------------- */
.product-card__title a { font-size: 13px; line-height: 17px; font-weight: 600; color: var(--brand-heading); }
@media screen and (min-width: 700px) { .product-card__title a { font-size: 15px; line-height: 20px; } }

/* ----------------------------------------------------------------------------------------------------------------
   HEADINGS: one hierarchy for the whole site, set in Theme settings, not per section
   Size: Theme settings > Typography > Heading size (--text-h0..h6 in css-variables). H1 > H2 > H3 at every width.
   A bare heading tag takes the size of its level. A size class (.h0-.h6) styles text to look like a level whatever
   its tag, so a marketing line can look like an H1 while staying an H2 or a <p> for search engines.
   Font and weight: Theme settings > Typography > Heading font. Colour: Theme settings > Heading teal (--heading-color).
   Sections with light text (dark bands) switch --heading-color to their text colour (section-properties, surface).
   Headings laid over images keep the colour of their content. Sections should not set their own heading size or colour.
   ---------------------------------------------------------------------------------------------------------------- */
:where(#main) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font-family); font-weight: var(--heading-font-weight); font-style: var(--heading-font-style); letter-spacing: var(--heading-letter-spacing); text-transform: var(--heading-text-transform); }
:where(#main) h1 { font-size: var(--text-h1); line-height: 1.1; }
:where(#main) h2 { font-size: var(--text-h2); line-height: 1.1; }
:where(#main) h3 { font-size: var(--text-h3); line-height: 1.2; }
:where(#main) h4 { font-size: var(--text-h4); line-height: 1.3; }
:where(#main) :is(h5, h6) { font-size: var(--text-h5); line-height: 1.4; }
:where(#main) :where(h1, h2, h3, h4, .h0, .h1, .h2, .h3, .h4) { color: rgb(var(--heading-color)); }
:where(.content-over-media, .collection-card__content-wrapper) :where(h1, h2, h3, h4, .h0, .h1, .h2, .h3, .h4) { color: inherit; }

/* EYEBROWS (subheadings): the small line above a heading, one style everywhere. Every eyebrow carries the theme's
   .subheading class (section subheading settings, and each section's own __eyebrow element). Colour: --eyebrow-color,
   dark brand orange on light sections, the text colour on dark sections, inherited over images. */
.subheading { font-family: var(--text-font-family); font-size: 0.75rem; line-height: 1.25rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--eyebrow-color); }
/* the eyebrow sits the same 8px above whatever follows it, in rich text and in the bespoke sections alike */
.prose .subheading + *, .subheading + :is(h1, h2, h3, h4, h5, h6, .h0, .h1, .h2, .h3, .h4, .h5, .h6) { margin-block-start: var(--spacing-2); }
.product-info__eyebrow.subheading { margin-block-end: var(--spacing-2); }
.pack-intro__eyebrow + .pack-intro__title { margin-block-start: 0; } /* the pack intro spaces its lines with a flex gap instead */
@media screen and (min-width: 700px) { .subheading { font-size: 0.8125rem; line-height: 1.25rem; } }
:where(.content-over-media, .collection-card__content-wrapper) .subheading { color: inherit; }

/* ----------------------------------------------------------------------------------------------------------------
   ONE CARD LAYOUT for every product card (audiobook, starter pack, default, pack card)
   image panel / [books: preview + heart] / title (max 2 lines) / [swatches] / price left + add-to-cart right, pinned bottom
   ---------------------------------------------------------------------------------------------------------------- */
.product-card { display: flex; flex-direction: column; padding: 0; border: 1px solid var(--card-border); border-radius: 12px; overflow: hidden; background: #fff; row-gap: 0; }
.product-card__figure { flex: none; background: var(--card-media-bg); }
.product-card .product-card__image { border-radius: 0; }
.product-card:has(.sample-wishlist) .product-card__figure > a { padding: 10px 14px; } /* book covers sit inset, not hard against the card edge */
.product-card__details { display: flex; flex-direction: column; flex: 1; gap: 6px; padding: 8px 10px 10px; }
.product-card__details > :nth-child(2) { white-space: normal; overflow: visible; text-overflow: clip; width: auto; }
.product-card__info { padding: 0; order: 2; }
.product-card__row.sample-wishlist { order: 1; width: 100%; justify-content: space-between; }
.product-card__details > .product-card__sample, .product-card__details > .product-card__row:not(.buy-price):not(.sample-wishlist) { order: 3; }
.product-card__row.buy-price { order: 9; margin-top: auto; width: 100%; flex-direction: row-reverse; justify-content: space-between; gap: 8px; }
.product-card__row.buy-price .icon-circle { margin-right: 0; }
/* titles: two lines at most, always two lines tall so the rows beneath line up */
.product-card__title { display: block; min-height: 34px; }
.product-card__title a, .pack-card__title a { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; }
.pack-card__title { min-height: 34px; }
@media screen and (min-width: 700px) {
  .product-card { border-radius: 14px; }
  .product-card__details { padding: 10px 12px 12px; }
  .product-card__title, .pack-card__title { min-height: 40px; }
}


/* Pack card quick add: round button beside the price (same add-to-cart as the other cards), above the whole-card link */
.pack-card__buy-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.pack-card__add { position: relative; z-index: 2; margin: 0; flex: none; }
.pack-card__add-button { display: grid; place-items: center; width: 38px; height: 38px; min-width: 38px; padding: 0; border-radius: 50%; border: 0; background: rgb(var(--button-background-primary)); color: rgb(var(--button-text-primary)); cursor: pointer; } /* identical to .icon-circle on the other cards */
.pack-card__add-button:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }

/* Sold-out cards: greyed-out add to cart (same size as the live button) plus a "More coming soon" pill just above the price row */
.icon-circle--disabled, .pack-card__add-button--disabled { background: rgb(var(--text-color) / .12); color: rgb(var(--text-color) / .38); cursor: not-allowed; }
.icon-circle--disabled { display: block; border: 0; font: inherit; }
.product-card__row.buy-price > .icon-circle--disabled { flex: none; }
.coming-soon-row { order: 8; margin-top: auto; }
.coming-soon-row + .product-card__row.buy-price { margin-top: 0; }
.pack-card__buy > .coming-soon-row { order: 0; margin-top: 0; } /* pack card orders by DOM position: pill sits right above the price row, price row stays pinned to the bottom */

/* Back in stock alert: the pill becomes a button (above the whole-card link on pack cards), and a sheet takes the email: bottom sheet on phones, centred card on desktop */
.coming-soon-pill.coming-soon-pill--action { gap: 5px; margin: 0; padding: 2px 9px; border: 1.5px solid var(--brand-heading); background: transparent; color: var(--brand-heading); font-family: inherit; text-align: start; cursor: pointer; position: relative; z-index: 2; -webkit-appearance: none; appearance: none; transition: background-color .15s, color .15s, border-color .15s, opacity .15s; } /* outlined brand teal: clearly tappable, not the grey of a disabled control */
.coming-soon-pill--action svg { width: 12px; height: 12px; flex: none; }
.coming-soon-pill--action:hover { background: rgb(var(--brand-heading-rgb) / .1); }
.coming-soon-pill--action:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
.coming-soon-pill--action.is-set { border-color: transparent; background: rgb(var(--brand-heading-rgb) / .14); cursor: default; }
.coming-soon-pill--action.is-busy { opacity: .6; cursor: progress; }
.coming-soon-pill__tick { display: none; }
.coming-soon-pill.is-set .coming-soon-pill__bell { display: none; }
.coming-soon-pill.is-set .coming-soon-pill__tick { display: block; }
.coming-soon-pill.coming-soon-pill--pdp { width: 100%; max-width: none; justify-content: center; padding: 11px 16px; font-size: 14px; font-weight: 700; border: 2px solid var(--brand-heading); border-radius: var(--rounded-button, 999px); background: transparent; color: var(--brand-heading); } /* outlined so it reads as tappable under the greyed sold-out button */
.coming-soon-pill.coming-soon-pill--pdp:hover { background: rgb(var(--brand-heading-rgb) / .08); }
.coming-soon-pill.coming-soon-pill--pdp.is-set { border-color: var(--brand-heading); background: rgb(var(--brand-heading-rgb) / .12); color: var(--brand-heading); }
.coming-soon-pill.coming-soon-pill--pdp svg { width: 16px; height: 16px; }

.stock-alert { --alert-text: var(--text-primary, 42 85 90); position: fixed; border: 0; padding: 20px; width: min(440px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow: auto; border-radius: 18px; background: #fff; color: rgb(var(--alert-text)); box-shadow: 0 24px 64px rgb(0 0 0 / .28); }
.stock-alert::backdrop { background: rgb(0 0 0 / .5); }
.stock-alert [hidden] { display: none !important; }
.stock-alert__close-form { position: absolute; top: 10px; inset-inline-end: 10px; margin: 0; }
.stock-alert__close { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%; background: rgb(var(--alert-text) / .08); color: inherit; cursor: pointer; }
.stock-alert__product { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; padding-inline-end: 36px; }
.stock-alert__image-slot { flex: none; line-height: 0; }
.stock-alert__image-slot:empty { display: none; }
.stock-alert__image { flex: none; width: 56px; height: 56px; border-radius: 10px; background: rgb(var(--alert-text) / .05); object-fit: contain; }
.stock-alert__lead { margin: 0; font-size: 1.0625rem; line-height: 1.3; }
.stock-alert__product-title, .stock-alert__status { display: block; }
.stock-alert__product-title { color: var(--brand-heading); font-weight: 600; }
.stock-alert__status { font-weight: 500; }
.stock-alert__form { display: grid; gap: 14px; }
.stock-alert__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
.stock-alert__error { margin: 0; color: #b42318; font-size: 13px; }
.stock-alert__privacy { margin: 0; }
@media screen and (max-width: 699px) {
  .stock-alert { inset: auto 0 0 0; width: 100%; max-width: 100%; margin: 0; border-radius: 18px 18px 0 0; padding: 20px 20px calc(24px + env(safe-area-inset-bottom)); }
}
.coming-soon-pill { display: inline-flex; align-items: center; width: max-content; max-width: 100%; padding: 3px 10px; border-radius: 999px; background: rgb(var(--text-color) / .08); color: rgb(var(--text-color) / .75); font-size: 11px; font-weight: 600; line-height: 1.4; }

/* Card polish: equal image panels so every row lines up, tighter preview/heart row, add-to-cart always at the far right */
.product-card { align-items: stretch; }
.product-card__figure { aspect-ratio: 1 / 1; position: relative; width: 100%; }
.product-card__figure > a { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.product-card .product-card__figure img.product-card__image { width: auto !important; height: auto !important; max-width: 100% !important; max-height: 100% !important; aspect-ratio: auto !important; object-fit: contain !important; position: static !important; }
.product-card__row.sample-wishlist { gap: 6px; font-size: 13px; min-height: 24px; } /* keeps the row (and the card heights) the same for books with no preview, as the heart used to */
.product-card__row.buy-price > form { flex: none; margin: 0; }
.product-card__row.buy-price > :not(form) { flex: 1 1 auto; min-width: 0; }
.product-card__figure { min-height: 0; overflow: hidden; }

/* Pack intro: tiles are links that scroll to the first pack of that kind; hero image stretches to the explainer height on desktop */
a.pack-intro__tile { color: inherit; text-decoration: none; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
a.pack-intro__tile:hover { border-color: var(--brand-heading); box-shadow: 0 2px 8px rgba(25, 113, 119, .15); }
a.pack-intro__tile:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
@media screen and (min-width: 1000px) {
  .pack-intro__explainer { padding: 0; align-self: stretch; }
  .pack-intro__text { align-self: center; }
  .pack-intro__tiles { flex: 1 1 auto; }
  .pack-intro__image { align-self: stretch; }
  .pack-intro__image img { width: 220px; height: 100%; min-height: 220px; }
}

/* ---------------------------- */
/* SERIES PAGE (sections/series-page.liquid, sections/series-related.liquid; template metaobject/series.json) */
/* Character cards (snippets/character-card.liquid) are shared with the character page (sections/character-cast.liquid). */
/* One layout for every series. Design canvas "Series Page Mockup". Mobile first; 700px and 1000px as elsewhere. */
/* Colours: var(--brand-heading) teal (headings, buttons), var(--brand-text) text, hero band from the series colour. */
/* ---------------------------- */
.series-page, .series-related { color: var(--brand-text); }
.series-heading { margin: 0; }
.series-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 0 24px; border-radius: 999px; border: 2px solid var(--brand-heading); background: var(--brand-heading); color: #fff; font: inherit; font-size: 15px; font-weight: 700; line-height: 1.2; text-align: center; text-decoration: none; cursor: pointer; }
.series-button:hover { color: #fff; filter: brightness(1.08); }
.series-button:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 3px; }
.series-button--secondary { background: #fff; color: var(--brand-heading); }
.series-button--secondary:hover { color: var(--brand-heading); background: #f3f7f7; filter: none; }
.series-button--small { min-height: 44px; padding: 0 18px; font-size: 14px; }
.series-button--block { width: 100%; }
.series-button[disabled] { background: #e8e8e8; border-color: #e8e8e8; color: #6b6b6b; cursor: not-allowed; }
.series-button.bookpreview .playpause { width: 22px; height: 22px; flex: 0 0 22px; }

/* HERO */
.series-hero { background: var(--series-hero-bg, #ffead7); color: var(--series-hero-ink, #1e2b2c); }
.series-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; padding-block: 16px 28px; }
.series-hero__text { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.series-hero__eyebrow { margin: 0; }
.series-hero__title { margin: 0; }
.series-hero--dark h1.series-hero__title { color: inherit; }
.series-hero__lede { margin: 0; font-size: 16px; line-height: 24px; max-width: 40ch; }
.series-hero__chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
.series-chip { padding: 5px 12px; border-radius: 999px; background: var(--series-chip-bg, rgba(255, 255, 255, 0.72)); font-size: 13px; font-weight: 500; line-height: 1.4; }
.series-chip--link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; color: inherit; text-decoration: none; border: 1px solid transparent; }
.series-chip--link:hover { color: inherit; border-color: currentColor; }
.series-chip--link:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
.series-hero__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
.series-hero--dark .series-button--primary { background: #fff; border-color: #fff; color: var(--brand-heading); }
.series-hero--dark .series-button--secondary { background: transparent; border-color: #fff; color: #fff; }
.series-hero--dark .series-button.bookpreview .playpause { filter: invert(1); }
.series-hero__covers { display: flex; justify-content: center; align-items: flex-end; padding-top: 8px; }
.series-hero__cover { width: 28%; max-width: 190px; position: relative; filter: drop-shadow(0 14px 18px rgba(0, 0, 0, 0.2)); }
.series-hero__cover img { width: 100%; height: auto; display: block; }
.series-hero__cover--1 { transform: rotate(-7deg) translateY(8px); margin-right: -5%; z-index: 3; }
.series-hero__cover--2 { transform: translateY(-10px); z-index: 2; }
.series-hero__cover--3 { transform: rotate(7deg) translateY(8px); margin-left: -5%; z-index: 1; }
.series-hero__cover--1:only-child { transform: none; margin: 0; }

/* BOOKS */
.series-books { padding-block: 40px 16px; scroll-margin-top: calc(var(--sticky-area-height, 0px) + 1rem); }
.series-books__head { display: flex; flex-direction: column; gap: 16px; }
.series-books__intro { margin: 6px 0 0; max-width: 60ch; }
.series-whole { display: flex; align-items: center; justify-content: space-between; gap: 12px 16px; flex-wrap: wrap; padding: 14px 16px; border-radius: 16px; background: #fff7f0; }
.series-whole__text p { margin: 0; line-height: 1.35; }
.series-whole__title { font-weight: 600; color: var(--brand-heading); }
.series-whole__meta { font-size: 13px; }
.series-whole__price { font-weight: 600; color: var(--brand-text); }
.series-whole__saving { font-weight: 600; color: var(--accent-strong); }
.series-books__list { display: flex; flex-direction: column; gap: 16px; margin: 24px 0 0; padding: 0; list-style: none; }
.series-book { display: grid; grid-template-columns: 88px minmax(0, 1fr); grid-template-areas: "media body" "buy buy"; gap: 14px 16px; padding: 16px; border: 1px solid var(--card-border); border-radius: 16px; background: #fff; }
.series-book__media { grid-area: media; position: relative; }
.series-book__media img { width: 100%; height: auto; display: block; }
.series-book__number { position: absolute; top: -8px; left: -8px; width: 32px; height: 32px; border-radius: 50%; background: var(--brand-heading); color: #fff; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.series-book__body { grid-area: body; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.series-book__eyebrow { margin: 0; }
.series-book__title { margin: 0; font-size: 17px; line-height: 23px; font-weight: 600; letter-spacing: normal; }
.series-book__title a { color: var(--brand-heading); text-decoration: none; }
.series-book__title a:hover { text-decoration: underline; text-underline-offset: 2px; }
.series-book__blurb { margin: 0; font-size: 14px; line-height: 21px; }
.series-book__meta { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: #6b6b6b; }
.series-book__buy { grid-area: buy; display: grid; grid-template-columns: auto 1fr 1fr; align-items: center; gap: 8px; }
.series-book__buy form { margin: 0; }
.series-book__price { margin: 0; font-size: 17px; font-weight: 700; color: var(--brand-text); white-space: nowrap; padding-right: 4px; }
.series-book__was { font-weight: 400; font-size: 13px; color: #6b6b6b; }

/* CHARACTERS */
.series-characters { padding-block: 32px; }
.character-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 12px; margin: 20px 0 0; padding: 0; list-style: none; }
.character-card { display: flex; flex-direction: column; gap: 6px; padding: 18px; border-radius: 16px; background: #fff7f0; color: var(--brand-text); }
.character-card__photo { width: var(--character-photo-size, 72px); height: var(--character-photo-size, 72px); border-radius: 50%; overflow: hidden; background: #fff; }
.character-card__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; } /* tall full-figure art: show the head */
.character-card__name { margin: 4px 0 0; font-size: 16px; line-height: 22px; font-weight: 600; letter-spacing: normal; color: var(--brand-heading); }
.character-card__name a { color: inherit; }
.character-card__text { margin: 0; font-size: 14px; line-height: 21px; }
/* Audiobook product page: "Part of the … series · Book n of m" (snippets/series-membership.liquid) */
.series-membership { margin: 0; font-size: 14px; color: var(--brand-text); }
.series-membership__link { color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
/* Character page: "Meet the others" (sections/character-cast.liquid) and the round photo in the hero (snippets/person-avatar.liquid) */
.character-cast { padding-block: 40px; color: var(--brand-text); }
.character-cast__intro { margin: 8px 0 0; max-width: 60ch; }
.person-image--character img { width: 100%; height: 100%; object-fit: cover; object-position: center top; } /* tall full-figure art: show the head */

/* ABOUT AND FACTS */
.series-about { background: #f6f8f8; }
.series-about__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; padding-block: 40px; }
.series-about__text { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.series-about__prose p { margin: 0 0 12px; }
.series-about__more { border-top: 1px solid #dfe5e5; padding-top: 12px; }
.series-about__more summary { cursor: pointer; font-weight: 600; color: var(--brand-heading); min-height: 44px; display: flex; align-items: center; }
.series-about__more .prose { margin-top: 8px; }
.series-facts { align-self: start; padding: 20px; border-radius: 16px; background: #fff; }
.series-facts__title { margin: 0 0 12px; font-size: 16px; font-weight: 600; letter-spacing: normal; color: var(--brand-heading); }
.series-facts__list { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 8px 18px; margin: 0; font-size: 14px; line-height: 20px; }
.series-facts__list dt { font-weight: 600; color: var(--brand-heading); }
.series-facts__list dd { margin: 0; }
.series-facts__list a { color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; }
.series-facts__list a:hover { text-decoration-thickness: 2px; }

/* MORE SERIES */
.series-related { padding-block: 40px 56px; }
.series-related__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 12px; margin: 20px 0 0; padding: 0; list-style: none; }
.series-related__card { display: flex; align-items: center; gap: 12px; min-height: 72px; height: 100%; padding: 8px 16px 8px 8px; border: 1px solid var(--card-border); border-radius: 16px; color: var(--brand-heading); font-weight: 600; text-decoration: none; }
.series-related__card:hover { border-color: var(--brand-heading); }
.series-related__image { flex: 0 0 56px; width: 56px; height: 56px; border-radius: 10px; overflow: hidden; background: #f6f8f8; }
.series-related__image img { width: 100%; height: 100%; object-fit: cover; }

@media screen and (min-width: 700px) {
  .series-book { grid-template-columns: 120px minmax(0, 1fr) 190px; grid-template-areas: "media body buy"; align-items: center; gap: 24px; padding: 20px 24px; }
  .series-book__buy { grid-template-columns: 1fr; align-self: center; }
  .series-book__price { font-size: 19px; }
  .series-book__title { font-size: 20px; line-height: 26px; }
  .series-books__head { flex-direction: row; align-items: flex-end; justify-content: space-between; }
}

@media screen and (min-width: 1000px) {
  .series-hero__inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: 40px; padding-block: 24px 56px; }
  .series-hero__lede { font-size: 19px; line-height: 29px; }
  .series-books { padding-block: 64px 24px; }
  .series-about__inner { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 48px; padding-block: 64px; }
}

/* ---------------------------- */
/* AGE COLLECTION TEMPLATE (collection.audiobooks-landing-cat) */
/* Intro band + age tabs + starter pack card (sections/collection-age-intro.liquid), "How Voxblock works" grid row
   (snippets/collection-howto-promo.liquid), About (sections/collection-about.liquid). Design canvas "Age Collection Template". */
/* ---------------------------- */
.age-intro { color: var(--brand-text); }
.age-intro__band { background: var(--age-intro-bg, #fff7f0); }
.age-intro__band-inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; padding-block: 18px 16px; }
.age-intro__text { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.age-intro__eyebrow { margin: 0; }
.age-intro__title { margin: 0; }
.age-intro__lede { margin: 0; font-size: 15px; line-height: 22px; max-width: 34rem; }
.age-intro__trust { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 2px 0 0; padding: 0; list-style: none; font-size: 13px; }
.age-intro__trust li { display: inline-flex; align-items: center; gap: 6px; }
.age-intro__trust svg { flex: none; color: var(--brand-heading); }
.age-intro__trust li:first-child svg { color: #e8862f; }
.age-intro__trust a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
.age-intro__tabs { display: flex; gap: 8px; margin-top: 6px; overflow-x: auto; scrollbar-width: none; }
.age-intro__tabs::-webkit-scrollbar { display: none; }
.age-intro__tab { flex: 0 0 auto; display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1.5px solid var(--card-border); background: #fff; color: var(--brand-heading); font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; }
.age-intro__tab:hover { border-color: var(--brand-heading); color: var(--brand-heading); }
.age-intro__tab[aria-current="page"] { background: var(--brand-heading); border-color: var(--brand-heading); color: #fff; }
.age-intro__tab:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
.collection-related { margin-bottom: 24px; }
.collection-faq { margin-bottom: 24px; }
.collection-related__title { margin: 0 0 10px; font-size: 17px; font-weight: 700; color: var(--brand-heading); }
.collection-related .age-intro__tabs { flex-wrap: wrap; overflow: visible; margin-top: 0; }

/* Starter pack card */
.age-intro__media { display: none; }
.age-pack { border: 2px solid var(--brand-heading); border-radius: 18px; background: #fff; overflow: hidden; align-self: start; }
.age-pack__head { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 14px; background: var(--brand-heading); color: #fff; font-size: 13px; font-weight: 600; }
.age-pack__save { padding: 2px 9px; border-radius: 999px; background: #fff; color: var(--brand-heading); font-size: 12px; white-space: nowrap; }
.age-pack__body { display: flex; gap: 12px; align-items: center; padding: 12px 14px 4px; }
.age-pack__media { flex: none; width: 112px; height: 112px; }
.age-pack__media img { width: 100%; height: 100%; object-fit: contain; display: block; }
.age-pack__info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.age-pack__title { margin: 0; font-size: 16px; line-height: 21px; font-weight: 700; letter-spacing: normal; }
.age-pack__title a { color: var(--brand-heading); text-decoration: none; }
.age-pack__title a:hover { text-decoration: underline; text-underline-offset: 2px; }
.age-pack__contents { margin: 0; font-size: 13px; line-height: 18px; }
.age-pack__prices { margin: 2px 0 0; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.age-pack__from { font-size: 13px; }
.age-pack__price { font-size: 20px; font-weight: 700; color: var(--accent-strong); }
.age-pack__was { font-size: 13px; color: #6b6b6b; }
.age-pack__buy { display: flex; flex-direction: column; gap: 10px; padding: 6px 14px 14px; }
.age-pack__swatches { border: 0; margin: 0; padding: 0; }
.age-pack__form { margin: 0; }
.age-pack__links { margin: 0; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px 12px; font-size: 13px; }
.age-pack__links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

/* Line above the grid */
.age-intro__grid-head { padding-block: 18px 6px; }
.age-intro__grid-title { margin: 0; font-size: 17px; font-weight: 700; color: var(--brand-heading); }
.age-intro__count { margin: 0; font-size: 13px; }

/* Author and narrator pages (sections/person-intro.liquid): same band and card as the age collections.
   Phones get a one-line pack strip instead of the card, so the books start near the top. */
.person-intro__head { display: flex; align-items: center; gap: 12px; }
.person-intro__initials { flex: none; width: 52px; height: 52px; border-radius: 50%; background: var(--brand-heading); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 19px; font-weight: 700; letter-spacing: 0.5px; }
.person-intro__more { color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; white-space: nowrap; }
.person-intro__strip { margin: 2px 0 0; font-size: 14px; line-height: 20px; }
.person-intro__strip a { color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
.person-intro__card { display: none; }

/* "How Voxblock works" row inside the product grid */
.howto-promo { grid-column: 1 / -1; display: flex; flex-direction: column; border-radius: 18px; overflow: hidden; background: #fff7f0; color: var(--brand-text); margin-block: 8px; }
.howto-promo__media img { display: block; width: 100%; height: 210px; object-fit: cover; }
.howto-promo__text { display: flex; flex-direction: column; gap: 12px; padding: 18px 18px 20px; }
.howto-promo__eyebrow { margin: 0; }
.howto-promo__title { margin: 0; font-size: 20px; line-height: 26px; font-weight: 700; color: var(--brand-heading); }
.howto-promo__steps { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 14px; }
.howto-promo__steps li { display: flex; align-items: center; gap: 10px; }
.howto-promo__steps span { flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--brand-heading); color: #fff; font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
.howto-promo__note { margin: 0; font-size: 14px; }
.howto-promo__actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 4px; }
.howto-promo__actions .series-button { padding: 0 12px; font-size: 14px; }

/* About (collection description, collapsed) */
.collection-about { margin-block: 24px 8px; }
.collection-about__details { border-block: 1px solid var(--card-border); }
.collection-about__summary { display: flex; justify-content: space-between; align-items: center; min-height: 56px; cursor: pointer; list-style: none; font-weight: 600; color: var(--brand-heading); }
.collection-about__summary::-webkit-details-marker { display: none; }
.collection-about__details[open] .collection-about__summary svg { transform: rotate(180deg); }
.collection-about__body { padding-bottom: 16px; max-width: 70ch; }

@media screen and (min-width: 700px) {
  .howto-promo { flex-direction: row; }
  .howto-promo__media { flex: 1 1 50%; min-width: 0; }
  .howto-promo__media img { height: 100%; min-height: 320px; }
  .howto-promo__text { flex: 1 1 50%; justify-content: center; padding: 32px 36px; }
  .howto-promo__title { font-size: 26px; line-height: 33px; }
  .howto-promo__steps { flex-direction: row; flex-wrap: wrap; gap: 10px 22px; font-size: 15px; }
  .howto-promo__actions { display: flex; flex-wrap: wrap; }
  .howto-promo__actions .series-button { padding: 0 24px; font-size: 15px; }
}

@media screen and (min-width: 1000px) {
  .age-intro__band-inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: 48px; padding-block: 36px; }
  .age-intro__lede { font-size: 17px; line-height: 26px; }
  .age-intro__trust { font-size: 14px; }
  .age-pack { max-width: 520px; justify-self: end; }
  .age-intro__media { display: block; justify-self: end; width: 100%; max-width: 460px; }
  .age-intro__media img { display: block; width: 100%; height: auto; border-radius: 18px; }
  .age-pack__media { width: 160px; height: 160px; }
  .age-pack__title { font-size: 19px; line-height: 25px; }
  .age-pack__price { font-size: 24px; }
  .age-intro__grid-head { padding-block: 28px 8px; }
  .age-intro__grid-title { font-size: 20px; }
  .person-intro__initials { width: 72px; height: 72px; font-size: 26px; }
  .person-intro__strip { display: none; }
  .person-intro__card { display: block; justify-self: end; width: 100%; max-width: 520px; }
}

/* ---------------------------- */
/* CART: "Stories play on a Voxblock player" prompt (snippets/cart-player-prompt.liquid) */
/* ---------------------------- */
.cart-player-prompt { display: flex; flex-direction: column; gap: 10px; padding: 14px; border-radius: 16px; background: #fff7f0; border: 1.5px solid #f4c9a4; color: var(--brand-text); }
html.vb-has-player .cart-player-prompt { display: none; }
.cart-player-prompt p { margin: 0; }
.cart-player-prompt__intro { display: flex; gap: 10px; align-items: flex-start; }
.cart-player-prompt__intro svg { flex: none; margin-top: 2px; color: var(--accent-strong-dark); }
.cart-player-prompt__title { font-size: 15px; font-weight: 700; line-height: 20px; color: var(--brand-heading); }
.cart-player-prompt__text { font-size: 13px; line-height: 19px; }
.cart-player-prompt__option { display: flex; align-items: center; gap: 10px; padding: 10px; border-radius: 12px; border: 1px solid var(--card-border); background: #fff; }
.cart-player-prompt__option--best { border: 2px solid var(--brand-heading); }
.cart-player-prompt__option form { margin: 0; }
.cart-player-prompt__media { flex: none; width: 56px; height: 56px; border-radius: 8px; background: var(--card-media-bg); overflow: hidden; }
.cart-player-prompt__media img { width: 100%; height: 100%; object-fit: contain; display: block; }
.cart-player-prompt__info { flex: 1 1 auto; min-width: 0; }
.cart-player-prompt__badge { display: inline-block; padding: 1px 8px; border-radius: 999px; background: var(--brand-heading); color: #fff; font-size: 11px; font-weight: 600; }
.cart-player-prompt__name { font-size: 13.5px; font-weight: 600; line-height: 18px; color: var(--brand-heading); }
.cart-player-prompt__price { font-size: 13px; font-weight: 700; color: var(--accent-strong); }
.cart-player-prompt__price s { font-weight: 400; color: #6b6b6b; }
.cart-player-prompt__add { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--brand-heading); background: var(--brand-heading); color: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
.cart-player-prompt__add--secondary { background: #fff; color: var(--brand-heading); }
.cart-player-prompt__add:focus-visible, .cart-player-prompt__dismiss:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 2px; }
.cart-player-prompt__dismiss { align-self: center; min-height: 44px; padding: 0 8px; border: 0; background: none; font: inherit; font-size: 13px; font-weight: 600; color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }

/* ---------------------------- */
/* STORY HERO (sections/story-hero.liquid): Gruffalo character + cast pages */
/* Sample, starter pack and audiobook in the first screen, next to the character artwork. */
/* ---------------------------- */
.story-hero { background: var(--story-hero-bg, #fff7f0); color: var(--brand-text); }
.story-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; padding-block: 12px 22px; }
.story-hero__text { display: flex; flex-direction: column; gap: 10px; min-width: 0; order: 2; }
.story-hero__art { order: 1; display: flex; justify-content: center; }
.story-hero__art img { display: block; width: auto; max-width: 50vw; max-height: 150px; height: auto; object-fit: contain; mix-blend-mode: multiply; } /* multiply: the white artwork backgrounds sit into the cream band */
.story-hero__eyebrow { margin: 0; }
.story-hero__title { margin: 0; }
.story-hero__intro { font-size: 15px; line-height: 23px; max-width: 38rem; }
.story-hero__intro p { margin: 0 0 8px; }
.story-hero__actions { display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }
.story-hero__sample-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; }
.story-hero__sample { flex: none; }
.story-hero__sample-note { margin: 0; font-size: 13px; line-height: 18px; max-width: 26rem; }

/* Two routes under the sample: at home (starter pack) and in the classroom (sign-up + school packages) */
.story-routes { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
.story-route { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; border-radius: 16px; color: var(--brand-text); text-decoration: none; min-width: 0; }
.story-route--home { border: 2px solid var(--brand-heading); background: #fff; }
.story-route--home:hover { color: var(--brand-text); box-shadow: 0 4px 14px rgba(25, 113, 119, 0.15); }
.story-route--home:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 3px; }
.story-route--class { border: 2px solid #cfe5e5; background: #eaf4f4; }
.story-route__label { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-strong-dark); }
.story-route__row { display: flex; align-items: center; gap: 12px; }
.story-route__media { flex: none; width: 64px; height: 64px; }
.story-route__media img { width: 100%; height: 100%; object-fit: contain; display: block; }
.story-route__body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.story-route__title { font-size: 15px; font-weight: 700; line-height: 20px; color: var(--brand-heading); }
.story-route__text { font-size: 13px; line-height: 18px; }
.story-route__prices { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; margin-top: 2px; }
.story-route__price { font-size: 17px; font-weight: 700; color: var(--brand-heading); }
.story-route__was { font-size: 13px; color: #6b6b6b; }
.story-route__save { font-size: 12px; font-weight: 600; padding: 1px 8px; border-radius: 999px; background: var(--brand-heading); color: #fff; }
.story-route__more { margin-top: auto; padding-top: 4px; font-size: 14px; font-weight: 700; color: var(--brand-heading); }
.story-route__link { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 600; color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; }
.story-route .school-signup { margin-top: 4px; }

/* School sign-up (snippets/school-signup.liquid) */
.school-signup__row { display: flex; gap: 6px; }
.school-signup__input { flex: 1 1 auto; min-width: 0; min-height: 44px; padding: 0 14px; border: 1px solid #b9cfcf; border-radius: 999px; background: #fff; font: inherit; font-size: 15px; color: var(--brand-text); }
.school-signup__input:focus-visible { outline: 2px solid var(--brand-heading); outline-offset: 1px; border-color: var(--brand-heading); }
.school-signup__input[aria-invalid="true"] { border-color: #b3261e; }
.school-signup__button { flex: none; }
.school-signup__status { margin: 6px 0 0; font-size: 13px; line-height: 18px; font-weight: 600; color: var(--brand-heading); }
.school-signup__status[data-state="error"] { color: #b3261e; }
.story-hero__links { margin: 0; display: flex; flex-direction: column; gap: 2px; font-size: 14px; }
.story-hero__links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--brand-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

@media screen and (min-width: 1000px) {
  .story-hero__inner { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; gap: 48px; padding-block: 32px 40px; }
  .story-hero__text { order: 1; }
  .story-hero__art { order: 2; }
  .story-hero__art img { max-width: 100%; max-height: 460px; }
  .story-hero__intro { font-size: 16px; line-height: 25px; }
  .story-hero__links { flex-direction: row; flex-wrap: wrap; gap: 0 20px; }
  .story-routes { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
}

/* CHARACTER FEATURES (sections/character-features.liquid): "What does the Gruffalo look like?" */
.character-features { padding-block: 36px; color: var(--brand-text); }
.character-features__intro { margin: 8px 0 0; max-width: 60ch; }
.character-features__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 20px 0 0; padding: 0; list-style: none; }
.character-features__card { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; border: 1px solid var(--card-border); border-radius: 14px; background: #fff; }
.character-features__card-title { font-size: 15px; font-weight: 700; line-height: 20px; color: var(--brand-heading); }
.character-features__card-text { font-size: 13px; line-height: 18px; }
.character-features__answers { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; margin-top: 28px; }
.character-features__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
.character-features__main { min-width: 0; }
.character-features__media { display: flex; justify-content: center; order: 2; }
.character-features__media img { display: block; width: auto; max-width: 55vw; max-height: 280px; height: auto; object-fit: contain; }
.character-features__question { margin: 0 0 4px; font-size: 18px; line-height: 24px; font-weight: 600; letter-spacing: normal; color: var(--brand-heading); }
.character-features__text p { margin: 0; font-size: 15px; line-height: 23px; }
.character-features__more { margin: 12px 0 0; }
.character-features__more a, .character-cast__link a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; }
.character-cast__link { margin: 4px 0 0; }

/* CLASSROOM BAND (sections/classroom-band.liquid): light teal band, photo left, text + sign-up right */
.classroom-band { background: #eaf4f4; color: var(--brand-text); }
.classroom-band__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; padding-block: 32px; }
.classroom-band__media img { display: block; width: 100%; height: 260px; object-fit: cover; object-position: center 40%; border-radius: 16px; }
.classroom-band__text { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.classroom-band__eyebrow { margin: 0; }
.classroom-band__title { margin: 0; }
.classroom-band__intro p { margin: 0; font-size: 15px; line-height: 24px; }
.classroom-band__points { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
.classroom-band__point { display: flex; gap: 10px; font-size: 15px; line-height: 23px; }
.classroom-band__tick { flex: none; margin-top: 2px; color: var(--brand-heading); }
.classroom-band__point p { margin: 0; }
.classroom-band__point strong { color: var(--brand-heading); }
.classroom-band__signup { max-width: 34rem; padding: 16px; border-radius: 16px; background: #fff; }
.classroom-band__signup-title { margin: 0 0 8px; font-size: 16px; font-weight: 700; color: var(--brand-heading); }
.classroom-band__signup-note { margin: 8px 0 0; font-size: 13px; line-height: 18px; }
.classroom-band__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
.classroom-band__link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; }

/* STORY STEPS (sections/story-steps.liquid): cast order on the cast page */
.story-steps { padding-block: 36px; background: #f6fbfb; color: var(--brand-text); }
.story-steps__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
.story-steps__eyebrow { margin: 0 0 4px; }
.story-steps__intro { margin-top: 8px; }
.story-steps__intro p { margin: 0 0 10px; font-size: 15px; line-height: 23px; }
.story-steps__list { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
.story-steps__step { display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px; border-radius: 14px; background: #fff; border: 1px solid var(--card-border); }
.story-steps__num { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: var(--brand-heading); color: #fff; font-weight: 700; }
.story-steps__body { display: flex; flex-direction: column; gap: 2px; }
.story-steps__title { font-weight: 700; color: var(--brand-heading); }
.story-steps__text { font-size: 14px; line-height: 20px; }

/* STORY HOME BAND (sections/story-home-band.liquid) */
.story-home-band { background: var(--story-home-bg, #fff7f0); color: var(--brand-text); }
.story-home-band__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; padding-block: 32px; align-items: center; }
.story-home-band__media { display: flex; justify-content: center; }
.story-home-band__media img { display: block; width: auto; max-width: 60vw; max-height: 220px; height: auto; object-fit: contain; }
.story-home-band__text { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.story-home-band__eyebrow { margin: 0; }
.story-home-band__title { margin: 0; }
.story-home-band__intro p { margin: 0; font-size: 15px; line-height: 23px; }
.story-home-band__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 20px; margin-top: 4px; }
.story-home-band__link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--brand-heading); text-decoration: underline; text-underline-offset: 2px; }

@media screen and (min-width: 700px) {
  .character-features__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .character-features__answers { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; }
  .story-home-band__inner { grid-template-columns: 240px minmax(0, 1fr); gap: 40px; }
  .story-home-band__media img { max-width: 100%; max-height: 300px; }
}
@media screen and (min-width: 1000px) {
  .character-features { padding-block: 48px; }
  .character-features__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .character-features--image .character-features__inner { grid-template-columns: 240px minmax(0, 1fr); gap: 40px; align-items: start; }
  .character-features--image .character-features__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .character-features__media { order: 0; }
  .character-features__media img { max-width: 100%; max-height: 420px; }
  .classroom-band__inner { grid-template-columns: minmax(0, 440px) minmax(0, 1fr); gap: 48px; padding-block: 48px; align-items: center; }
  .classroom-band__media img { height: 420px; border-radius: 20px; }
  .story-steps { padding-block: 48px; }
  .story-steps__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
}

/* ----------------------------------------------------------------------------------------------------------------
   VS CTA: the one button on /pages/voxblock-vs-yoto (snippets/vs-cta.liquid). Uses the theme's .button, so it
   matches every other primary button; these lines only centre the label when it wraps.
---------------------------------------------------------------------------------------------------------------- */
.vs-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; text-align: center; }
.vs-cta__from { white-space: nowrap; margin-inline-start: .3em; } /* the leading space is dropped inside a flex button */

/* ----------------------------------------------------------------------------------------------------------------
   PACK CONTENTS: "What's in the box" section below the main product area on starter-pack bundle pages
   (sections/pack-contents.liquid, snippets/pack-contents.liquid). Layout only: headings, eyebrow, links and text take
   the site-wide styles (section-header's .subheading + .h2, bare h3/h4 for the groups and books, .text-sm, .link). Phone: kit tiles in a row of three,
   then one card per book. Desktop: kit in a 300px column, books as three cards beside it. Sample buttons are the
   site's standard .bookpreview button. Also renders in the buy column as block `pack_contents` (.pack-contents--column).
---------------------------------------------------------------------------------------------------------------- */
.pack-contents { display: flex; flex-direction: column; gap: 24px; scroll-margin-top: calc(var(--header-height, 80px) + 24px); }
.pack-contents p { margin: 0; }
.pack-contents__body { display: flex; flex-direction: column; gap: 24px; }
.pack-contents__group { display: flex; flex-direction: column; gap: 12px; }
.pack-contents__group-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 12px; }
.pack-contents__group-head > * { margin: 0; }
.pack-contents-jump { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; }
/* .link draws its underline 1.35em from the top; this box is 44px tall with centred text, so anchor the line to the text instead */
.pack-contents-jump.link { background-position: 0 calc(50% + 0.6em); }

.pack-contents__kit { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.pack-contents__kit-item { display: flex; flex-direction: column; gap: 6px; }
.pack-contents__kit-media { aspect-ratio: 1; border-radius: var(--rounded-sm, 12px); background: rgb(var(--background)); overflow: hidden; }
.pack-contents__kit-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.pack-contents__kit-media img[hidden] { display: none; }

.pack-contents__books { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.pack-contents__book { display: flex; gap: 14px; align-items: center; padding: 12px 14px 12px 10px; border-radius: var(--rounded, 16px); background: rgb(var(--background-primary, 255 255 255)); }
.pack-contents__cover { flex: 0 0 64px; }
.pack-contents__cover img { display: block; width: 64px; height: auto; }
.pack-contents__book-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.pack-contents__book-body > h4 { margin: 0; }
.pack-contents__play { margin-top: 8px; align-self: flex-start; }
.pack-contents__value { display: flex; align-items: center; gap: 12px; }
.pack-contents__value svg { flex: 0 0 26px; }

@media screen and (min-width: 1000px) {
  .pack-contents:not(.pack-contents--column) { gap: 32px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__body { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 40px; align-items: start; }
  .pack-contents:not(.pack-contents--column) .pack-contents__kit { grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__kit-item { display: grid; grid-template-columns: 88px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 14px; row-gap: 2px; align-content: center; padding: 10px; border-radius: var(--rounded, 16px); background: rgb(var(--background-primary, 255 255 255)); }
  .pack-contents:not(.pack-contents--column) .pack-contents__kit-media { grid-row: 1 / span 2; width: 88px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__kit-name { align-self: end; }
  .pack-contents:not(.pack-contents--column) .pack-contents__kit-caption { align-self: start; }
  .pack-contents:not(.pack-contents--column) .pack-contents__books { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__book { flex-direction: column; align-items: stretch; gap: 14px; padding: 16px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__cover { flex: none; display: flex; justify-content: center; padding-top: 4px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__cover img { width: auto; height: 190px; }
  .pack-contents:not(.pack-contents--column) .pack-contents__book-body { flex-grow: 1; }
  .pack-contents:not(.pack-contents--column) .pack-contents__play { margin-top: auto; padding-top: 10px; }
}

/* Buy column (block `pack_contents` in main-product): phone layout at every width (the desktop layout above is for the
   full-width section only), on a light panel so the white kit tiles and book cards stand out. */
.pack-contents--column { gap: 16px; padding: 16px; border-radius: var(--rounded, 16px); background: rgb(var(--text-color) / .04); }
.pack-contents--column .pack-contents__head { display: flex; flex-direction: column; gap: 6px; }
.pack-contents--column .pack-contents__head > * { margin: 0; }

/* Basket line items (cart drawer and /cart): every product image sits in the same square box, so tall audiobook
   covers are no bigger than the player or accessories. Theme-wide, not per section. */
.line-item__media-wrapper {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.line-item__media-wrapper > .line-item__media {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* Small product cards (cart drawer "Why not include...", complementary products): one square box for every image. */
.horizontal-product__image {
  height: var(--horizontal-product-image-size);
  aspect-ratio: 1;
  object-fit: contain;
}

/* Empty cart drawer: the recommendations carousel spans the drawer and its cards keep their normal left-aligned
   layout (the empty state centres everything else). */
.empty-state > .cart-drawer__recommendations {
  justify-self: stretch;
  width: 100%;
  text-align: start;
}

.empty-state .cart-drawer__recommendations .horizontal-product {
  text-align: start;
}

/* Cart page: "Continue shopping" link under the order table (same destination as the empty-cart button). */
.cart-order__continue {
  margin-block-start: var(--spacing-6);
}
