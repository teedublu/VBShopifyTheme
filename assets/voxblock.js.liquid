// ----------------------------------------------------------------------------------------------------------------
// PACK CONTENTS (snippets/pack-contents.liquid)
// Player-kit pictures follow the colour swatch: show the image whose data-pack-colour matches the new variant's
// colour; a product with no image for that colour keeps the one it shows.
// ----------------------------------------------------------------------------------------------------------------
document.addEventListener('variant:change', (event) => {
    const variant = event.detail && event.detail.variant;
    if (!variant) return;
    const colour = variant.option1;
    document.querySelectorAll('[data-pack-contents] .pack-contents__kit-media').forEach((media) => {
        const images = media.querySelectorAll('img[data-pack-colour]');
        const match = Array.from(images).find((img) => img.dataset.packColour === colour);
        if (!match) return;
        images.forEach((img) => { img.hidden = img !== match; });
    });
});


