// ----------------------------------------------------------------------------------------------------------------
// CART "STORIES PLAY ON A VOXBLOCK PLAYER" PROMPT (snippets/cart-player-prompt.liquid)
// "I already have a player" hides it in this browser for good (localStorage + a class on <html>, so the prompt stays
// hidden when the cart drawer re-renders). PostHog `cart_player_prompt` { action: shown | add_pack | add_player | dismiss };
// "shown" is sent once per page, the first time the prompt is actually visible.
// ----------------------------------------------------------------------------------------------------------------
const PLAYER_PROMPT_KEY = 'vb_has_player';
const trackPlayerPrompt = (action) => {
    if (typeof window.posthog === 'undefined' || typeof window.posthog.capture !== 'function') return;
    try { window.posthog.capture('cart_player_prompt', { action }); } catch (e) { /* never block the basket */ }
};

try {
    if (window.localStorage.getItem(PLAYER_PROMPT_KEY) === '1') document.documentElement.classList.add('vb-has-player');
} catch (e) { /* storage blocked: the prompt simply keeps showing */ }

document.addEventListener('click', (event) => {
    if (event.target.closest('[data-cart-player-dismiss]')) {
        try { window.localStorage.setItem(PLAYER_PROMPT_KEY, '1'); } catch (e) { /* storage blocked */ }
        document.documentElement.classList.add('vb-has-player');
        trackPlayerPrompt('dismiss');
        return;
    }
    const add = event.target.closest('[data-prompt-track]');
    if (add) trackPlayerPrompt(add.dataset.promptTrack);
});

let playerPromptShown = false;
const playerPromptObserver = 'IntersectionObserver' in window ? new IntersectionObserver((entries) => {
    if (playerPromptShown || document.documentElement.classList.contains('vb-has-player')) return;
    if (entries.some((entry) => entry.isIntersecting)) {
        playerPromptShown = true;
        trackPlayerPrompt('shown');
        playerPromptObserver.disconnect();
    }
}) : null;
const watchPlayerPrompt = () => {
    if (!playerPromptObserver || playerPromptShown) return;
    document.querySelectorAll('[data-cart-player-prompt]').forEach((el) => playerPromptObserver.observe(el));
};
watchPlayerPrompt();
// The cart drawer is re-rendered after every basket change: watch it (only it) for a new prompt, until one is seen
const cartDrawerEl = document.getElementById('cart-drawer');
if (cartDrawerEl && playerPromptObserver) {
    const drawerWatcher = new MutationObserver(() => {
        if (playerPromptShown) { drawerWatcher.disconnect(); return; }
        watchPlayerPrompt();
    });
    drawerWatcher.observe(cartDrawerEl, { childList: true, subtree: true });
}


// ----------------------------------------------------------------------------------------------------------------
// CART DRAWER VIEWS: Shopify's standard `cart_viewed` only fires on the /cart page, and almost nobody goes there,
// so the drawer was invisible in PostHog. Each time the drawer finishes opening, publish the custom Shopify
// customer event `vb_cart_drawer_viewed` { source: 'drawer', trigger, item_count, total_price, page }; the custom
// pixel subscribes to it and sends PostHog `cart_viewed` with these properties. trigger = 'after_add' when the
// theme opened it straight after an add-to-cart, otherwise 'manual' (basket icon).
// ----------------------------------------------------------------------------------------------------------------
let lastVariantAddAt = 0;
let lastCart = null;
document.addEventListener('variant:add', () => { lastVariantAddAt = Date.now(); });
document.addEventListener('cart:change', (event) => { lastCart = (event.detail && event.detail.cart) || lastCart; });
document.addEventListener('dialog:after-show', async (event) => {
    if (!event.target || event.target.tagName !== 'CART-DRAWER') return;
    if (!window.Shopify || !window.Shopify.analytics || typeof window.Shopify.analytics.publish !== 'function') return;
    const props = {
        source: 'drawer',
        trigger: Date.now() - lastVariantAddAt < 5000 ? 'after_add' : 'manual',
        page: window.location.pathname,
    };
    try {
        // Opened from the basket icon before any change on this page: read the basket once
        if (!lastCart) lastCart = await fetch(`${window.Shopify?.routes?.root || '/'}cart.js`).then((r) => r.json());
        props.item_count = lastCart.item_count;
        props.total_price = lastCart.total_price / 100;
    } catch (e) { /* send without basket details */ }
    try { window.Shopify.analytics.publish('vb_cart_drawer_viewed', props); } catch (e) { /* never block the basket */ }
});


