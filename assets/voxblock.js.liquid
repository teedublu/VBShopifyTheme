

// voxblock.js
import { Delegate } from "{{ 'vendor.min.js' | asset_url }}";
import { formatMoney } from "{{ 'theme.js' | asset_url }}";

// Encapsulating the module in an IIFE is not strictly necessary with ES6+ modules,
// but for the sake of direct integration into a script tag or existing build process, we'll keep functions scoped.

const VoxBlock = (() => {
    const audio = new Audio();
    audio.addEventListener('loadstart', function(){console.log('loadstart')})
    audio.addEventListener('playing', function(){console.log('playing')})
    audio.addEventListener('ended', function(){console.log('ended'); audio.currentButton.classList.remove('playing');})

    // PostHog: one event per play press, with the audiobook title from data-title
    const trackSamplePlayed = (button) => {
        if (typeof window.posthog === 'undefined' || typeof window.posthog.capture !== 'function') return;
        const title = (button.getAttribute('data-title') || '').trim();
        window.posthog.capture('sample_played', { title: title || null });
    };

    const initAudioDelegate = (selector) => {
        const delegate = new Delegate(document.body);
        delegate.on('click', selector, (event, target) => {
            const srcfile = target.getAttribute('data-mp3');
            audio.currentButton = target;
            if (!audio.src.includes(srcfile)) {
                audio.src = srcfile;
            }

            if (target.classList.contains('playing')) {
                target.classList.remove('playing');
                audio.pause();
            } else {
                document.querySelectorAll(selector).forEach(el => el.classList.remove('playing'));
                target.classList.add('playing');
                audio.play();
                trackSamplePlayed(target);
            }

            event.preventDefault();
        });
    };

    return {
        initAudioDelegate,
    };
})();

export default VoxBlock;

document.addEventListener('DOMContentLoaded', function() {
    VoxBlock.initAudioDelegate('.bookpreview'); // Initialize audio playback

});



// ----------------------------------------------------------------------------------------------------------------
// OFFER PRICE (snippets/offer-price.liquid)
// Keeps the tag-driven automatic-discount "offer price" correct when a shopper switches variant. The tag decision is
// made server side (the element only exists for products carrying the offer tag); the amount off comes from the
// element's amount-off attribute, which is the theme setting offer_amount_off.
// ----------------------------------------------------------------------------------------------------------------
const offerMoneyFormat = () => window.themeVariables.settings.currencyCodeEnabled
    ? window.themeVariables.settings.moneyWithCurrencyFormat
    : window.themeVariables.settings.moneyFormat;

const offerState = (variant, amountOff) => {
    const price = variant['price'];
    const compareAt = variant['compare_at_price'] || 0;
    const onOffer = price > amountOff;
    return {
        onOffer,
        now: onOffer ? price - amountOff : price,
        // higher of price / compare-at, so only one strikethrough is ever shown
        was: onOffer ? Math.max(price, compareAt) : compareAt,
        showWas: onOffer || compareAt > price,
    };
};

class OfferVariantElement extends HTMLElement {
    connectedCallback() {
        this._onVariantChanged = (event) => this.update(event.detail.variant, Number(this.getAttribute('amount-off')) || 0);
        this._form = document.forms[this.getAttribute('form')];
        this._form?.addEventListener('variant:change', this._onVariantChanged);
    }
    disconnectedCallback() {
        this._form?.removeEventListener('variant:change', this._onVariantChanged);
    }
}

class OfferPrice extends OfferVariantElement {
    update(variant, amountOff) {
        if (!variant) return;
        const state = offerState(variant, amountOff);
        const set = (selector, html) => {
            const el = this.querySelector(selector);
            const label = el.querySelector('.sr-only');
            el.replaceChildren(...(label ? [label] : []), document.createRange().createContextualFragment(html));
        };
        set('[data-offer-now]', formatMoney(state.now, offerMoneyFormat()));
        set('[data-offer-was]', formatMoney(state.was, offerMoneyFormat()));
        this.querySelector('[data-offer-was]').hidden = !state.showWas;
        this.querySelector('[data-offer-now]').classList.toggle('offer-price__now--regular', !state.onOffer);
    }
}

class OfferBadges extends OfferVariantElement {
    update(variant, amountOff) {
        if (!variant) return;
        const state = offerState(variant, amountOff);
        this.hidden = !state.onOffer;
        if (state.onOffer && state.was > 0) {
            const pct = Math.round((state.was - state.now) * 100 / state.was);
            this.querySelector('[data-offer-sale]').textContent = this.getAttribute('sale-template').replace('__PERCENT__', pct);
        }
    }
}

if (!window.customElements.get('offer-price')) window.customElements.define('offer-price', OfferPrice);
if (!window.customElements.get('offer-badges')) window.customElements.define('offer-badges', OfferBadges);


// ----------------------------------------------------------------------------------------------------------------
// BUNDLE PRICE (snippets/bundle-price.liquid, product page)
// Keeps the price, "saves N%" chip and "Bought separately" line right when a pack's variant changes.
// ----------------------------------------------------------------------------------------------------------------
class BundlePrice extends HTMLElement {
    connectedCallback() {
        this._onVariantChanged = (event) => this.update(event.detail.variant);
        this._form = document.forms[this.getAttribute('form')];
        this._form?.addEventListener('variant:change', this._onVariantChanged);
    }
    disconnectedCallback() {
        this._form?.removeEventListener('variant:change', this._onVariantChanged);
    }
    update(variant) {
        if (!variant) return;
        const price = variant['price'];
        const compareAt = variant['compare_at_price'] || 0;
        const format = offerMoneyFormat();

        const now = this.querySelector('[data-bundle-now]');
        const label = now.querySelector('.sr-only');
        now.replaceChildren(...(label ? [label] : []), document.createRange().createContextualFragment(formatMoney(price, format)));

        const hasSaving = compareAt > price;
        const chip = this.querySelector('[data-bundle-chip]');
        const was = this.querySelector('[data-bundle-was]');
        chip.hidden = was.hidden = !hasSaving;
        if (hasSaving) {
            chip.textContent = this.getAttribute('chip-template').replace('__PERCENT__', Math.round((compareAt - price) * 100 / compareAt));
            was.textContent = this.getAttribute('was-template').replace('__PRICE__', formatMoney(compareAt, format).replace(/<[^>]*>/g, ''));
        }
    }
}

if (!window.customElements.get('bundle-price')) window.customElements.define('bundle-price', BundlePrice);


// ----------------------------------------------------------------------------------------------------------------
// PACK AGE BAR (snippets/collection-age-bar.liquid)
// The age / gift buttons are Search & Discovery filters. Clicking one re-uses the theme's own AJAX ("facet:update",
// handled in theme.js) so the page does not reload, and sends a PostHog event. aria-pressed is updated straight away and
// then re-rendered by the server with the real state when the section comes back.
// ----------------------------------------------------------------------------------------------------------------
const trackCollectionFilterUsed = (filter, collection) => {
    if (typeof window.posthog === 'undefined' || typeof window.posthog.capture !== 'function') return;
    try {
        window.posthog.capture('collection_filter_used', { filter, collection });
    } catch (e) { /* analytics must never block filtering */ }
};

document.addEventListener('click', (event) => {
    const chip = event.target.closest('[data-pack-chip]');
    const form = chip?.closest('[data-pack-bar-form]');
    const bar = chip?.closest('[data-pack-bar]');
    const section = chip?.closest('.shopify-section');
    if (!chip || !form || !bar || !section) return;

    // The buttons are real submit buttons (they work without JavaScript); with JavaScript we filter in place instead
    event.preventDefault();

    const param = chip.dataset.param || '';
    const wasPressed = chip.getAttribute('aria-pressed') === 'true';
    const selectAll = !param || wasPressed; // "All packs", or pressing the active button again

    const url = new URL(window.location.href);
    url.hash = '';
    ['page', 'section_id', form.dataset.ageParam, form.dataset.giftParam].forEach((key) => key && url.searchParams.delete(key));
    if (!selectAll) url.searchParams.set(param, chip.dataset.value);

    form.querySelectorAll('[data-pack-chip]').forEach((button) => {
        const pressed = selectAll ? !button.dataset.param : button === chip;
        button.setAttribute('aria-pressed', pressed ? 'true' : 'false');
    });

    url.searchParams.set('section_id', section.id.replace('shopify-section-', ''));
    chip.dispatchEvent(new CustomEvent('facet:update', { bubbles: true, detail: { url } }));
    trackCollectionFilterUsed(selectAll ? 'all' : chip.dataset.filter, bar.dataset.collection);
});


// Pack card: the colour swatch chooses which variant the round add-to-cart button adds
document.addEventListener('change', (event) => {
    const radio = event.target.closest?.('.pack-card__swatches input[type="radio"], [data-variant-swatches] input[type="radio"]');
    const card = radio?.closest('.pack-card, [data-variant-card]');
    const idInput = card?.querySelector('[data-pack-variant-id]');
    const mapInput = card?.querySelector('[data-pack-variant-map]');
    if (!idInput || !mapInput) return;
    const match = mapInput.value.split(';').map((pair) => pair.split(/=(?=[^=]*$)/)).find(([title]) => title === radio.value);
    if (match) idInput.value = match[1];
});


// Pack intro tiles: scroll to the first intro / starter pack, stopping below the sticky header and filter bar
document.addEventListener('click', (event) => {
    const tile = event.target.closest('[data-pack-scroll]');
    if (!tile) return;
    const card = document.querySelector(`.pack-card[data-pack-kind="${tile.dataset.packScroll}"]`);
    if (!card) return; // no such pack: let the link jump to the grid
    event.preventDefault();
    const bar = document.querySelector('[data-pack-bar]');
    const stickyArea = bar ? parseFloat(getComputedStyle(bar).top) || 0 : 0; // resolved px offset of the sticky bar = header (+ announcement) height
    const top = card.getBoundingClientRect().top + window.scrollY - stickyArea - (bar ? bar.offsetHeight : 0) - 12;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
    card.querySelector('.pack-card__link')?.focus({ preventScroll: true });
});


// ----------------------------------------------------------------------------------------------------------------
// AGE COLLECTION TEMPLATE (sections/collection-age-intro.liquid, snippets/collection-howto-promo.liquid)
// PostHog `age_collection_click` { target, collection } for every element with data-age-track
// (tab:<handle>, starter_add, pack_title, all_packs, player, howto_packs, howto_player).
// ----------------------------------------------------------------------------------------------------------------
document.addEventListener('click', (event) => {
    const el = event.target.closest('[data-age-track]');
    if (!el || typeof window.posthog === 'undefined' || typeof window.posthog.capture !== 'function') return;
    const collection = document.querySelector('[data-age-collection]')?.dataset.ageCollection || null;
    try {
        window.posthog.capture('age_collection_click', { target: el.dataset.ageTrack, collection });
    } catch (e) { /* analytics must never block the click */ }
});


// ----------------------------------------------------------------------------------------------------------------
// CART "STORIES PLAY ON A VOXBLOCK PLAYER" PROMPT (snippets/cart-player-prompt.liquid)
// "I already have a player" hides it in this browser for good (localStorage + a class on <html>, so the prompt stays
// hidden when the cart drawer re-renders). PostHog `cart_player_prompt` { action: shown | add_pack | add_player | dismiss };
// "shown" is sent once per page, the first time the prompt is actually visible.
// ----------------------------------------------------------------------------------------------------------------
const PLAYER_PROMPT_KEY = 'vb_has_player';
const trackPlayerPrompt = (action) => {
    if (typeof window.posthog === 'undefined' || typeof window.posthog.capture !== 'function') return;
    try { window.posthog.capture('cart_player_prompt', { action }); } catch (e) { /* never block the basket */ }
};

try {
    if (window.localStorage.getItem(PLAYER_PROMPT_KEY) === '1') document.documentElement.classList.add('vb-has-player');
} catch (e) { /* storage blocked: the prompt simply keeps showing */ }

document.addEventListener('click', (event) => {
    if (event.target.closest('[data-cart-player-dismiss]')) {
        try { window.localStorage.setItem(PLAYER_PROMPT_KEY, '1'); } catch (e) { /* storage blocked */ }
        document.documentElement.classList.add('vb-has-player');
        trackPlayerPrompt('dismiss');
        return;
    }
    const add = event.target.closest('[data-prompt-track]');
    if (add) trackPlayerPrompt(add.dataset.promptTrack);
});

let playerPromptShown = false;
const playerPromptObserver = 'IntersectionObserver' in window ? new IntersectionObserver((entries) => {
    if (playerPromptShown || document.documentElement.classList.contains('vb-has-player')) return;
    if (entries.some((entry) => entry.isIntersecting)) {
        playerPromptShown = true;
        trackPlayerPrompt('shown');
        playerPromptObserver.disconnect();
    }
}) : null;
const watchPlayerPrompt = () => {
    if (!playerPromptObserver || playerPromptShown) return;
    document.querySelectorAll('[data-cart-player-prompt]').forEach((el) => playerPromptObserver.observe(el));
};
watchPlayerPrompt();
// The cart drawer is re-rendered after every basket change: watch it (only it) for a new prompt, until one is seen
const cartDrawerEl = document.getElementById('cart-drawer');
if (cartDrawerEl && playerPromptObserver) {
    const drawerWatcher = new MutationObserver(() => {
        if (playerPromptShown) { drawerWatcher.disconnect(); return; }
        watchPlayerPrompt();
    });
    drawerWatcher.observe(cartDrawerEl, { childList: true, subtree: true });
}


// ----------------------------------------------------------------------------------------------------------------
// STORY HERO (sections/story-hero.liquid): PostHog `story_hero_click` { target, page } for data-story-track links.
// The sample button is a normal .bookpreview button and already sends `sample_played`.
// ----------------------------------------------------------------------------------------------------------------
document.addEventListener('click', (event) => {
    const el = event.target.closest('[data-story-track]');
    if (!el || typeof window.posthog === 'undefined' || typeof window.posthog.capture !== 'function') return;
    const page = el.closest('[data-story-page]')?.dataset.storyPage || window.location.pathname;
    try {
        window.posthog.capture('story_hero_click', { target: el.dataset.storyTrack, page });
    } catch (e) { /* analytics must never block the click */ }
});


// ----------------------------------------------------------------------------------------------------------------
// SCHOOL SIGN-UP (snippets/school-signup.liquid): subscribes the email to a Klaviyo list with the client
// subscriptions API (same call as assets/back-in-stock.js) and sends PostHog `school_signup` { page, form }.
// ----------------------------------------------------------------------------------------------------------------
document.addEventListener('submit', async (event) => {
    const form = event.target.closest('[data-school-signup]');
    if (!form) return;
    event.preventDefault();

    const input = form.querySelector('input[type="email"]');
    const button = form.querySelector('button[type="submit"]');
    const status = form.querySelector('.school-signup__status');
    const email = (input?.value || '').trim();
    const show = (key, state) => {
        if (!status) return;
        status.textContent = status.dataset[key] || '';
        status.dataset.state = state;
        status.hidden = false;
    };

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        show('invalid', 'error');
        input?.setAttribute('aria-invalid', 'true');
        input?.focus();
        return;
    }
    input?.removeAttribute('aria-invalid');
    if (button) button.disabled = true;

    try {
        const response = await fetch(`https://a.klaviyo.com/client/subscriptions/?company_id=${encodeURIComponent(form.dataset.companyId)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json', revision: '2025-07-15' },
            body: JSON.stringify({
                data: {
                    type: 'subscription',
                    attributes: {
                        custom_source: form.dataset.source || 'Story page',
                        profile: { data: { type: 'profile', attributes: { email } } },
                    },
                    relationships: { list: { data: { type: 'list', id: form.dataset.listId } } },
                },
            }),
        });
        if (response.status !== 202) throw new Error(`Klaviyo answered ${response.status}`);

        form.querySelector('.school-signup__row')?.setAttribute('hidden', '');
        show('thanks', 'done');
        try {
            if (window.posthog && typeof window.posthog.capture === 'function') {
                const page = form.closest('[data-story-page]')?.dataset.storyPage || window.location.pathname;
                window.posthog.capture('school_signup', { page, form: form.dataset.form });
            }
        } catch (e) { /* analytics must never block the sign-up */ }
    } catch (error) {
        show('error', 'error');
        if (button) button.disabled = false;
    }
});
